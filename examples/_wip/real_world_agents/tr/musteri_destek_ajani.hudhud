// Gerçek Dünya Örneği: Müşteri Destek Ajanı
// Niyet tabanlı karar verme ile otomatik müşteri desteği

// ============================================
// ANAYASA: Şirket Politikaları
// ============================================
anayasa MusteriHizmetleriPolitikasi {
    yasa YanitSuresi:
        bilet.yanit_suresi <= ٥ dakika
    
    yasa VeriGuvenligi:
        musteri.veri.sifrelenmis == doğru
    
    yasa Yukseltme:
        eğer bilet.oncelik == "kritik" -> 
            bilet.atanan == "kidemli_ajan"
    
    yasa MemnuniyetTakibi:
        tüm biletler: bilet.memnuniyet_skoru >= ٠
}

// ============================================
// VARLIKLAR: Müşteri Destek Alanı
// ============================================
varlik Musteri {
    veri id: metin
    veri isim: metin
    veri eposta: metin
    veri seviye: metin = "standart"  // standart, premium, kurumsal
    veri memnuniyet: sayi = ٥.٠
    veri yasam_boyu_deger: sayi = ٠
    ajandurum gecmis: melodi = []
}

varlik Bilet {
    veri id: metin
    veri musteri_id: metin
    veri konu: metin
    veri aciklama: metin
    veri oncelik: metin = "normal"  // dusuk, normal, yuksek, kritik
    veri durum: metin = "acik"  // acik, devam_ediyor, cozuldu, kapandi
    veri kategori: metin = "genel"
    veri atanan: metin = "atanmamis"
    veri olusturulma: zamandamgasi
    veri yanit_suresi: sure = ٠
    veri cozum_suresi: sure = ٠
    ajandurum mesajlar: melodi = []
}

varlik BilgiTabani {
    veri makaleler: armoni = {}
    veri sss: melodi = []
    veri cozumler: hashmap = hashmap()
}

// ============================================
// OLAYLAR
// ============================================
olay BiletOlusturuldu {
    bilet: Bilet
    musteri: Musteri
}

olay BiletAtandi {
    bilet: Bilet
    ajan: metin
}

olay MesajGonderildi {
    bilet: Bilet
    gonderen: metin
    icerik: metin
}

olay BiletCozuldu {
    bilet: Bilet
    cozum: metin
}

olay YukseltmeGerekli {
    bilet: Bilet
    sebep: metin
}

// ============================================
// YASALAR: Değişmez İş Kuralları
// ============================================
yasa OtomatikOnceliklendirme:
    olay BiletOlusturuldu(bilet, musteri) ->
        (bilet.oncelik == "yuksek") ise {
            bilet.oncelik = "yuksek"؛
        } değilse ama (musteri.seviye == "premium") ise {
            bilet.oncelik = "normal"؛
        }

yasa KritikYukseltme:
    eğer bilet.oncelik == "kritik" ve bilet.durum == "acik" ->
        tetikle YukseltmeGerekli(bilet, "Kritik öncelik")

yasa YanitSuresiTakibi:
    olay MesajGonderildi(bilet, gonderen, icerik) ->
        (bilet.yanit_suresi == ٠) ise {
            bilet.yanit_suresi = simdiki_zaman - bilet.olusturulma؛
        }

// ============================================
// KURALLAR: Değiştirilebilir İş Mantığı
// ============================================
kuralkumesi DestekKurallari {
    kural CalismaSaatleri:
        simdiki_zaman.saat >= ٩ ve simdiki_zaman.saat <= ١٧
    
    kural AjanBasinaMaxBilet:
        ajan.aktif_biletler <= ١٠
    
    kural MemnuniyetEsigi:
        musteri.memnuniyet >= ٣.٠
    
    kural OtomatikKapatInaktif:
        eğer bilet.durum == "cozuldu" ve 
             bilet.son_aktivite > ٧ gun ->
            bilet.durum = "kapandi"
}

// ============================================
// NİYETLER: Hizmet Hedefleri
// ============================================
niyet HizliYanit oncelik ١٠٠:
    tüm biletler: bilet.yanit_suresi <= ٥ dakika

niyet YuksekMemnuniyet oncelik ٩٠:
    tüm musteriler: musteri.memnuniyet >= ٤.٠

niyet BiletCozumu oncelik ٨٠:
    tüm biletler: bilet.durum içinde ["cozuldu", "kapandi"]

niyet YukDengeleme oncelik ٧٠:
    tüm ajanlar: ajan.aktif_biletler <= ١٠

// ============================================
// EYLEMLER: Destek Yetenekleri
// ============================================
eylem BilgiTabaniAra {
    onkosul:
        bilet.durum == "acik"
    
    etki:
        veri sonuclar = bt.ara(bilet.konu + " " + bilet.aciklama)
        (sonuclar.uzunluk > ٠) ise {
            bilet.onerilen_cozumler = sonuclar؛
        }
    
    maliyet: ١
}

eylem OtomatikYanitGonder {
    onkosul:
        bilet.onerilen_cozumler.uzunluk > ٠
        bilet.yanit_suresi == ٠
    
    etki:
        veri yanit = yanit_olustur(bilet.onerilen_cozumler[٠])
        tetikle MesajGonderildi(bilet, "bot", yanit)
        bilet.durum = "devam_ediyor"
    
    maliyet: ٢
}

eylem InsanAjanaAta {
    onkosul:
        bilet.durum == "acik" veya bilet.durum == "devam_ediyor"
        var ajan: ajan.aktif_biletler < ١٠
    
    etki:
        veri musait_ajan = musait_ajan_bul()
        bilet.atanan = musait_ajan.id
        tetikle BiletAtandi(bilet, musait_ajan.id)
    
    maliyet: ٥
}

eylem KidemliyeYukselt {
    onkosul:
        bilet.oncelik == "kritik" veya
        bilet.cozum_suresi > ٢٤ saat
    
    etki:
        veri kidemli = kidemli_ajan_bul()
        bilet.atanan = kidemli.id
        bilet.oncelik = "kritik"
        tetikle YukseltmeGerekli(bilet, "Kıdemliye yükseltildi")
    
    maliyet: ١٠
}

eylem BiletiCoz {
    onkosul:
        bilet.durum == "devam_ediyor"
        bilet.cozum != bos
    
    etki:
        bilet.durum = "cozuldu"
        bilet.cozum_suresi = simdiki_zaman - bilet.olusturulma
        tetikle BiletCozuldu(bilet, bilet.cozum)
    
    maliyet: ٣
}

// ============================================
// AJANLAR: Destek Ekibi
// ============================================
ajan BiletYonlendiricisi: yurutucu {
    model: "gpt-4"
    sicaklik: ٠.٣
    
    izler: [Bilet.durum, Bilet.oncelik]
    araclar: [BilgiTabaniAra, OtomatikYanitGonder, InsanAjanaAta]
    
    olay(BiletOlusturuldu):
        plan [
            BilgiTabaniAra,
            OtomatikYanitGonder,
            InsanAjanaAta
        ]
    
    strateji: "yanit_suresini_minimize_et"
}

ajan DestekAjani: yurutucu {
    model: "gpt-4o"
    sicaklik: ٠.٥
    
    izler: [Bilet.atanan]
    araclar: [
        BilgiTabaniAra,
        OtomatikYanitGonder,
        BiletiCoz,
        KidemliyeYukselt
    ]
    
    olay(BiletAtandi):
        (bilet.atanan == ben.id) ise {
            plan [
                BilgiTabaniAra,
                BiletiCoz
            ]؛
        }
    
    strateji: "memnuniyeti_maksimize_et"
}

ajan KaliteGuvenlik: savci {
    model: "gpt-4"
    sicaklik: ٠.١
    
    izler: [anayasa MusteriHizmetleriPolitikasi]
    uygular: [
        yasa YanitSuresi,
        yasa VeriGuvenligi,
        yasa Yukseltme
    ]
    
    ihlal(yasa):
        ihlal_kaydet(yasa)
        yonetici_bilgilendir(yasa)
        (yasa == YanitSuresi) ise {
            tetikle YukseltmeGerekli(bilet, "SLA ihlali")؛
        }
}

// ============================================
// AKIŞLAR: Destek İş Akışları
// ============================================
akis BiletYasam Dongusu {
    girdi: bilet
    
    -> BiletYonlendiricisi.yonlendir(bilet)
    -> (bilet.otomatik_cozum) ise {
        OtomatikYanitGonder؛
       } değilse {
        InsanAjanaAta؛
       }
    -> DestekAjani.isle(bilet)
    -> BiletiCoz
    -> cikti: bilet
}

// ============================================
// MÜZİK VERİ: Yapılandırma
// ============================================
nota sirket_adi = "TeknikDestek A.Ş."
akor calisma_saatleri = {
    baslangic: ٩,
    bitis: ١٧,
    saat_dilimi: "UTC"
}
melodi oncelik_seviyeleri = ["dusuk", "normal", "yuksek", "kritik"]
armoni sla_hedefleri = {
    kurumsal: {
        yanit_suresi: ٥,  // dakika
        cozum_suresi: ٤  // saat
    },
    premium: {
        yanit_suresi: ١٥,
        cozum_suresi: ٢٤
    },
    standart: {
        yanit_suresi: ٦٠,
        cozum_suresi: ٤٨
    }
}

// ============================================
// ANA ÇALIŞTIRMA
// ============================================

// Bilgi tabanını başlat
veri bt = BilgiTabani()
bt.veritabanindan_yukle()

// Örnek bilet oluştur
veri musteri = Musteri {
    id: "MUST001",
    isim: "Ahmet Yılmaz",
    eposta: "ahmet@ornek.com",
    seviye: "premium"
}

veri bilet = Bilet {
    id: "BLT001",
    musteri_id: musteri.id,
    konu: "Hesaba giriş yapamıyorum",
    aciklama: "Giriş yapmaya çalıştığımda 'Geçersiz kimlik bilgileri' hatası alıyorum",
    olusturulma: simdi()
}

// Bilet oluşturma olayını tetikle
tetikle BiletOlusturuldu(bilet, musteri)

yazdır("Müşteri Destek Ajanı Sistemi Başlatıldı")
yazdır("İzlenen niyetler:", [HizliYanit, YuksekMemnuniyet, BiletCozumu])
yazdır("Aktif ajanlar:", [BiletYonlendiricisi, DestekAjani, KaliteGuvenlik])
yazdır("Bilet oluşturuldu:", bilet.id)
yazdır("Öncelik:", bilet.oncelik)
yazdır("Beklenen yanıt süresi:", sla_hedefleri[musteri.seviye].yanit_suresi, "dakika")
