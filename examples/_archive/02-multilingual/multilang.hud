// HudHudScript — Same Program in 5 Languages
// Issue #36: Comprehensive sample library
//
// Each section implements an identical algorithm:
//   1. Declare a greeting variable
//   2. Declare a number and check if it is even or odd
//   3. Loop and print values 1 through 5
//   4. Define and call a function that adds two numbers
//
// All sections produce identical AST nodes — the runtime sees
// only canonical English keywords regardless of which language
// was used to write the source.

// ============================================================
// LANGUAGE 1: English (default)
// ============================================================

print("=== English ===");

let greeting_en = "Hello, World!";
print(greeting_en);

let number_en = 7;
if (number_en % 2 == 0) {
    print("even");
} else {
    print("odd");
}

let i_en = 1;
while (i_en <= 5) {
    print(i_en);
    i_en = i_en + 1;
}

let add_en = (a, b) => {
    return a + b;
};
print(add_en(3, 4));

// ============================================================
// LANGUAGE 2: Turkish (Turkce)
// ============================================================

yazdır("=== Turkce ===");

tanım mesaj_tr = "Merhaba, Dunya!";
yazdır(mesaj_tr);

tanım sayi_tr = 7;
eğer (sayi_tr % 2 == 0) {
    yazdır("çift");
} değilse {
    yazdır("tek");
}

tanım i_tr = 1;
iken (i_tr <= 5) {
    yazdır(i_tr);
    i_tr = i_tr + 1;
}

tanım topla_tr = (a, b) => {
    dön a + b;
};
yazdır(topla_tr(3, 4));

// ============================================================
// LANGUAGE 3: Arabic (العربية)
// ============================================================

print("=== العربية ===");

متغير رسالة = "مرحبا، عالم!";
اطبع(رسالة)؛

متغير رقم = 7؛
إذا (رقم % 2 == 0) {
    اطبع("زوجي")؛
} وإلا {
    اطبع("فردي")؛
}

متغير عداد = 1؛
بينما (عداد <= 5) {
    اطبع(عداد)؛
    عداد = عداد + 1؛
}

// ============================================================
// LANGUAGE 4: Japanese (日本語)
// ============================================================
// v0.5.29: Japanese kanji print aliases now wired — 表示 and 書く work.

表示("=== 日本語 ===");

let message_ja = "こんにちは、世界！";
表示(message_ja);

let number_ja = 7;
if (number_ja % 2 == 0) {
    表示("偶数");
} else {
    表示("奇数");
}

let i_ja = 1;
while (i_ja <= 5) {
    表示(i_ja);
    i_ja = i_ja + 1;
}

let tasu_ja = (a, b) => {
    return a + b;
};
表示(tasu_ja(3, 4));

// ============================================================
// LANGUAGE 5: Spanish (Espanol)
// ============================================================

imprimir("=== Espanol ===");

let saludo = "Hola, Mundo!";
imprimir(saludo);

let numero = 7;
if (numero % 2 == 0) {
    imprimir("par");
} else {
    imprimir("impar");
}

let i_es = 1;
mientras (i_es <= 5) {
    imprimir(i_es);
    i_es = i_es + 1;
}

let sumar = (a, b) => {
    retornar a + b;
};
imprimir(sumar(3, 4));

// ============================================================
// Cross-language agent example
// All three agent keywords are synonyms; they all compile to
// the same Agent AST node.
// ============================================================

print("=== Multi-language Agents ===");

// English
agent GreetBot {
    role: "greeter",
    task: "Greet users by name"
}

// Turkish
ajan SelamBot {
    role: "greeter",
    task: "Kullanicilari isimle selamla"
}

// Japanese
エージェント AisatsuBot {
    role: "greeter",
    task: "ユーザーに名前で挨拶する"
}

fn greet(name) {
    return "Hello, " + name + "!";
}

print(greet("Alice"));
print(greet("Ahmet"));
print(greet("太郎"));
