// 日本語 HudHudScript プログラム
// Japanese HudHudScript Program
// Kural 8: All keywords in native Japanese script (Kanji/Hiragana/Katakana)

// 変数の定義
変数 言語 = "日本語"
変数 挨拶 = "こんにちは世界！"
表示(言語)
表示(挨拶)

// 条件分岐 (if-else)
変数 点数 = 85

もし (点数 >= 90) {
    表示("成績: A")
} それでも {
    もし (点数 >= 80) {
        表示("成績: B")
    } それでも {
        表示("成績: C")
    }
}

// 間ループ (while loop)
変数 カウンター = 1
間 (カウンター <= 5) {
    表示(カウンター)
    カウンター = カウンター + 1
}

// 関数
関数 足す(甲, 乙) {
    戻る 甲 + 乙
}

表示("3 + 7 =")
表示(足す(3, 7))
