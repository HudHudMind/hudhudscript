// برنامج HudHudScript بالعربية
// Arabic HudHudScript Program

// تعريف المتغيرات
متغير لغة = "العربية"
متغير تحية = "مرحبا بالعالم!"
اطبع(لغة)
اطبع(تحية)

// الشروط (if-else)
متغير درجة = 85

إذا (درجة >= 90) {
    اطبع("التقدير: أ")
} وإلا {
    إذا (درجة >= 80) {
        اطبع("التقدير: ب")
    } وإلا {
        اطبع("التقدير: ج")
    }
}

// حلقة بينما (while loop)
متغير عداد = 1
بينما (عداد <= 5) {
    اطبع(عداد)
    عداد = عداد + 1
}

// دالة
دالة جمع(أ, ب) {
    ارجع أ + ب
}

اطبع("3 + 7 =")
اطبع(جمع(3, 7))
