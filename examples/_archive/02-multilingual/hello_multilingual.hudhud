// Multilingual Hello World
// The same program written in English, Turkish, Japanese, and Arabic
// HudHudScript supports 24 languages with native keyword mappings

// ── English ──────────────────────────────────────────────────────
let language = "English"
let greeting = "Hello, World!"
print(language)
print(greeting)

// ── Fibonacci in English ─────────────────────────────────────────
function fibonacci(n) {
    if (n <= 1) {
        return n
    }
    return fibonacci(n - 1) + fibonacci(n - 2)
}

print("Fibonacci(10):")
print(fibonacci(10))
