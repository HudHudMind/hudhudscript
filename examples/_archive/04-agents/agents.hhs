// HudHudScript — Agent Definitions with Providers
// Demonstrates agent, provider, task, and tool declarations

// Provider declaration for OpenAI
provider openai_main {
    type: "openai",
    model: "gpt-4o",
    api_key: "sk-your-api-key",
    max_tokens: 4096
}

// Provider declaration for Anthropic
provider anthropic_main {
    type: "anthropic",
    model: "claude-3-opus",
    api_key: "sk-ant-your-key",
    max_tokens: 8192
}

// Note: standalone tool declarations are aspirational syntax.
// Tools are defined inside MCP server blocks in current grammar.
// tool web_search {
//     name: "search",
//     description: "Search the web for information"
// }
// tool file_reader {
//     name: "read_file",
//     description: "Read contents of a file"
// }

// A simple research agent
agent ResearchAgent {
    model: "gpt-4o",
    task: "Research topics and provide summaries",
    max_iterations: 5
}

// A writing agent with detailed configuration
agent WriterAgent {
    model: "claude-3-opus",
    task: "Write well-structured content based on research",
    temperature: 0.7,
    max_tokens: 2000
}

// Note: task declarations are aspirational syntax — not yet supported.
// task summarize {
//     description: "Summarize the given document",
//     input: "document_text",
//     output: "summary"
// }
// task translate {
//     description: "Translate text between languages",
//     input: "source_text",
//     output: "translated_text"
// }

// Council of agents working together
council EditorialBoard {
    members: [ResearchAgent, WriterAgent],
    execution: "roundRobin",
    voting: "majority"
}
