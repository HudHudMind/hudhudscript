// HudHudScript — Basic AI Agent with Provider
// Issue #36: Comprehensive sample library
//
// Demonstrates agent and provider declarations using supported grammar.
// Note: Task definitions with typed parameters inside agent bodies
// are aspirational syntax — for now, agent logic uses standalone functions.

// ── 1. Declare LLM providers ──────────────────────────────────
provider openai_gpt4 {
    type: "openai",
    model: "gpt-4",
    api_key: "sk-your-api-key-here",
    max_tokens: 2048,
    temperature: 0.7
}

provider openai_gpt35 {
    type: "openai",
    model: "gpt-3.5-turbo",
    api_key: "sk-your-api-key-here",
    max_tokens: 1024
}

// ── 2. Agent declarations ─────────────────────────────────────
agent AssistantAgent {
    role: "assistant",
    intent: "Answer questions helpfully and concisely",
    provider: "openai_gpt4"
}

agent CodeReviewer {
    role: "code_reviewer",
    intent: "Review code for bugs, style issues, and improvements",
    provider: "openai_gpt35"
}

// ── 3. Standalone task functions ──────────────────────────────
// In the current grammar, agent tasks are declared as standalone
// functions. Future versions will support inline task syntax.

fn answer(question) {
    // Aspirational: this.call({ prompt: question })
    return "Answer to: " + question;
}

fn summarise(text) {
    // Aspirational: this.call({ prompt: "Summarise: " + text })
    return "Summary of provided text";
}

fn review(code, language) {
    let prompt = "Review the following " + language + " code:\n" + code;
    // Aspirational: this.call({ prompt: prompt, temperature: 0.3 })
    return "Code review for " + language + " snippet";
}

// ── 4. Run the agent functions ────────────────────────────────

let result = answer("What is the capital of France?");
print("Answer: " + result);

let long_text = "HudHudScript is a multilingual, intent-driven scripting language designed for building autonomous AI systems.";
let summary = summarise(long_text);
print("Summary: " + summary);

let code_snippet = "function add(a, b) { return a + b }";
let review_result = review(code_snippet, "JavaScript");
print("Code Review: " + review_result);

// ── 5. Error handling ─────────────────────────────────────────
try {
    let bad_result = answer("");
    print("Got result: " + bad_result);
} catch (err) {
    print("Caught error: empty prompt not allowed");
}

print("Agent demo complete.");
