// Agent Basics in HudHudScript
// Demonstrates the agent declaration and orchestration features

// Define an AI agent with a model and configuration
agent Summarizer {
    model: "gpt-4",
    temperature: 0.3
}

agent Translator {
    model: "gpt-4o",
    temperature: 0.5
}

agent Reviewer {
    model: "gpt-4",
    temperature: 0.2
}

// Agents can be composed into workflows
print("Agent system initialized:")
print("  - Summarizer (gpt-4, temperature 0.3)")
print("  - Translator (gpt-4o, temperature 0.5)")
print("  - Reviewer (gpt-4, temperature 0.2)")

// Governance: agents operate under a constitution
constitution AgentPolicy {
    description: "Policy governing agent behavior",
    laws: [
        {
            name: "Output Length",
            description: "Keep summaries concise",
            enforcement: mandatory,
            rules: ["output_tokens <= 500"]
        },
        {
            name: "Language Check",
            description: "Verify translation quality",
            enforcement: advisory,
            rules: ["quality_score >= 0.8"]
        }
    ]
}

// Define a council to oversee agent actions
council AgentOversight {
    constitution: "AgentPolicy",
    members: [
        { agent: "reviewer.1", role: "Judge" },
        { agent: "auditor.1", role: "Prosecutor" }
    ],
    rules: ["output_tokens <= 500"]
}

print("")
print("Agent governance active:")
print("  Constitution: AgentPolicy (2 laws)")
print("  Council: AgentOversight (2 members)")
