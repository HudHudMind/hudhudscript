// Multi-Screen Navigation — parameterized screens

ui NavigationApp {
    entry: Home;

    screen Home {
        Column { padding: 16; gap: 12 } {
            Text "Home" { size: 28; bold: true }
            Text "Choose a section:" { color: "#757575" }

            Button "Go to Profile" { background: "#1976D2"; color: "#fff" } {
                on_click: goToProfile
            }
            Button "Go to Settings" { background: "#424242"; color: "#fff" } {
                on_click: goToSettings
            }
        }
    }

    screen Profile(userId) {
        Column { padding: 16; gap: 8 } {
            Text "Profile" { size: 28; bold: true }
            Text userId { size: 16; color: "#757575" }

            Card { padding: 16; border_radius: 8; background: "#f5f5f5" } {
                Text "User Details" { bold: true }
                Text "Name: Onur" { size: 14 }
                Text "Role: Developer" { size: 14 }
            }

            Button "← Back" { on_click: goBack }
        }
    }

    screen Settings {
        Column { padding: 16; gap: 8 } {
            Text "Settings" { size: 28; bold: true }

            Row { gap: 8; align: "center" } {
                Text "Dark Mode" { size: 16 }
                Checkbox { on_click: toggleDarkMode }
            }

            Row { gap: 8; align: "center" } {
                Text "Language" { size: 16 }
                Select { on_click: changeLanguage }
            }

            Button "← Back" { on_click: goBack }
        }
    }
}

