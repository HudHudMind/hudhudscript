// Hello World UI — single screen with text and button

ui HelloApp {
    entry: Main;

    screen Main {
        Column {
            Text "Hello, HudHudScript!" { size: 24; bold: true }
            Text "Welcome to the UI system" { color: "#666" }
            Button "Click me" { background: "#1976D2"; color: "#fff" } {
                on_click: sayHello
            }
        }
    }
}

function sayHello() {
    print("Button clicked!");
}
