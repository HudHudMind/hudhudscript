// Styled App — flexbox layout, theme tokens, responsive

ui StyledApp {
    entry: Main;

    screen Main {
        Column { display: "flex"; flex_direction: "column"; gap: 24; padding: 24 } {
            // Header
            Row { justify_content: "space_between"; align_items: "center"; padding: 16; background: "#1976D2"; border_radius: 8 } {
                Text "StyledApp" { size: 24; bold: true; color: "#fff" }
                Row { gap: 8 } {
                    Button "Home" { color: "#fff" }
                    Button "About" { color: "#fff" }
                    Button "Contact" { color: "#fff" }
                }
            }

            // Main content — 2 column layout
            Row { gap: 16; flex_wrap: "wrap" } {
                // Sidebar
                Column { width: "250"; gap: 8 } {
                    Card { padding: 16; border_radius: 8; background: "#f5f5f5" } {
                        Text "Navigation" { bold: true; size: 16 }
                        Link "Dashboard" { color: "#1976D2" }
                        Link "Projects" { color: "#1976D2" }
                        Link "Analytics" { color: "#1976D2" }
                    }
                }

                // Content area
                Column { flex_grow: 1; gap: 16 } {
                    // Stats row
                    Row { gap: 12 } {
                        Card { flex_grow: 1; padding: 16; border_radius: 8; background: "#e8f5e9" } {
                            Text "128" { size: 32; bold: true; color: "#388E3C" }
                            Text "Active Users" { size: 12; color: "#757575" }
                        }
                        Card { flex_grow: 1; padding: 16; border_radius: 8; background: "#e3f2fd" } {
                            Text "42" { size: 32; bold: true; color: "#1976D2" }
                            Text "Projects" { size: 12; color: "#757575" }
                        }
                        Card { flex_grow: 1; padding: 16; border_radius: 8; background: "#fff3e0" } {
                            Text "99.9%" { size: 32; bold: true; color: "#F57C00" }
                            Text "Uptime" { size: 12; color: "#757575" }
                        }
                    }

                    // Data table
                    Table {
                        Text "Recent Activity" { bold: true; size: 18 }
                    }
                }
            }

            // Footer
            Row { justify_content: "center"; padding: 16; opacity: 0.6 } {
                Text "© 2026 HudHudScript" { size: 12; color: "#757575" }
            }
        }
    }
}
