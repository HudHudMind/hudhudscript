// Reusable Components

ui ComponentApp {
    entry: Main;

    component UserCard {
        Card { padding: 16; border_radius: 12; background: "#f5f5f5" } {
            Row { gap: 12; align: "center" } {
                Icon "user" { size: 40; color: "#1976D2" }
                Column { gap: 4 } {
                    Text "Username" { bold: true; size: 16 }
                    Text "Role" { color: "#757575"; size: 12 }
                }
            }
        }
    }

    component StatCard {
        Card { padding: 12; border_radius: 8; background: "#e3f2fd" } {
            Column { align: "center"; gap: 4 } {
                Text "0" { size: 32; bold: true; color: "#1976D2" }
                Text "Label" { size: 12; color: "#757575" }
            }
        }
    }

    screen Main {
        Column { padding: 16; gap: 16 } {
            Text "Dashboard" { size: 28; bold: true }

            Row { gap: 12 } {
                StatCard
                StatCard
                StatCard
            }

            Text "Team" { size: 20; bold: true }

            Column { gap: 8 } {
                UserCard
                UserCard
                UserCard
            }
        }
    }
}
