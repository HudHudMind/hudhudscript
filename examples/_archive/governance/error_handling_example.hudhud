// Error Handling Example
// Demonstrates governance error handling

// Attempt to reference non-existent constitution
// This will raise ConstitutionNotFoundError
council InvalidCouncil {
    constitution: "NonExistent",  // Error: Constitution not found
    members: [
        { agent: "agent1", role: "Member" }
    ],
    rules: []
}

// Attempt to create circular dependency
// This will raise CircularDependencyError
constitution A {
    description: "Constitution A",
    laws: [
        {
            name: "LawA",
            description: "References B",
            enforcement: mandatory,
            rules: []
        }
    ]
}

constitution B {
    description: "Constitution B references A",
    laws: [
        {
            name: "LawB",
            description: "References A",
            enforcement: mandatory,
            rules: []
        }
    ]
}
// Circular: A -> B -> A (Error: CircularDependencyError)

// Invalid role assignment
// This will raise InvalidRoleError or default to "Member"
council TestCouncil {
    constitution: "A",
    members: [
        { agent: "agent1", role: "InvalidRole" }  // Error or default to Member
    ],
    rules: []
}

// Invalid ID format
// This will raise FormatValidationError
constitution InvalidId {
    id: "invalid-format",  // Error: Expected format "cons.\d+"
    description: "Invalid ID",
    laws: []
}

print("Error handling examples")
print("Errors provide context and suggestions")
