// Async Pending Promise Example
// This demonstrates how async pending promises work with AsyncRuntime

// Note: This is a conceptual example
// Real async execution requires runtime integration

// Create an async function that returns a promise
async function fetchData() {
    // This would spawn an async task in the runtime
    // For now, we return a resolved promise
    return Promise.resolve("data loaded");
}

// Call the async function
let promise = fetchData();

// Await the promise
let result = await promise;
print("Result: ", result);

// Multiple async operations
async function operation1() {
    return Promise.resolve(1);
}

async function operation2() {
    return Promise.resolve(2);
}

async function operation3() {
    return Promise.resolve(3);
}

// Execute all operations
let p1 = operation1();
let p2 = operation2();
let p3 = operation3();

// Wait for all
let results = await Promise.all([p1, p2, p3]);
print("All results: ", results);

// Race example
let fastest = await Promise.race([p1, p2, p3]);
print("Fastest: ", fastest);
