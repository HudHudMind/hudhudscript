// Basic Function Example
// Tests regular function declarations

print("=== Basic Function Test ===");
print("");

// Test 1: Simple function
function greet(name) {
    return "Hello " + name;
}

let message = greet("World");
print("Test 1: " + message);
print("");

// Test 2: Function with multiple parameters
function add(x, y) {
    return x + y;
}

let sum = add(5, 3);
print("Test 2: 5 + 3 = " + sum);
print("");

// Test 3: Function with no parameters
function getGreeting() {
    return "Welcome!";
}

let greeting = getGreeting();
print("Test 3: " + greeting);
print("");

// Test 4: Function calling another function
function multiply(a, b) {
    return a * b;
}

function calculate(x, y) {
    let product = multiply(x, y);
    let total = add(product, 10);
    return total;
}

let result = calculate(3, 4);
print("Test 4: (3 * 4) + 10 = " + result);
print("");

print("✅ Basic Function test completed");
