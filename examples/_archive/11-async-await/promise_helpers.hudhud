// Promise Helper Functions Example
// Demonstrates Promise built-in functions

print("=== Promise Helpers Demo ===");

// Promise helpers are available as built-in functions
// They will be used for async operations in the future

// 1. Promise.resolve() and Promise.reject() are available
print("Promise.resolve() - Creates resolved promises");
print("Promise.reject() - Creates rejected promises");

// 2. Promise.all() - Waits for all promises
print("Promise.all() - Waits for all promises to resolve");
print("  - Returns array of all results");
print("  - Rejects if any promise rejects");

// 3. Promise.race() - Gets first settled promise
print("Promise.race() - Returns first settled promise");
print("  - Can be resolved or rejected");
print("  - Useful for timeouts");

// 4. Mixed values support
print("Non-promise values are treated as resolved");
print("  - Useful for handling sync and async values");

print("=== Promise Helpers Ready! ===");
