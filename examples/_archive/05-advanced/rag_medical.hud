// ============================================================================
// RAG Medical Knowledge Base — HudHudScript v0.4.2
// Issue #226: Retrieval-Augmented Generation for Medical Knowledge
//
// Demonstrates: store, remember, recall for vector-based knowledge retrieval.
// Uses only syntax supported by the current parser.
//
// Aspirational features (tracked in v0.4.x roadmap):
//   - record declarations (typed structs)
//   - permission declarations
//   - recall...top N where { filter }
//   - remember...with { metadata }
//   - typed state annotations in subjects
//   - memory bindings inside subjects
// ============================================================================

// ============================================================
// 1. Providers
// ============================================================

provider medical_llm {
    type: "anthropic",
    model: "claude-3-sonnet",
    api_key: "sk-ant-your-key",
    max_tokens: 2048,
    temperature: 0.1
}

// ============================================================
// 2. Vector Stores
// ============================================================

store medical_knowledge {
    backend: "hnsw",
    dimensions: 1536,
    distance: "cosine"
}

store patient_records {
    backend: "hnsw",
    dimensions: 1536,
    distance: "cosine"
}

// ============================================================
// 3. Roles
// ============================================================

role Clinician {
    can diagnose,
    can prescribe,
    can consult
}

// ============================================================
// 4. Subjects
// ============================================================

subject DoctorAI has Clinician {
    state patients_seen: 0,
    state confidence_threshold: 0.75
}

// ============================================================
// 5. Knowledge Ingestion — remember statements
// ============================================================

remember "Penicillin is contraindicated in patients with penicillin allergy." in medical_knowledge;
remember "Type 2 diabetes requires regular HbA1c monitoring every 3 months." in medical_knowledge;
remember "ACE inhibitors are first-line treatment for hypertension with diabetes." in medical_knowledge;
remember "Metformin is contraindicated in patients with eGFR below 30 mL/min." in medical_knowledge;
remember "Aspirin should be avoided in children under 16 due to Reye syndrome risk." in medical_knowledge;
remember "Warfarin interacts with over 200 medications." in medical_knowledge;
remember "SSRIs should not be combined with MAOIs." in medical_knowledge;

// Patient record
remember "Patient Ahmed, age 58. Allergies: penicillin. Conditions: type 2 diabetes, hypertension." in patient_records;

// ============================================================
// 6. Knowledge Recall — semantic retrieval
// ============================================================

print("=== Medical RAG Demo ===");

let query1 = "Patient has diabetes and high blood pressure, what medication?";
recall query1 from medical_knowledge;
print("Query 1: " + query1);
print("Results retrieved from medical_knowledge store.");

let query2 = "What antibiotics are safe for a penicillin-allergic patient?";
recall query2 from medical_knowledge;
print("Query 2: " + query2);
print("Results retrieved from medical_knowledge store.");

// ============================================================
// 7. Summary
// ============================================================

print("=== Medical RAG Summary ===");
print("Knowledge base: 7 medical facts ingested");
print("Patient records: 1 patient profile stored");
print("2 queries performed against knowledge base");
print("Medical RAG demo complete.");
