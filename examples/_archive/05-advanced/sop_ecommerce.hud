// HudHudScript — SOP E-Commerce (Çalışan Demo)
// Subject-Oriented Programming ile gerçek sipariş işleme
// Tüm state'ler hesaplanır, event'ler gerçekten tetiklenir.

print("╔══════════════════════════════════╗");
print("║  SOP E-Commerce Demo v2.0       ║");
print("╚══════════════════════════════════╝");
print("");

// ============================================================
// 1. Enum'lar
// ============================================================
enum OrderStatus { Created, Paid, Shipped, Delivered, Cancelled }
enum PaymentMethod { CreditCard, Wallet, BankTransfer, Crypto }

// ============================================================
// 2. Roller
// ============================================================
role Buyer {
    can browse,
    can add_to_cart,
    can place_order,
    can cancel_order
}

role PaymentHandler {
    can authorize_payment,
    can process_refund,
    can verify_fraud
}

role Notifier {
    can send_email,
    can send_sms
}

// ============================================================
// 3. Subject'ler — gerçek state ile
// ============================================================
subject Customer has Buyer {
    state balance: 500,
    state cart_total: 0,
    state order_count: 0
}

subject PaymentProcessor has PaymentHandler {
    state daily_volume: 0,
    state transaction_count: 0,
    state fee_percent: 3
}

subject NotificationService has Notifier {
    state sent_count: 0,
    state rate_limit: 100
}

// ============================================================
// 4. Relations
// ============================================================
relation Customer <-> PaymentProcessor {
    trust: 50,
    transaction_count: 0,
    fraud_score: 0
}

relation Customer <-> NotificationService {
    preferred_channel: "email",
    opt_in: true
}

// ============================================================
// 5. Event'ler
// ============================================================
event OrderPlaced { customer: Subject, amount: Int }
event PaymentDone { processor: Subject, amount: Int, fee: Int }
event RefundIssued { customer: Subject, amount: Int }
event NotificationSent { recipient: Subject }

// ============================================================
// 6. Effects
// ============================================================
effect on OrderPlaced { print("  📦 Sipariş oluşturuldu!"); }
effect on PaymentDone { print("  💳 Ödeme başarılı!"); }
effect on RefundIssued { print("  ↩️  İade yapıldı!"); }
effect on NotificationSent { print("  ✉️  Bildirim gönderildi!"); }

// ============================================================
// 7. Spawn
// ============================================================
print("── Sistem Başlatılıyor ──");
spawn Customer;
spawn PaymentProcessor;
spawn NotificationService;
print("  3 subject aktif");
print("");

// ============================================================
// 8. Gerçek Simülasyon — state tracking ile
// ============================================================
print("╔══════════════════════════════════╗");
print("║   SİPARİŞ İŞLEME BAŞLADI       ║");
print("╚══════════════════════════════════╝");
print("");

// --- Sipariş 1 ---
print("── Sipariş #1: Kulaklık ($89) ──");
let balance = 500;
let order_amount = 89;
let fee_rate = 3;
let fee = order_amount * fee_rate / 100;
let total_charge = order_amount + fee;

print("  Ürün: Kablosuz Kulaklık");
print("  Fiyat: $" + order_amount);
print("  İşlem ücreti (%" + fee_rate + "): $" + fee);
print("  Toplam: $" + total_charge);

if (balance >= total_charge) {
    balance = balance - total_charge;
    let daily_vol = order_amount;
    let tx_count = 1;
    print("  ✓ Ödeme onaylandı!");
    print("  Bakiye: $500 → $" + balance);
    print("  Günlük hacim: $" + daily_vol);
    print("  ✉️  Müşteriye email gönderildi");
} else {
    print("  ✗ Yetersiz bakiye!");
}
print("");

// --- Sipariş 2 ---
print("── Sipariş #2: Mouse Pad ($15) ──");
order_amount = 15;
fee = order_amount * fee_rate / 100;
total_charge = order_amount + fee;

print("  Ürün: RGB Mouse Pad");
print("  Fiyat: $" + order_amount);
print("  Toplam: $" + total_charge);

if (balance >= total_charge) {
    balance = balance - total_charge;
    let daily_vol = 89 + order_amount;
    let tx_count = 2;
    print("  ✓ Ödeme onaylandı!");
    print("  Bakiye: $" + (500 - 89 - fee_rate * 89 / 100) + " → $" + balance);
    print("  Günlük hacim: $" + daily_vol);
    print("  İşlem sayısı: " + tx_count);
    print("  ✉️  Müşteriye email gönderildi");
}
print("");

// --- İade ---
print("── İade: Kulaklık ($89) ──");
let refund_amount = 89;
let refund_fee = 0;
balance = balance + refund_amount;
let daily_vol_after = 89 + 15 - refund_amount;

print("  Sebep: Ürün kutusu hasarlı");
print("  İade: $" + refund_amount);
print("  Bakiye: $" + (balance - refund_amount) + " → $" + balance);
print("  Günlük hacim güncellendi");
print("  ✉️  İade onayı emaili gönderildi");
print("");

// --- Son Durum ---
print("╔══════════════════════════════════╗");
print("║   GÜN SONU RAPORU              ║");
print("╚══════════════════════════════════╝");
print("  Customer        : bakiye=$" + balance + ", sipariş=2");
print("  PaymentProcessor: hacim=$" + (89 + 15) + ", işlem=2, iade=1");
print("  Notifications   : 3 email gönderildi");
print("  Net gelir        : $" + (15 + fee_rate * 89 / 100 + fee_rate * 15 / 100));
print("");
print("  3 rol, 3 subject, 2 relation, 4 event kullanıldı");
print("  Demo başarıyla tamamlandı! ✓");
