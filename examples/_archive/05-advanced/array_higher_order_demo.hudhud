// Array Higher-Order Methods Demo

print("=== Array Higher-Order Methods ===");
print("");

var numbers = [1, 2, 3, 4, 5];
print("Original array: ", numbers);
print("");

// Map - transform each element
print("=== map() ===");
var doubled = numbers.map((x) => x * 2);
print("Doubled: ", doubled);
print("");

// Filter - keep only matching elements
print("=== filter() ===");
var evens = numbers.filter((x) => x % 2 == 0);
print("Evens: ", evens);
print("");

// Reduce - accumulate to single value
print("=== reduce() ===");
var sum = numbers.reduce((acc, x) => acc + x, 0);
print("Sum: ", sum);
var product = numbers.reduce((acc, x) => acc * x, 1);
print("Product: ", product);
print("");

// Find - get first matching element
print("=== find() ===");
var found = numbers.find((x) => x > 3);
print("First > 3: ", found);
print("");

// Some - check if any element matches
print("=== some() ===");
var hasEven = numbers.some((x) => x % 2 == 0);
print("Has even: ", hasEven);
var hasNegative = numbers.some((x) => x < 0);
print("Has negative: ", hasNegative);
print("");

// Every - check if all elements match
print("=== every() ===");
var allPositive = numbers.every((x) => x > 0);
print("All positive: ", allPositive);
var allEven = numbers.every((x) => x % 2 == 0);
print("All even: ", allEven);
print("");

// ForEach - iterate with side effects
print("=== forEach() ===");
print("Printing each element:");
numbers.forEach((x) => print("  ", x));
print("");

// Chaining methods
print("=== Method Chaining ===");
var evensOnly = numbers.filter((x) => x % 2 == 0);
var result = evensOnly.map((x) => x * x);
print("Even numbers squared: ", result);
