// Math Object Demo - Testing all Math functions and constants

// Test Math constants
print("=== Math Constants ===");
print("Math.PI = ", Math.PI);
print("Math.E = ", Math.E);
print("");

// Test Math.abs()
print("=== Math.abs() ===");
print("Math.abs(-5) = ", Math.abs(-5));
print("Math.abs(3.14) = ", Math.abs(3.14));
print("Math.abs(-10.5) = ", Math.abs(-10.5));
print("");

// Test Math.sqrt()
print("=== Math.sqrt() ===");
print("Math.sqrt(16) = ", Math.sqrt(16));
print("Math.sqrt(2) = ", Math.sqrt(2));
print("Math.sqrt(100) = ", Math.sqrt(100));
print("");

// Test Math.pow()
print("=== Math.pow() ===");
print("Math.pow(2, 3) = ", Math.pow(2, 3));
print("Math.pow(5, 2) = ", Math.pow(5, 2));
print("Math.pow(10, 0) = ", Math.pow(10, 0));
print("");

// Test Math.floor()
print("=== Math.floor() ===");
print("Math.floor(4.9) = ", Math.floor(4.9));
print("Math.floor(4.1) = ", Math.floor(4.1));
print("Math.floor(-2.7) = ", Math.floor(-2.7));
print("");

// Test Math.ceil()
print("=== Math.ceil() ===");
print("Math.ceil(4.1) = ", Math.ceil(4.1));
print("Math.ceil(4.9) = ", Math.ceil(4.9));
print("Math.ceil(-2.3) = ", Math.ceil(-2.3));
print("");

// Test Math.round()
print("=== Math.round() ===");
print("Math.round(4.5) = ", Math.round(4.5));
print("Math.round(4.4) = ", Math.round(4.4));
print("Math.round(-2.5) = ", Math.round(-2.5));
print("");

// Test Math.min()
print("=== Math.min() ===");
print("Math.min(5, 3) = ", Math.min(5, 3));
print("Math.min(-1, 10) = ", Math.min(-1, 10));
print("Math.min(7.5, 7.2) = ", Math.min(7.5, 7.2));
print("");

// Test Math.max()
print("=== Math.max() ===");
print("Math.max(5, 3) = ", Math.max(5, 3));
print("Math.max(-1, 10) = ", Math.max(-1, 10));
print("Math.max(7.5, 7.2) = ", Math.max(7.5, 7.2));
print("");

// Test Math.random()
print("=== Math.random() ===");
print("Math.random() = ", Math.random());
print("Math.random() = ", Math.random());
print("Math.random() = ", Math.random());
print("");

// Practical examples
print("=== Practical Examples ===");

// Calculate circle area
var radius = 5;
var area = Math.PI * Math.pow(radius, 2);
print("Circle area (radius=5): ", area);

// Calculate distance (Pythagorean theorem)
var a = 3;
var b = 4;
var distance = Math.sqrt(Math.pow(a, 2) + Math.pow(b, 2));
print("Distance (3,4): ", distance);

// Random integer between 1 and 10
var randomInt = Math.floor(Math.random() * 10) + 1;
print("Random int (1-10): ", randomInt);
