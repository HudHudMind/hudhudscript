// Agent Orchestration Example
// Multiple agents working together

// Import MCP servers
use postgres as db;
use openai as ai;

// Define data collector agent
agent DataCollector {
    model: "gpt-4",
    temperature: 0.3,
}

// Define data analyzer agent
agent DataAnalyzer {
    model: "gpt-4o",
    temperature: 0.7
}

// Define report generator agent
agent ReportGenerator {
    model: "gpt-4",
    temperature: 0.5
}

// Orchestrate the workflow
var collector = DataCollector();
var analyzer = DataAnalyzer();
var reporter = ReportGenerator();

// Step 1: Collect data
print("Step 1: Collecting data...");
var data = collector.call(db.query, {
    sql: "SELECT * FROM sales WHERE date >= '2024-01-01'"
});

// Step 2: Analyze data
print("Step 2: Analyzing data...");
var analysis = analyzer.call(ai.analyze, {
    data: data,
    prompt: "Analyze sales trends and identify key insights"
});

// Step 3: Generate report
print("Step 3: Generating report...");
var report = reporter.generate({
    analysis: analysis,
    format: "markdown"
});

print("Report generated:");
print(report);
