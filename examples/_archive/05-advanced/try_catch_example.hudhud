// Try-Catch-Finally Example
// Demonstrates error handling

// Basic try-catch
try {
  throw "Something went wrong";
} catch (error) {
  var x = 1;
}

// Try-catch-finally
try {
  var data = 42;
} catch (error) {
  var y = 2;
} finally {
  var z = 3;
}

// Try without catch (only finally)
try {
  var a = 1;
} finally {
  var b = 2;
}
