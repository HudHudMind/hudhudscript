// Multi-Language Agent Example
// Demonstrates same AST from different languages

// English (SVO)
agent DataAnalyst {
    model: "gpt-4",
    temperature: 0.7,
    max_tokens: 2000
}

// Turkish (SOV) - Same AST!
ajan VeriAnalist {
    model: "gpt-4",
    temperature: 0.7,
    max_tokens: 2000
}

// Japanese (SOV + Particles) - Same AST!
eijento DeetaAnalisuto {
    model: "gpt-4",
    temperature: 0.7,
    max_tokens: 2000
}

// All three compile to identical AST nodes!
