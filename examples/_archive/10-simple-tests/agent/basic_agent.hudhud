// Basic Agent Test - Simple agent definition and usage

// Test 1: Simple agent-like object
var simpleAgent = {
    name: "TestAgent",
    model: "gpt-4",
    task: "Test basic functionality",
    status: "ready"
};

print("Agent Name: " + simpleAgent.name);
print("Agent Model: " + simpleAgent.model);
print("Agent Task: " + simpleAgent.task);
print("Agent Status: " + simpleAgent.status);

// Test 2: Agent with data
var calculator = {
    name: "Calculator",
    lastResult: 0
};

print("Calculator Agent: " + calculator.name);

// Simple calculations
var sum = 5 + 3;
print("5 + 3 = " + sum);

var product = 4 * 7;
print("4 * 7 = " + product);

// Test 3: Agent state
var counter = 0;
print("Initial count: " + counter);
let counter = counter + 1;
let counter = counter + 1;
let counter = counter + 1;
print("After 3 increments: " + counter);

print("✅ Basic Agent test completed");
