// Test string concatenation with numbers

print("Test 1: String + Number");
let result1 = "Value: " + 42;
print(result1);

print("\nTest 2: Number + String");
let result2 = 100 + " items";
print(result2);

print("\nTest 3: Mixed concatenation");
let x = 10;
let y = 20;
let result3 = "Sum of " + x + " and " + y + " is " + (x + y);
print(result3);

print("\n✅ All string concatenation tests passed!");
