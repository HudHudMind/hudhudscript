// MCP Integration Example
// This demonstrates how to use MCP (Model Context Protocol) in HudHudScript

// Note: This example requires an MCP server to be registered programmatically
// In a real application, you would register MCP clients like this:
//
// let mut interpreter = Interpreter::new();
// let config = TransportConfig::stdio("uvx", vec!["mcp-server-sqlite".to_string()]);
// let client = McpClient::new(config).await?;
// interpreter.register_mcp_client("sqlite".to_string(), Arc::new(client));

// Example 1: Call an MCP tool
// Syntax: mcp.call(server_name, tool_name, arguments)
var result = mcp.call("sqlite", "query", {
    sql: "SELECT * FROM users WHERE age > 18"
});

print("Query result: ");
print(result);

// Example 2: Call with different arguments
var insert_result = mcp.call("sqlite", "execute", {
    sql: "INSERT INTO users (name, age) VALUES (?, ?)",
    params: ["Alice", 25]
});

print("Insert result: ");
print(insert_result);

// Example 3: Error handling with MCP calls
try {
    var data = mcp.call("nonexistent_server", "tool", {});
} catch (error) {
    print("Error: Server not found");
}

// Example 4: Using MCP results in logic
var users = mcp.call("sqlite", "query", {
    sql: "SELECT name, age FROM users"
});

// Process results
if (users) {
    print("Found users!");
} else {
    print("No users found");
}
