// Quick OpenAI API Test
// Simple test to verify provider is working
// Set OPENAI_API_KEY before running

agent QuickTest {
    let provider = "openai";
    
    function test1() {
        print("Test 1: Simple greeting");
        let response = this.call("Say hello in one sentence");
        print("Response: " + response.content);
        print("Tokens used: " + response.tokens_used);
        print("");
    }
    
    function test2() {
        print("Test 2: Math question");
        let response = this.call("What is 2+2? Answer in one word.");
        print("Response: " + response.content);
        print("Tokens used: " + response.tokens_used);
        print("");
    }
    
    function test3() {
        print("Test 3: Code review");
        let code = "function add(a, b) { return a + b; }";
        let response = this.call("Review this code: " + code);
        print("Response: " + response.content);
        print("Tokens used: " + response.tokens_used);
        print("");
    }
    
    // Run tests
    print("=== Quick API Test ===");
    print("");
    test1();
    test2();
    test3();
    print("=== Tests complete ===");
}
