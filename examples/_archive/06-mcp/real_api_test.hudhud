// Real OpenAI API Test
// This example tests actual API calls and measures performance
// Set OPENAI_API_KEY before running

agent PerformanceTester {
    let provider = "openai";
    
    // Test 1: Simple prompt
    function testSimple() {
        print("Test 1: Simple prompt");
        let start = Date.now();
        
        let response = this.call("Say hello in one sentence");
        
        let duration = Date.now() - start;
        print("Response: " + response.content);
        print("Tokens: " + response.tokens_used);
        print("Duration: " + duration + "ms");
        print("---");
        
        return response;
    }
    
    // Test 2: With options
    function testWithOptions() {
        print("Test 2: With options");
        let start = Date.now();
        
        let response = this.call("Explain quantum computing", {
            temperature: 0.5,
            max_tokens: 100
        });
        
        let duration = Date.now() - start;
        print("Response: " + response.content);
        print("Tokens: " + response.tokens_used);
        print("Duration: " + duration + "ms");
        print("---");
        
        return response;
    }
    
    // Test 3: Mnemonic (token optimization)
    mnemonic CODE_REVIEW = "Review this code for bugs, security issues, and performance problems. Provide specific line-by-line feedback.";
    
    function testMnemonic() {
        print("Test 3: Mnemonic (token optimization)");
        let code = "function add(a, b) { return a + b; }";
        
        // Without mnemonic (baseline)
        print("Without mnemonic:");
        let start1 = Date.now();
        let response1 = this.call("Review this code for bugs, security issues, and performance problems. Provide specific line-by-line feedback: " + code);
        let duration1 = Date.now() - start1;
        print("Tokens: " + response1.tokens_used);
        print("Duration: " + duration1 + "ms");
        
        // With mnemonic (optimized)
        print("With mnemonic:");
        let start2 = Date.now();
        let response2 = this.call(CODE_REVIEW + ": " + code);
        let duration2 = Date.now() - start2;
        print("Tokens: " + response2.tokens_used);
        print("Duration: " + duration2 + "ms");
        
        // Calculate savings
        let tokenSavings = response1.tokens_used - response2.tokens_used;
        let percentSavings = (tokenSavings / response1.tokens_used) * 100;
        print("Token savings: " + tokenSavings + " (" + percentSavings + "%)");
        print("---");
        
        return {
            without: response1,
            with: response2,
            savings: tokenSavings
        };
    }
    
    // Test 4: Multiple calls
    function testMultipleCalls() {
        print("Test 4: Multiple calls");
        let questions = [
            "What is 2+2?",
            "What is the capital of France?",
            "What is the speed of light?"
        ];
        
        let totalTokens = 0;
        let totalDuration = 0;
        
        for (let i = 0; i < questions.length; i = i + 1) {
            let q = questions[i];
            let start = Date.now();
            let response = this.call(q);
            let duration = Date.now() - start;
            
            print("Q: " + q);
            print("A: " + response.content);
            print("Tokens: " + response.tokens_used);
            print("Duration: " + duration + "ms");
            
            totalTokens = totalTokens + response.tokens_used;
            totalDuration = totalDuration + duration;
        }
        
        print("Total tokens: " + totalTokens);
        print("Total duration: " + totalDuration + "ms");
        print("Average per call: " + (totalDuration / questions.length) + "ms");
        print("---");
        
        return {
            totalTokens: totalTokens,
            totalDuration: totalDuration,
            callCount: questions.length
        };
    }
    
    // Test 5: Error handling
    function testErrorHandling() {
        print("Test 5: Error handling");
        
        try {
            // This should fail - empty prompt
            let response = this.call("");
            print("Unexpected success");
        } catch (error) {
            print("Caught error (expected): " + error);
        }
        
        print("---");
    }
    
    // Run all tests
    function runAll() {
        print("=== OpenAI API Performance Tests ===");
        print("");
        
        testSimple();
        testWithOptions();
        testMnemonic();
        testMultipleCalls();
        testErrorHandling();
        
        print("=== All tests complete ===");
    }
    
    // Execute
    runAll();
}
