// HudHudScript — MCP Server Definition and Tool Usage Example
// Issue #25: MCP server definition and tool usage
//
// Demonstrates MCP server and tool declarations.
// Note: Inline task definitions inside agent bodies are aspirational
// syntax. Agent logic uses standalone functions with mcp.call stubs.

// ============================================================
// 1. MCP Server Declarations
// ============================================================

// Aspirational: Live MCP server connections require the servers to
// be installed and reachable. These declarations define the topology.

// mcp server my_server {
//     transport: "stdio",
//     command: "npx",
//     args: ["-y", "@modelcontextprotocol/server-filesystem"]
// }
//
// mcp server remote_db {
//     transport: "sse",
//     url: "http://localhost:8080/mcp"
// }

// ============================================================
// 2. Tool Declarations
// ============================================================

// Note: standalone tool declarations are aspirational syntax.
// Tools are defined inside MCP server blocks in current grammar.
// tool read_file {
//     name: "read_file",
//     description: "Read contents of a file",
//     server: "my_server"
// }
// tool write_file {
//     name: "write_file",
//     description: "Write text to a file",
//     server: "my_server"
// }
// tool query_records {
//     name: "query_records",
//     description: "Query database records",
//     server: "remote_db"
// }

// ============================================================
// 3. Agents that use MCP tools
// ============================================================

agent FileBot {
    role: "file_management",
    intent: "Read, process, and write files via the filesystem MCP server"
}

agent DataBot {
    role: "data_access"
}

// ============================================================
// 4. Standalone task functions
//    In production these would use mcp.call(); here we provide
//    stubs so the sample runs without live MCP servers.
// ============================================================

fn file_read(path) {
    // Aspirational: mcp.call("my_server", "read_file", { path: path })
    return "Contents of " + path;
}

fn file_write(path, content) {
    // Aspirational: mcp.call("my_server", "write_file", { path: path, content: content })
    return "Wrote to " + path;
}

fn file_copy(src, dst) {
    let data = file_read(src);
    file_write(dst, data);
    return "Copied " + src + " -> " + dst;
}

fn fetch_users() {
    // Aspirational: mcp.call("remote_db", "query_records", { table: "users" })
    return "User records from database";
}

// ============================================================
// 5. Main script — demonstrate the functions
// ============================================================

// Read a configuration file
let config = file_read("/etc/app/config.json");
print("Config loaded:");
print(config);

// Write a result file
let status = file_write("/tmp/output.txt", "Processing complete");
print("Write status:");
print(status);

// Copy a template
let copy_result = file_copy("/templates/report.md", "/tmp/report.md");
print(copy_result);

// Error handling around file operations
try {
    let data = file_read("/nonexistent.txt");
    print(data);
} catch (err) {
    print("File not found — continuing gracefully");
}

// Database query
print("Fetching users...");
let db_users = fetch_users();
print("Active users:");
print(db_users);

print("MCP example complete.");
