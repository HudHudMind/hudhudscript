// Functions Example
// Demonstrates function definitions and calls

// Simple function
var greet = (name) => {
    return "Hello, " + name + "!";
};

print(greet("Alice"));
print(greet("Bob"));

// Function with multiple parameters
var add = (a, b) => {
    return a + b;
};

print("5 + 3 =");
print(add(5, 3));

// Function with no parameters
var getRandomNumber = () => {
    return 42; // Not really random :)
};

print("Random number:");
print(getRandomNumber());

// Recursive function - factorial
var factorial = (n) => {
    if (n <= 1) {
        return 1;
    }
    return n * factorial(n - 1);
};

print("Factorial of 5:");
print(factorial(5));

// Higher-order function
var applyOperation = (a, b, operation) => {
    return operation(a, b);
};

var multiply = (x, y) => {
    return x * y;
};

var result = applyOperation(4, 5, multiply);
print("4 * 5 =");
print(result);

// Function returning function (closure)
var makeCounter = () => {
    var count = 0;
    return () => {
        count = count + 1;
        return count;
    };
};

var counter = makeCounter();
print("Counter:");
print(counter()); // 1
print(counter()); // 2
print(counter()); // 3
