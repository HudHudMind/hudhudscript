// Simple test for data keyword in entities
// Testing basic entity with data fields

entity Customer {
    data id: string
    data name: string
    data age: number
}

// Create a customer instance (simplified - just testing parsing)
let customer_id = "CUST001";
let customer_name = "John Doe";
let customer_age = 30;

print(customer_id);
print(customer_name);
print(customer_age);

// Test arithmetic
let total = customer_age + 5;
print(total);
