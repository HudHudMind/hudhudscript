// Web Deploy — Next.js + Vercel

deploy MyWebApp {
    target {
        web {
            framework: "nextjs";
            port: 3000;
            ssr: true;
        }
    }

    vercel {
        project: "my-web-app";
        team: "hudhud-team";
        production_branch: "main";
        preview: true;
    }

    github {
        repo: "HudHudMind/my-web-app";
        on: "push";
        branch: "main";
    }
}
