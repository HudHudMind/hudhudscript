// Desktop Deploy — Tauri

deploy MyDesktopApp {
    target {
        desktop {
            framework: "tauri";
            title: "My Desktop App";
            width: 1200;
            height: 800;
            resizable: true;
        }
    }

    github {
        repo: "HudHudMind/my-desktop-app";
        on: "push";
        branch: "main";
        matrix: "macos-latest, ubuntu-latest, windows-latest";
    }
}
