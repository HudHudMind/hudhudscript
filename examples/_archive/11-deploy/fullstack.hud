// Fullstack Deploy — multi-target with Docker + Kubernetes

deploy FullstackApp {
    target {
        web {
            framework: "nextjs";
            port: 3000;
        }
        desktop {
            framework: "tauri";
        }
        mobile {
            framework: "flutter";
        }
        wasm {
            framework: "wasm-bindgen";
            optimize: true;
        }
    }

    docker {
        image: "hudhud/fullstack-app";
        registry: "ghcr.io";
        base: "node:20-alpine";
    }

    kubernetes {
        namespace: "production";
        replicas: 3;
        cpu: "500m";
        memory: "512Mi";
    }

    github {
        repo: "HudHudMind/fullstack-app";
        on: "push";
        branch: "main";
    }
}
