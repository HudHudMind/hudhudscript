// Türkçe Hata Yönetimi Örneği
// Try-catch-finally kullanımı

// Temel dene-yakala
dene {
  var sonuç = 10 / 0
  yazdır(sonuç)
} yakala (hata) {
  yazdır("Hata yakalandı: Sıfıra bölme")
}

// Dene-yakala-sonunda
dene {
  yazdır("Riskli işlem deneniyor...")
  var veri = riskliİşlem()
  yazdır("Başarılı: " + veri)
} yakala (hata) {
  yazdır("Hata: " + hata)
} sonunda {
  yazdır("Temizlik tamamlandı")
}

// İç içe dene-yakala
dene {
  yazdır("Dış dene")
  dene {
    yazdır("İç dene")
    fırlat "İç hata"
  } yakala (içHata) {
    yazdır("İç yakala: " + içHata)
    fırlat "Dış hata"
  }
} yakala (dışHata) {
  yazdır("Dış yakala: " + dışHata)
}

// Sadece finally ile
dene {
  yazdır("Çalıştırılıyor...")
} sonunda {
  yazdır("Her zaman çalışır")
}
