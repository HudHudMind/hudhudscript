// Kapsamlı Türkçe test
tanım x = 10;
tanım y = 5;

// Arithmetic
tanım toplam = x + y;
tanım fark = x - y;
tanım carpim = x * y;

yaz(toplam);   // 15
yaz(fark);     // 5
yaz(carpim);   // 50

// Comparison ve else if
tanım not = 85;

(not >= 90) ise {
    yaz(100);  // A
} değilse ama (not >= 80) ise {
    yaz(200);  // B
} değilse ama (not >= 70) ise {
    yaz(300);  // C
} değilse ama (not >= 60) ise {
    yaz(400);  // D
} hiç biri değilse {
    yaz(500);  // F
}

// İşlev keyword testi (henüz implement edilmedi)
// işlev topla(a, b) {
//     dön a + b;
// }

