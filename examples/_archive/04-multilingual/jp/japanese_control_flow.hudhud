// 日本語の制御構文テスト
// Japanese Control Flow Test
// Kural 8: All keywords in native Japanese script

変数 数値 = 10
変数 限界 = 20

表示(数値)
表示(限界)

// もし-それでも (if-else)
もし (数値 < 限界) {
    表示(100)
} それでも {
    表示(200)
}

// もう一つのテスト
変数 値 = 5
もし (値 > 3) {
    表示(999)
}

// 間ループ (while loop)
変数 カウンター = 0
間 (カウンター < 5) {
    表示(カウンター)
    カウンター = カウンター + 1
}
