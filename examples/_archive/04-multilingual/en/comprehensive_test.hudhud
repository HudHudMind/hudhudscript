// Comprehensive test of all working features

// ============================================================================
// 1. VARIABLE DECLARATIONS (English, Turkish, Japanese)
// ============================================================================

let a = 10;
tanım b = 20;
teigi c = 30;

print(a);  // 10
print(b);  // 20
print(c);  // 30

// ============================================================================
// 2. ARITHMETIC OPERATIONS
// ============================================================================

let sum = a + b;        // 30
let diff = b - a;       // 10
let product = a * b;    // 200
let quotient = b / a;   // 2
let remainder = b % a;  // 0

print(sum);
print(diff);
print(product);
print(quotient);
print(remainder);

// ============================================================================
// 3. COMPARISON OPERATORS
// ============================================================================

// Greater than
(a > 5) ise {
    print(100);  // Should print
}

// Less than
(a < 5) ise {
    print(200);
} değilse {
    print(201);  // Should print
}

// Greater than or equal
(a >= 10) ise {
    print(300);  // Should print
}

// Less than or equal
(a <= 10) ise {
    print(400);  // Should print
}

// ============================================================================
// 4. IF-ELSE-IF-ELSE CHAINS (Turkish style)
// ============================================================================

tanım puan = 85;

(puan >= 90) ise {
    print(1000);
} değilse ama (puan >= 80) ise {
    print(2000);  // Should print
} değilse ama (puan >= 70) ise {
    print(3000);
} hiç biri değilse {
    print(4000);
}

// ============================================================================
// 5. NESTED CONDITIONALS
// ============================================================================

tanım x = 15;
tanım y = 25;

(x > 10) ise {
    (y > 20) ise {
        print(5000);  // Should print
    } değilse {
        print(5001);
    }
} değilse {
    print(5002);
}

// ============================================================================
// 6. COMPLEX EXPRESSIONS
// ============================================================================

let result1 = 5 + 3 * 2;      // 11 (multiplication first)
let result2 = (5 + 3) * 2;    // 16 (parentheses first)
let result3 = 10 - 3 - 2;     // 5 (left to right)

print(result1);
print(result2);
print(result3);

// ============================================================================
// 7. MULTIPLE COMPARISONS
// ============================================================================

tanım age = 25;

(age < 18) ise {
    print(6000);
} değilse ama (age < 30) ise {
    print(7000);  // Should print
} değilse ama (age < 50) ise {
    print(8000);
} hiçbiri değilse {
    print(9000);
}

print(999);  // Final marker
