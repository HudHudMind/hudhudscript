// اختبار الأرقام العربية
// Arabic Numbers Test

// استخدام الأرقام العربية الهندية
متغير عدد = ٤٢؛
متغير آخر = ١٠٠؛

اطبع(عدد)؛
اطبع(آخر)؛

// العمليات الحسابية
متغير مجموع = ٥ + ٣؛
متغير فرق = ١٠ - ٤؛
متغير ضرب = ٦ * ٧؛

اطبع(مجموع)؛
اطبع(فرق)؛
اطبع(ضرب)؛

// الشروط مع الأرقام العربية
إذا (عدد > ٤٠) {
    اطبع(١٠٠٠)؛
}

إذا (آخر >= ١٠٠) {
    اطبع(٢٠٠٠)؛
}

// أرقام عشرية
متغير عشري = ٣.١٤؛
اطبع(عشري)؛
