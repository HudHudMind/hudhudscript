// اختبار كلمة البيانات بالعربية

كيان عميل {
    بيانات معرف: نص
    بيانات اسم: نص
    بيانات عمر: رقم
}

// إنشاء عميل
متغير معرف_العميل = "CUST001"؛
متغير اسم_العميل = "أحمد محمد"؛
متغير عمر_العميل = ٢٥؛

اطبع(معرف_العميل)؛
اطبع(اسم_العميل)؛
اطبع(عمر_العميل)؛

// حساب
متغير المجموع = عمر_العميل + ١٠؛
اطبع(المجموع)؛
