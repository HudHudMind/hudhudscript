// builtins/datetime.rs — now routed through the shared dispatcher.
// ─────────────────────────────────────────────────────────────────────────────

#[test]
fn test_date_now_returns_number() {
    let result = call_date_method("now", &[]).unwrap();
    assert!(result.as_number().is_some());
    if let Some(ts) = result .as_number() {
        // Should be a reasonable UNIX timestamp (after year 2020)
        assert!(ts > 1_577_836_800.0);
    }
}

#[test]
fn test_date_parse_rfc3339() {
    let result = call_date_method(
        "parse",
        &[Value16::string("2024-01-15T12:00:00Z".to_string())],
    )
    .unwrap();
    assert!(result.as_number().is_some());
}

#[test]
fn test_date_parse_date_only() {
    let result =
        call_date_method("parse", &[Value16::string("2024-01-15".to_string())]).unwrap();
    assert!(result.as_number().is_some());
}

