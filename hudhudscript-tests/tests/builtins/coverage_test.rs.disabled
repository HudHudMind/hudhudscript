#[test]
fn test_crypto_hash_sha256() {
    let result = crypto_ops::crypto_hash(&[
        Value16::string("sha256".to_string()),
        Value16::string("hello".to_string()),
    ])
    .unwrap();
    if let Some(hex) = result .as_string() {
        // SHA-256 of "hello" is well-known
        assert_eq!(
            hex,
            "2cf24dba5fb0a30e26e83b2ac5b9e29e1b161e5c1fa7425e73043362938b9824"
        );
    } else {
        panic!("Expected string");
    }
}

#[test]
fn test_crypto_hash_sha512() {
    let result = crypto_ops::crypto_hash(&[
        Value16::string("sha512".to_string()),
        Value16::string("hello".to_string()),
    ])
    .unwrap();
    if let Some(hex) = result .as_string() {
        assert_eq!(hex.len(), 128); // SHA-512 = 64 bytes = 128 hex chars
    } else {
        panic!("Expected string");
    }
}

#[test]
fn test_crypto_hash_blake3_compat() {
    let result = crypto_ops::crypto_hash(&[
        Value16::string("blake3".to_string()),
        Value16::string("test".to_string()),
    ])
    .unwrap();
    assert!(result.as_string().is_some());
}

#[test]
fn test_crypto_hash_unknown_algorithm() {
    let err = crypto_ops::crypto_hash(&[
        Value16::string("md5".to_string()),
        Value16::string("data".to_string()),
    ])
    .unwrap_err();
    let msg = format!("{:?}", err);
    assert!(msg.contains("md5") || msg.contains("unsupported"));
}

#[test]
fn test_crypto_hash_deterministic() {
    let r1 = crypto_ops::crypto_hash(&[
        Value16::string("sha256".to_string()),
        Value16::string("same input".to_string()),
    ])
    .unwrap();
    let r2 = crypto_ops::crypto_hash(&[
        Value16::string("sha256".to_string()),
        Value16::string("same input".to_string()),
    ])
    .unwrap();
    assert_eq!(r1, r2);
}

// ─────────────────────────────────────────────────────────────────────────────
// builtins/linalg.rs — via the shared dispatcher.
// ─────────────────────────────────────────────────────────────────────────────

fn num_vec(nums: &[f64]) -> Value16 {
    Value16::array(nums.iter().map(|n| Value16::number(*n)).collect())
}

#[test]
fn test_linalg_dot_product() {
    let result = call_linalg_method(
        "dot",
        &[num_vec(&[1.0, 2.0, 3.0]), num_vec(&[4.0, 5.0, 6.0])],
    )
    .unwrap();
    // 1*4 + 2*5 + 3*6 = 4 + 10 + 18 = 32
    assert_eq!(result, Value16::number(32.0));
}

#[test]
fn test_linalg_dot_length_mismatch() {
    let err = call_linalg_method(
        "dot",
        &[num_vec(&[1.0, 2.0]), num_vec(&[1.0, 2.0, 3.0])],
    )
    .unwrap_err();
    let msg = format!("{:?}", err);
    assert!(msg.contains("length") || msg.contains("same"));
}

#[test]
fn test_linalg_norm() {
    let result = call_linalg_method("norm", &[num_vec(&[3.0, 4.0])]).unwrap();
    // |[3,4]| = 5.0
    assert_eq!(result, Value16::number(5.0));
}

#[test]
fn test_linalg_cross_product() {
    let result = call_linalg_method(
        "cross",
        &[num_vec(&[1.0, 0.0, 0.0]), num_vec(&[0.0, 1.0, 0.0])],
    )
    .unwrap();
    // [1,0,0] x [0,1,0] = [0,0,1]
    if let Some(arr) = result .as_array() {
        assert_eq!(arr.len(), 3);
        assert_eq!(arr[0], Value16::number(0.0));
        assert_eq!(arr[1], Value16::number(0.0));
        assert_eq!(arr[2], Value16::number(1.0));
    } else {
        panic!("Expected array");
    }
}

#[test]
fn test_linalg_cross_wrong_dimensions() {
    let err = call_linalg_method(
        "cross",
        &[num_vec(&[1.0, 2.0]), num_vec(&[3.0, 4.0])],
    )
    .unwrap_err();
    let msg = format!("{:?}", err);
    assert!(msg.contains("3D") || msg.contains("cross") || msg.contains("3"));
}

// ─────────────────────────────────────────────────────────────────────────────
// builtins/serialization.rs — extra edge cases, via shared dispatchers.
// ─────────────────────────────────────────────────────────────────────────────

#[test]
fn test_ini_parse_comments_ignored() {
    let ini = "# This is a comment\n; Another comment\n[section]\nkey = value\n";
    let result = call_ini_method("parse", &[Value16::string(ini.to_string())]).unwrap();
    if let Some(top) = result .as_object() {
        if let Some(section) = top.get("section") .and_then(|v| v.as_object()) {
            assert_eq!(
                section.get("key"),
                Some(&Value16::string("value".to_string()))
            );
        } else {
            panic!("Expected section");
        }
    } else {
        panic!("Expected object");
    }
}

#[test]
fn test_ini_parse_top_level_keys() {
    let ini = "global_key = 42\n[section]\nname = test\n";
    let result = call_ini_method("parse", &[Value16::string(ini.to_string())]).unwrap();
    if let Some(top) = result .as_object() {
        assert_eq!(top.get("global_key"), Some(&Value16::number(42.0)));
    } else {
        panic!("Expected object");
    }
}

#[test]
fn test_ini_parse_boolean_values() {
    let ini = "[flags]\nenabled = true\ndisabled = false\n";
    let result = call_ini_method("parse", &[Value16::string(ini.to_string())]).unwrap();
    if let Some(top) = result .as_object() {
        if let Some(flags) = top.get("flags") .and_then(|v| v.as_object()) {
            assert_eq!(flags.get("enabled"), Some(&Value16::boolean(true)));
            assert_eq!(flags.get("disabled"), Some(&Value16::boolean(false)));
        } else {
            panic!("Expected flags section");
        }
    } else {
        panic!("Expected object");
    }
}

#[test]
fn test_csv_parse_with_booleans() {
    let csv = "name,active\nAlice,true\nBob,false\n";
    let result = call_csv_method("parse", &[Value16::string(csv.to_string())]).unwrap();
    if let Some(rows) = result .as_array() {
        if let Some(row0) = &rows[0] .as_object() {
            assert_eq!(row0.get("active"), Some(&Value16::boolean(true)));
        }
        if let Some(row1) = &rows[1] .as_object() {
            assert_eq!(row1.get("active"), Some(&Value16::boolean(false)));
        }
    } else {
        panic!("Expected array");
    }
}

#[test]
fn test_toml_parse_with_array() {
    let toml = "items = [1, 2, 3]\n";
    let result = call_toml_method("parse", &[Value16::string(toml.to_string())]).unwrap();
    if let Some(top) = result .as_object() {
        if let Some(arr) = top.get("items") .and_then(|v| v.as_array()) {
            assert_eq!(arr.len(), 3);
        } else {
            panic!("Expected array for items");
        }
    } else {
        panic!("Expected object");
    }
}

#[test]
fn test_yaml_parse_null_value() {
    let yaml = "name: null\n";
    let result = call_yaml_method("parse", &[Value16::string(yaml.to_string())]).unwrap();
    if let Some(top) = result .as_object() {
        assert_eq!(top.get("name"), Some(&Value16::null()));
    } else {
        panic!("Expected object");
    }
}
