#![cfg(feature = "stack-vm-legacy")]
#![cfg(feature = "stack-vm-legacy")]
//! External tests for the hudhudscript-bytecode crate.
//! Covers: Bytecode construction, constant dedup, serialization (bincode + JSON),
//! validation, source positions, FunctionChunk, Value variants, error types.

use hudhudscript_bytecode::error::{compile_codes, CompileError, SourcePosition};
use hudhudscript_bytecode::{
    Bytecode, FunctionChunk, Instruction, PromiseState16, SymId, Value16, BYTECODE_VERSION,
};
use hudhudscript_shared_builtins::interner::intern;
use std::collections::HashMap;
use std::sync::Arc;

// ---------------------------------------------------------------------------
// 1. Construction & defaults
// ---------------------------------------------------------------------------

#[test]
fn bytecode_new_has_correct_version_and_empty_fields() {
    let bc = Bytecode::new();
    assert_eq!(bc.version, BYTECODE_VERSION);
    assert!(bc.constants.is_empty());
    assert!(bc.instructions.is_empty());
    assert!(bc.functions.is_empty());
    assert!(bc.source_positions.is_empty());
}

#[test]
fn bytecode_default_matches_new() {
    let a = Bytecode::new();
    let b = Bytecode::default();
    assert_eq!(a.version, b.version);
    assert_eq!(a.constants.len(), b.constants.len());
    assert_eq!(a.instructions.len(), b.instructions.len());
}

// ---------------------------------------------------------------------------
// 2. Constant pool & deduplication
// ---------------------------------------------------------------------------

#[test]
fn add_constant_deduplicates_primitives() {
    let mut bc = Bytecode::new();

    let i0 = bc.add_constant(Value16::null());
    let i1 = bc.add_constant(Value16::null());
    assert_eq!(i0, i1, "Null should be deduplicated");

    let i2 = bc.add_constant(Value16::boolean(true));
    let i3 = bc.add_constant(Value16::boolean(true));
    assert_eq!(i2, i3, "Boolean(true) should be deduplicated");
    assert_ne!(i0, i2, "Null and Boolean(true) should differ");

    let i4 = bc.add_constant(Value16::number(3.14));
    let i5 = bc.add_constant(Value16::number(3.14));
    assert_eq!(i4, i5, "Number should be deduplicated");

    let i6 = bc.add_constant(Value16::string("hello"));
    let i7 = bc.add_constant(Value16::string("hello"));
    // Strings use different intern keys, not deduplicated at constant pool level
    assert_ne!(i6, i7, "String values with separate allocs get distinct slots");

    // Pool should have exactly 5 unique entries
    assert_eq!(bc.constants.len(), 5);
}

#[test]
fn add_constant_does_not_deduplicate_complex_types() {
    let mut bc = Bytecode::new();
    let i0 = bc.add_constant(Value16::array(vec![Value16::number(1.0)]));
    let i1 = bc.add_constant(Value16::array(vec![Value16::number(1.0)]));
    // Complex types are not deduplicated — each gets its own slot
    assert_ne!(i0, i1);
    assert_eq!(bc.constants.len(), 2);
}

// ---------------------------------------------------------------------------
// 3. Source positions
// ---------------------------------------------------------------------------

#[test]
fn source_positions_push_and_get() {
    let mut bc = Bytecode::new();
    bc.push_source_position(Some((10, 5)));
    bc.push_source_position(None);
    bc.push_source_position(Some((20, 1)));

    assert_eq!(bc.get_source_position(0), Some((10, 5)));
    assert_eq!(bc.get_source_position(1), None);
    assert_eq!(bc.get_source_position(2), Some((20, 1)));
    // Out of bounds returns None
    assert_eq!(bc.get_source_position(100), None);
}

// ---------------------------------------------------------------------------
// 4. Bincode serialization round-trip
// ---------------------------------------------------------------------------

#[test]
fn bincode_round_trip_preserves_bytecode() {
    let mut bc = Bytecode::new();
    let idx = bc.add_constant(Value16::string("test"));
    bc.instructions.push(Instruction::LoadConst(idx));
    bc.instructions.push(Instruction::Print);
    bc.push_source_position(Some((1, 1)));
    bc.push_source_position(Some((1, 5)));

    let bytes = bc.to_bytes().expect("serialization should succeed");
    let bc2 = Bytecode::from_bytes(&bytes).expect("deserialization should succeed");

    assert_eq!(bc2.version, BYTECODE_VERSION);
    assert_eq!(bc2.constants.len(), 1);
    assert_eq!(bc2.instructions.len(), 2);
    assert_eq!(bc2.source_positions.len(), 2);
}

#[test]
fn bincode_version_mismatch_is_rejected() {
    let mut bc = Bytecode::new();
    bc.version = BYTECODE_VERSION + 99; // bogus version
    let bytes = bc.to_bytes().expect("serialization should succeed");
    let err = Bytecode::from_bytes(&bytes);
    assert!(err.is_err(), "mismatched version should be rejected");
    let msg = format!("{}", err.unwrap_err());
    assert!(
        msg.contains("version mismatch"),
        "error should mention version mismatch, got: {msg}"
    );
}

// ---------------------------------------------------------------------------
// 5. JSON serialization round-trip
// ---------------------------------------------------------------------------

#[test]
fn json_round_trip_preserves_bytecode() {
    let mut bc = Bytecode::new();
    bc.add_constant(Value16::number(42.0));
    bc.add_constant(Value16::boolean(false));
    bc.instructions.push(Instruction::LoadConst(0));
    bc.instructions.push(Instruction::LoadConst(1));
    bc.instructions.push(Instruction::Add);

    let json = bc.to_json().expect("to_json should succeed");
    let bc2 = Bytecode::from_json(&json).expect("from_json should succeed");

    assert_eq!(bc2.version, BYTECODE_VERSION);
    assert_eq!(bc2.constants.len(), 2);
    assert_eq!(bc2.instructions.len(), 3);
}

// ---------------------------------------------------------------------------
// 6. Validation — happy path
// ---------------------------------------------------------------------------

#[test]
fn validate_accepts_valid_bytecode() {
    let mut bc = Bytecode::new();
    let idx = bc.add_constant(Value16::null());
    bc.instructions.push(Instruction::LoadConst(idx));
    bc.instructions.push(Instruction::Jump(1)); // target within bounds (len=2, max allowed=2)
    assert!(bc.validate().is_ok());
}

// ---------------------------------------------------------------------------
// 7. Validation — bad jump target
// ---------------------------------------------------------------------------

#[test]
fn validate_rejects_out_of_bounds_jump() {
    let mut bc = Bytecode::new();
    bc.instructions.push(Instruction::Jump(999));
    let result = bc.validate();
    assert!(result.is_err());
}

// ---------------------------------------------------------------------------
// 8. Validation — bad LoadConst index
// ---------------------------------------------------------------------------

#[test]
fn validate_rejects_out_of_bounds_load_const() {
    let mut bc = Bytecode::new();
    // Pool is empty, index 0 is already out of bounds
    bc.instructions.push(Instruction::LoadConst(0));
    let result = bc.validate();
    assert!(result.is_err());
}

// ---------------------------------------------------------------------------
// 9. Validation — function chunk
// ---------------------------------------------------------------------------

#[test]
fn validate_checks_function_chunks() {
    let mut bc = Bytecode::new();
    // Main body is fine (empty)
    // But the function chunk has an invalid jump
    let bad_chunk = FunctionChunk {
        params: vec!["x".into()],
        instructions: vec![Instruction::JumpIfFalse(500)],
        constants: vec![],
        captures: vec![],
        is_async: false,
        is_generator: false,
        local_count: 1,
        local_names: vec!["x".into()],
        capture_cells: vec![],
        source_positions: vec![],
    };
    bc.functions.insert("bad_fn".into(), Arc::new(bad_chunk));
    let result = bc.validate();
    assert!(result.is_err());
}

// ---------------------------------------------------------------------------
// 10. FunctionChunk serde defaults
// ---------------------------------------------------------------------------

#[test]
fn function_chunk_serde_defaults_for_optional_fields() {
    // Serialize a chunk without captures/is_async/is_generator,
    // then deserialize — defaults should kick in.
    let json = r#"{
        "params": ["a", "b"],
        "instructions": [],
        "constants": []
    }"#;
    let chunk: FunctionChunk = serde_json::from_str(json).expect("should deserialize");
    assert_eq!(chunk.params, vec!["a", "b"]);
    assert!(
        chunk.captures.is_empty(),
        "captures should default to empty"
    );
    assert!(!chunk.is_async, "is_async should default to false");
    assert!(!chunk.is_generator, "is_generator should default to false");
}

// ---------------------------------------------------------------------------
// 11. Value variant coverage — Debug trait
// ---------------------------------------------------------------------------

#[test]
fn value_variants_are_debug_printable() {
    // Ensures that Debug is derived for all variants without panicking
    let values: Vec<Value16> = vec![
        Value16::null(),
        Value16::boolean(true),
        Value16::number(f64::NAN),
        Value16::string("hi"),
        Value16::array(vec![Value16::null()]),
        Value16::object(HashMap::from([("k".into(), Value16::number(1.0))])),
        Value16::promise(PromiseState16::Pending),
        Value16::promise(PromiseState16::Resolved(Box::new(Value16::number(1.0)))),
        Value16::promise(PromiseState16::Rejected("err".into())),
        Value16::promise(PromiseState16::AsyncPending("uuid-123".into())),
        Value16::option(None),
        Value16::option(Some(Value16::null())),
        Value16::result(Ok(Value16::boolean(false))),
        Value16::result(Err("oops".into())),
        Value16::set(vec![Value16::number(1.0), Value16::number(2.0)]),
        Value16::map(vec![(Value16::string("k"), Value16::number(1.0))]),
        Value16::generator(std::sync::Arc::new(parking_lot::Mutex::new(
            hudhudscript_bytecode::GeneratorState16::from(vec![]),
        ))),
        Value16::tool(hudhudscript_bytecode::ToolRef {
            server: "s".into(),
            tool_name: "t".into(),
        }),
        Value16::resource(hudhudscript_bytecode::ResourceRef {
            server: "s".into(),
            uri: "u".into(),
        }),
        Value16::data(hudhudscript_bytecode::DataData {
            type_name: "Point".into(),
            fields: HashMap::new(),
        }),
    ];
    for v in &values {
        let dbg = format!("{:?}", v);
        assert!(!dbg.is_empty(), "Debug output should be non-empty");
    }
}

// ---------------------------------------------------------------------------
// 12. Error types — Display and position helper
// ---------------------------------------------------------------------------

#[test]
fn compile_error_display_and_source_position() {
    // v0.4.48 TAM CONSOLIDATION: CompileError is now a type alias for the
    // unified hudhudscript_errors::Error.
    let pos = SourcePosition::new(10, 3);
    assert_eq!(pos.line, 10);
    assert_eq!(pos.column, 3);
    assert_eq!(format!("{}", pos), "10:3");

    let err = compile_codes::generic_at("bad thing", pos);
    let display = format!("{}", err);
    assert!(
        display.contains("bad thing"),
        "Display should contain the message"
    );
}

#[test]
fn compile_error_variants_display() {
    let cases: Vec<CompileError> = vec![
        compile_codes::generic("generic msg"),
        compile_codes::unsupported_feature("feat"),
        compile_codes::unsupported_feature_at("feat", SourcePosition { line: 1, column: 1 }),
        compile_codes::invalid_bytecode("bad"),
        compile_codes::invalid_bytecode_at("bad", SourcePosition { line: 2, column: 5 }),
        compile_codes::runtime_error("boom"),
        compile_codes::runtime_error_at("boom", SourcePosition { line: 3, column: 7 }),
    ];
    for err in &cases {
        let s = format!("{}", err);
        assert!(!s.is_empty());
        // catalog short code should be present
        assert!(
            s.contains("E0"),
            "Display should contain catalog code: {}",
            s
        );
    }
}

// ---------------------------------------------------------------------------
// 14. NaN deduplication in constant pool (bit-level equality)
// ---------------------------------------------------------------------------

#[test]
fn nan_constants_are_deduplicated() {
    let mut bc = Bytecode::new();
    let i0 = bc.add_constant(Value16::number(f64::NAN));
    let i1 = bc.add_constant(Value16::number(f64::NAN));
    assert_eq!(i0, i1, "NaN values with same bits should be deduplicated");
    assert_eq!(bc.constants.len(), 1);
}

// ---------------------------------------------------------------------------
// 15. Instruction enum Clone + Serialize coverage
// ---------------------------------------------------------------------------

#[test]
fn instruction_variants_serialize_deserialize() {
    let instructions: Vec<Instruction> = vec![
        Instruction::LoadConst(0),
        Instruction::LoadVar(intern("x").0),
        Instruction::StoreVar(intern("y").0),
        Instruction::StoreConst(intern("z").0),
        Instruction::StoreTyped(0),
        Instruction::Add,
        Instruction::Sub,
        Instruction::Mul,
        Instruction::Div,
        Instruction::Mod,
        Instruction::Eq,
        Instruction::Ne,
        Instruction::Lt,
        Instruction::Le,
        Instruction::Gt,
        Instruction::Ge,
        Instruction::And,
        Instruction::Or,
        Instruction::Not,
        Instruction::Neg,
        Instruction::MakeArray(3),
        Instruction::MakeObject(2),
        Instruction::Index,
        Instruction::Jump(10),
        Instruction::JumpIfFalse(5),
        Instruction::JumpIfTrue(7),
        Instruction::Call(0),
        Instruction::Return,
        Instruction::PushScope,
        Instruction::PopScope,
        Instruction::Print,
        Instruction::Pop,
        Instruction::Break,
        Instruction::Continue,
        Instruction::ForIn(SymId(intern("item").0)),
        Instruction::IterNext(20),
        Instruction::PushTry(15),
        Instruction::PopTry,
        Instruction::Throw,
        Instruction::Await,
        Instruction::Yield,
        Instruction::GetProperty(SymId(intern("field").0)),
        Instruction::SetProperty(SymId(intern("field").0)),
        Instruction::MethodCall(0),
        Instruction::ClassDecl(0),
        Instruction::NewInstance(0),
        Instruction::SuperCall(0),
        Instruction::GetStatic(0),
        Instruction::ClassStaticDecl(0),
        Instruction::MakeGenerator(0),
        Instruction::DestructArray(3, true),
        Instruction::DestructObject(0),
        Instruction::EnumDecl(0),
        Instruction::MatchVariant(0),
        Instruction::BindVar(SymId(intern("val").0)),
        Instruction::DeclStore(0),
        Instruction::Spawn(0),
        Instruction::Send,
        Instruction::Receive(SymId(intern("msg").0)),
        Instruction::Require,
        Instruction::Perform,
        Instruction::Remember(0),
        Instruction::Recall(0),
        Instruction::Forget(0),
        Instruction::LoadModule(0),
        Instruction::DefineFunction(0),
    ];

    // Round-trip each instruction through JSON
    for (i, instr) in instructions.iter().enumerate() {
        let json = serde_json::to_string(instr)
            .unwrap_or_else(|e| panic!("Instruction #{i} failed to serialize: {e}"));
        let back: Instruction = serde_json::from_str(&json)
            .unwrap_or_else(|e| panic!("Instruction #{i} failed to deserialize: {e}"));
        let json2 = serde_json::to_string(&back).unwrap();
        assert_eq!(json, json2, "Instruction #{i} round-trip mismatch");
    }
}
