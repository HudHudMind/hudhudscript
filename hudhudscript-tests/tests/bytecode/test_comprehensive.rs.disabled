#[test] fn instr_spawn() { let _ = Instruction::Spawn(0); }
#[test] fn instr_send() { let _ = Instruction::Send; }
#[test] fn instr_receive() { let _ = Instruction::Receive(SymId(5)); }
#[test] fn instr_require() { let _ = Instruction::Require; }
#[test] fn instr_perform() { let _ = Instruction::Perform; }
#[test] fn instr_remember() { let _ = Instruction::Remember(0); }
#[test] fn instr_recall() { let _ = Instruction::Recall(0); }
#[test] fn instr_forget() { let _ = Instruction::Forget(0); }
#[test] fn instr_decl_store() { let _ = Instruction::DeclStore(0); }
#[test] fn instr_new_instance() { let _ = Instruction::NewInstance(0); }
#[test] fn instr_trait_check() { let _ = Instruction::TraitCheck(0); }
#[test] fn instr_get_property() { let _ = Instruction::GetProperty(SymId(intern("prop").0)); }
#[test] fn instr_set_property() { let _ = Instruction::SetProperty(SymId(intern("prop").0)); }
#[test] fn instr_enum_decl() { let mut bc = Bytecode::new(); let p = EnumDeclPayload { name: SymId(intern("E").0), variants: vec![] }; let idx = bc.add_enum_decl_payload(p); let _ = Instruction::EnumDecl(idx); }
#[test] fn instr_match_variant() { let mut bc = Bytecode::new(); let a = bc.intern_symbol("E"); let b = bc.intern_symbol("V"); let p = bc.add_two_sym_payload(a, b); let _ = Instruction::MatchVariant(p); }
#[test] fn instr_for_in() { let _ = Instruction::ForIn(SymId(intern("iter").0)); }
#[test] fn instr_iter_next() { let _ = Instruction::IterNext(10); }
#[test] fn instr_store_const() { let _ = Instruction::StoreConst(0); }
#[test] fn instr_store_typed() { let _ = Instruction::StoreTyped(0); }

// ═══════════════════════════════════════════════════════════════════════════
// Serialization (via serde)
// ═══════════════════════════════════════════════════════════════════════════

#[test] fn bc_serde_empty() { let bc = Bytecode::new(); let json = serde_json::to_string(&bc).unwrap(); let bc2: Bytecode = serde_json::from_str(&json).unwrap(); assert_eq!(bc2.instructions.len(), 0); }
#[test] fn bc_serde_with_instr() { let mut bc = Bytecode::new(); bc.constants.push(Value16::number(1.0)); bc.instructions.push(Instruction::LoadConst(0)); bc.instructions.push(Instruction::Return); let json = serde_json::to_string(&bc).unwrap(); let bc2: Bytecode = serde_json::from_str(&json).unwrap(); assert_eq!(bc2.instructions.len(), 2); }

// ═══════════════════════════════════════════════════════════════════════════
// Repr / ReprTag
// ═══════════════════════════════════════════════════════════════════════════

#[test] fn repr_tag_variants() { assert_ne!(ReprTag::Null as u8, ReprTag::Bool as u8); assert_ne!(ReprTag::Number as u8, ReprTag::Int as u8); }
#[test] fn repr_new() { let r = Repr(0); let _ = r.0; }

// ═══════════════════════════════════════════════════════════════════════════
// SourcePosition / DynamicData / DynamicObject / DynamicKind / PromiseState16
// ═══════════════════════════════════════════════════════════════════════════

#[test] fn source_pos() { let p = SourcePosition::new(10, 5); assert_eq!(p.line, 10); assert_eq!(p.column, 5); }
#[test] fn dynamic_string() { let d = DynamicData::String("hello".to_string()); assert!(matches!(d, DynamicData::String(_))); }
#[test] fn dynamic_array() { let d = DynamicData::Array(vec![Value16::number(1.0)]); assert!(matches!(d, DynamicData::Array(_))); }
#[test] fn dynamic_object() { let d = DynamicData::Object(HashMap::new()); assert!(matches!(d, DynamicData::Object(_))); }
#[test] fn dynamic_obj() { let _obj = DynamicObject { kind: DynamicKind::Object, data: DynamicData::String("x".into()) }; }
#[test] fn dynamic_kind() { let _k = DynamicKind::Object; let _a = DynamicKind::Array; }

// ═══════════════════════════════════════════════════════════════════════════
// End of file — compile-only tests for remaining types
