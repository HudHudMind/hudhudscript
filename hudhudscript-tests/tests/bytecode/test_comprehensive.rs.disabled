#![cfg(feature = "stack-vm-legacy")]
#![cfg(feature = "stack-vm-legacy")]
//! Comprehensive bytecode coverage tests
//! Covers: Value16, Instruction variants, Bytecode, SymId, Repr, DynamicData

use hudhudscript_bytecode::*;
use hudhudscript_shared_builtins::interner::intern;
use std::collections::HashMap;

// ═══════════════════════════════════════════════════════════════════════════
// Value16 construction — all types
// ═══════════════════════════════════════════════════════════════════════════

#[test] fn v16_null() { let v = Value16::null(); assert!(v.is_null()); }
#[test] fn v16_bool_true() { let v = Value16::bool_(true); assert!(v.is_bool()); assert_eq!(v.as_bool(), Some(true)); }
#[test] fn v16_bool_false() { let v = Value16::bool_(false); assert!(!v.as_bool().unwrap()); }
#[test] fn v16_number_int() { let v = Value16::number(42.0); assert!(v.is_number()); assert_eq!(v.as_number(), Some(42.0)); }
#[test] fn v16_number_neg() { let v = Value16::number(-3.14); assert_eq!(v.as_number(), Some(-3.14)); }
#[test] fn v16_number_zero() { let v = Value16::number(0.0); assert_eq!(v.as_number(), Some(0.0)); }
#[test] fn v16_string_empty() { let v = Value16::string(""); assert_eq!(v.as_str(), Some("")); }
#[test] fn v16_string_unicode() { let v = Value16::string("merhaba dünya"); assert!(v.as_str().unwrap().contains("dünya")); }
#[test] fn v16_string_turkish() { let v = Value16::string("değişken"); assert_eq!(v.as_str(), Some("değişken")); }
#[test] fn v16_object_empty() { let v = Value16::object(HashMap::new()); assert!(v.is_object()); }
#[test] fn v16_object_fields() { let mut m = HashMap::new(); m.insert("name".to_string(), Value16::string("Ali")); let v = Value16::object(m); assert!(v.is_object()); }
#[test] fn v16_array_empty() { let v = Value16::array(vec![]); assert!(v.is_array()); }
#[test] fn v16_array_numbers() { let v = Value16::array(vec![Value16::number(1.0), Value16::number(2.0)]); assert!(v.is_array()); }
#[test] fn v16_array_mixed() { let v = Value16::array(vec![Value16::string("x"), Value16::number(1.0), Value16::bool_(true)]); assert!(v.is_array()); }
#[test] fn v16_clone() { let v1 = Value16::number(42.0); let v2 = v1.clone(); assert_eq!(v1.as_number(), v2.as_number()); }
#[test] fn v16_type_name() { assert!(Value16::null().type_name_str().contains("null")); assert!(Value16::string("x").type_name_str().contains("string")); }
#[test] fn v16_display() { let v = Value16::number(3.14); assert!(format!("{}", v).contains("3.14")); }

// ═══════════════════════════════════════════════════════════════════════════
// SymId
// ═══════════════════════════════════════════════════════════════════════════

#[test] fn symid_intern() { let id = SymId(intern("hello").0); let id2 = SymId(intern("hello").0); assert_eq!(id.0, id2.0); }
#[test] fn symid_different() { let a = SymId(intern("foo").0); let b = SymId(intern("bar").0); assert_ne!(a.0, b.0); }

// ═══════════════════════════════════════════════════════════════════════════
// Bytecode construction
// ═══════════════════════════════════════════════════════════════════════════

#[test] fn bc_new_empty() { let bc = Bytecode::new(); assert!(bc.instructions.is_empty()); }
#[test] fn bc_push_instr() { let mut bc = Bytecode::new(); bc.instructions.push(Instruction::Return); assert_eq!(bc.instructions.len(), 1); }
#[test] fn bc_constants_push() { let mut bc = Bytecode::new(); bc.constants.push(Value16::number(42.0)); assert_eq!(bc.constants.len(), 1); }
#[test] fn bc_intern_symbol() { let mut bc = Bytecode::new(); let id1 = bc.intern_symbol("myVar"); let id2 = bc.intern_symbol("myVar"); assert_eq!(id1, id2); }
#[test] fn bc_intern_different() { let mut bc = Bytecode::new(); let a = bc.intern_symbol("a"); let b = bc.intern_symbol("b"); assert_ne!(a, b); }
#[test] fn bc_call_payload() { let mut bc = Bytecode::new(); let sym = SymId(intern("f").0); let payload = bc.add_call_payload(sym, 3); let _ = Instruction::Call(payload); }
#[test] fn bc_opt_sym_some() { let mut bc = Bytecode::new(); let sym = SymId(intern("x").0); let p = bc.add_opt_sym_payload(Some(sym)); let _ = Instruction::LoadVar(p); }
#[test] fn bc_opt_sym_none() { let mut bc = Bytecode::new(); let p = bc.add_opt_sym_payload(None); let _ = Instruction::LoadVar(p); }
#[test] fn bc_two_sym() { let mut bc = Bytecode::new(); let a = bc.intern_symbol("A"); let b = bc.intern_symbol("B"); let p = bc.add_two_sym_payload(a, b); let _ = Instruction::MatchVariant(p); }
#[test] fn bc_enum_decl() { let mut bc = Bytecode::new(); let p = EnumDeclPayload { name: SymId(intern("Color").0), variants: vec![SymId(intern("Red").0)] }; let idx = bc.add_enum_decl_payload(p); let _ = Instruction::EnumDecl(idx); }
#[test] fn bc_class_decl() { let mut bc = Bytecode::new(); let p = ClassDeclPayload { name: SymId(intern("Point").0), parent: None, methods: vec![] }; let idx = bc.add_class_decl_payload(p); let _ = Instruction::ClassDecl(idx); }
#[test] fn bc_class_decl_parent() { let mut bc = Bytecode::new(); let p = ClassDeclPayload { name: SymId(intern("Dog").0), parent: Some(SymId(intern("Animal").0)), methods: vec![SymId(intern("speak").0)] }; let idx = bc.add_class_decl_payload(p); let _ = Instruction::ClassDecl(idx); }

