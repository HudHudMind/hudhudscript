#[test]
fn test_e2e_multiple_providers_coexist() {
    let source = r#"
        provider p_openai {
            type: "openai",
            model: "gpt-4"
        }
        provider p_anthropic {
            type: "anthropic",
            model: "claude-3-haiku"
        }
        provider p_ollama {
            type: "ollama",
            model: "mistral"
        }
    "#;

    let interp = run(source);
    assert!(interp.get_variable("p_openai").is_ok(), "p_openai missing");
    assert!(
        interp.get_variable("p_anthropic").is_ok(),
        "p_anthropic missing"
    );
    assert!(interp.get_variable("p_ollama").is_ok(), "p_ollama missing");
}

#[test]
fn test_e2e_provider_with_nested_budget() {
    let source = r#"
        provider budget_provider {
            type: "openai",
            model: "gpt-4",
            token_budget: {
                daily_limit: 50000,
                monthly_limit: 500000
            }
        }
    "#;

    let interp = run(source);
    let val = interp
        .get_variable("budget_provider")
        .expect("provider not found");

    match val {
        Value16::object(obj) => match obj.get("token_budget") {
            Some(Value16::object(budget)) => {
                assert_eq!(budget.get("daily_limit"), Some(&Value16::number(50000.0)));
                assert_eq!(budget.get("monthly_limit"), Some(&Value16::number(500000.0)));
            }
            other => panic!("Expected Object for token_budget, got {other:?}"),
        },
        other => panic!("Expected Object, got {other:?}"),
    }
}

