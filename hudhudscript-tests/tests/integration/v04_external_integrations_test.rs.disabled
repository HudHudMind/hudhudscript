// ── Full governance workflow ─────────────────────────────────────────────────

#[test]
fn test_e2e_governance_full_workflow() {
    // Declare constitution → law → council → swarm; verify all are accessible
    let source = r#"
        constitution OrgPolicy {
            description: "Organizational governance",
            laws: [
                {
                    name: "Access Control",
                    description: "Restrict system access",
                    enforcement: mandatory,
                    rules: ["rule.ac.1"]
                },
                {
                    name: "Data Retention",
                    description: "Limit data storage duration",
                    enforcement: advisory,
                    rules: []
                }
            ]
        }

        law AuditRequirement {
            description: "All operations must be logged",
            enforcement: mandatory,
            rules: ["rule.audit.1"]
        }

        council ComplianceCouncil {
            constitution: "OrgPolicy",
            members: [
                { agent: "ciso", role: "Judge" },
                { agent: "cto", role: "Executor" }
            ],
            rules: ["rule.ac.1", "rule.audit.1"]
        }

        swarm WorkerSwarm {
            agents: ["WorkerAgent", "WorkerAgent"],
            strategy: parallel
        }
    "#;

    let interp = run(source);

    assert!(
        interp.get_variable("OrgPolicy").is_ok(),
        "OrgPolicy missing"
    );
    assert!(
        interp.get_variable("AuditRequirement").is_ok(),
        "AuditRequirement missing"
    );
    assert!(
        interp.get_variable("ComplianceCouncil").is_ok(),
        "ComplianceCouncil missing"
    );
    assert!(
        interp.get_variable("WorkerSwarm").is_ok(),
        "WorkerSwarm missing"
    );

    // Verify constitution has correct law count
    let policy = interp.get_variable("OrgPolicy").unwrap();
    if let Value16::object(obj) = policy {
        if let Some(Value16::array(laws)) = obj.get("laws") {
            assert_eq!(laws.len(), 2, "Expected 2 laws");
        }
    }

    // Verify council has correct member count
    let council = interp.get_variable("ComplianceCouncil").unwrap();
    if let Value16::object(obj) = council {
        if let Some(Value16::array(members)) = obj.get("members") {
            assert_eq!(members.len(), 2, "Expected 2 council members");
        }
    }
}

// ── Arithmetic pipeline (end-to-end variable + loop + function) ──────────────

#[test]
fn test_e2e_arithmetic_pipeline() {
    // Fibonacci via iteration — verifies variable declarations, while loops,
    // arithmetic operations, and assignment all work end-to-end.
    let source = r#"
        let a = 0;
        let b = 1;
        let steps = 0;

        while (steps < 8) {
            let tmp = a + b;
            a = b;
            b = tmp;
            steps = steps + 1;
        }
    "#;

    let interp = run(source);

    // After 8 Fibonacci iterations starting at (0,1) the pair (a, b) = (21, 34)
    let a_val = interp.get_variable("a").expect("a not found");
    let b_val = interp.get_variable("b").expect("b not found");

    assert_eq!(a_val, Value16::number(21.0), "a should be 21");
    assert_eq!(b_val, Value16::number(34.0), "b should be 34");
}

#[test]
fn test_e2e_string_concatenation_pipeline() {
    let source = r#"
        let parts = ["Hello", ", ", "World", "!"];
        let result = "";
        let idx = 0;

        while (idx < 4) {
            result = result + parts[idx];
            idx = idx + 1;
        }
    "#;

    let interp = run(source);
    let result = interp.get_variable("result").expect("result not found");
    assert_eq!(result, Value16::string("Hello, World!".into()));
}

#[test]
fn test_e2e_object_manipulation() {
    let source = r#"
        let config = {
            host: "localhost",
            port: 8080,
            debug: true
        };

        let host_val = config.host;
        let port_val = config.port;
    "#;

    let interp = run(source);

    let host = interp.get_variable("host_val").expect("host_val not found");
    assert_eq!(host, Value16::string("localhost".into()));

    let port = interp.get_variable("port_val").expect("port_val not found");
    assert_eq!(port, Value16::number(8080.0));
}

