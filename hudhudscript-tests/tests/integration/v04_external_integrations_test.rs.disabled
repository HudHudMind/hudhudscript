// ── MCP call syntax tests ────────────────────────────────────────────────────

/// `mcp.call(server, tool, args)` parses without error.
#[test]
fn test_e2e_mcp_call_syntax_parses() {
    let source = r#"
        let result = mcp.call("sqlite", "query", {
            sql: "SELECT * FROM users"
        });
    "#;

    // We only check that parsing succeeds; the runtime will error because no
    // MCP server is registered, but the syntax is valid.
    let parse_result = parse(source);
    assert!(
        parse_result.is_ok(),
        "mcp.call() should parse: {:?}",
        parse_result.err()
    );
}

/// `mcp.call()` without a registered server should yield a runtime error
/// (not a parse error).
#[test]
fn test_e2e_mcp_call_no_server_gives_runtime_error() {
    let source = r#"
        let result = mcp.call("nonexistent_server", "tool", {});
    "#;

    let result = try_run(source);
    assert!(
        result.is_err(),
        "Should error when server is not registered"
    );
    let err_msg = format!("{:?}", result.err().unwrap());
    assert!(
        err_msg.contains("not found") || err_msg.contains("MCP") || err_msg.contains("server"),
        "Error should mention missing server: {err_msg}"
    );
}

/// Wrong argument count to `mcp.call()` should produce a runtime error.
#[test]
fn test_e2e_mcp_call_wrong_arg_count() {
    let source = r#"
        let result = mcp.call("server_only");
    "#;

    let result = try_run(source);
    assert!(result.is_err(), "Should fail with wrong argument count");
}

/// Wrong argument type (number instead of string server name) should error.
#[test]
fn test_e2e_mcp_call_wrong_arg_type() {
    let source = r#"
        let result = mcp.call(42, "tool", {});
    "#;

    let result = try_run(source);
    assert!(result.is_err(), "Should fail with wrong argument type");
}

/// `mcp.call()` inside try/catch should allow graceful error handling.
#[test]
fn test_e2e_mcp_call_inside_try_catch() {
    let source = r#"
        let caught = false;
        try {
            let data = mcp.call("no_such_server", "tool", {});
        } catch (err) {
            caught = true;
        }
    "#;

    let interp = run(source);
    let caught = interp.get_variable("caught").expect("caught not found");
    assert_eq!(
        caught,
        Value16::boolean(true),
        "try/catch should have caught the MCP error"
    );
}

