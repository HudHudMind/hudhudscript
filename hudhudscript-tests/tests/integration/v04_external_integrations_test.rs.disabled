#[test]
#[ignore = "tool_decl removed from grammar (#489)"]
fn test_e2e_provider_agent_tool_combined() {
    // Full integration: provider + tool + agent in one program
    let source = r#"
        provider main_llm {
            type: "openai",
            model: "gpt-4",
            api_key: "sk-test",
            max_tokens: 2048
        }

        tool file_tool {
            server: "filesystem",
            name: "read_file"
        }

        agent PipelineBot {
            provider: "main_llm",
            model: "gpt-4",
            temperature: 0.3
        }

        let config = {
            agent: "PipelineBot",
            tool: "file_tool",
            provider: "main_llm"
        };
    "#;

    let interp = run(source);
    assert!(interp.get_variable("main_llm").is_ok());
    assert!(interp.get_variable("file_tool").is_ok());
    assert!(interp.get_variable("PipelineBot").is_ok());

    let config = interp.get_variable("config").expect("config not found");
    match config {
        Value16::object(obj) => {
            assert_eq!(obj.get("provider"), Some(&Value16::string("main_llm".into())));
            assert_eq!(obj.get("agent"), Some(&Value16::string("PipelineBot".into())));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

// ── env.KEY member access tests (Issue #24) ─────────────────────────────────

#[test]
fn test_e2e_env_function_call_syntax() {
    std::env::set_var("_HUDHUD_E2E_FN_", "fn_value");
    let interp = run(r#"let v = env("_HUDHUD_E2E_FN_");"#);
    let val = interp.get_variable("v").expect("v not found");
    assert_eq!(val, Value16::string("fn_value".into()));
    std::env::remove_var("_HUDHUD_E2E_FN_");
}

#[test]
fn test_e2e_env_dot_member_access_syntax() {
    std::env::set_var("_HUDHUD_E2E_DOT_", "dot_value");
    let interp = run(r#"let v = env._HUDHUD_E2E_DOT_;"#);
    let val = interp.get_variable("v").expect("v not found");
    assert_eq!(val, Value16::string("dot_value".into()));
    std::env::remove_var("_HUDHUD_E2E_DOT_");
}

#[test]
fn test_e2e_env_missing_returns_empty() {
    let interp = run(r#"let v = env._HUDHUD_NONEXISTENT_E2E_;"#);
    let val = interp.get_variable("v").expect("v not found");
    assert_eq!(val, Value16::string(String::new()));
}

// ── Sandbox enforcement tests (Issue #33) ───────────────────────────────────
// `test_e2e_sandbox_blocks_mcp_call` was deleted during interpreter-crate
// retirement — it relied on `Interpreter::with_sandbox`, an interpreter-only
// constructor that was never ported to the VM path.  Sandbox enforcement for
// MCP calls is now exercised through `tests/sandbox/integration_tests.rs`
// (capability-layer) and the VM `with_sandbox` fluent API in
// `tests/vm/coverage_test.rs`.

// ── ToolRegistry integration tests (Issue #23) ─────────────────────────────
// `test_e2e_tool_registry_can_be_set` and `test_e2e_standard_tools_registered_in_registry`
// (below, line ~949) were deleted: `Interpreter::{set_tool_registry, tool_registry}`
// were interpreter-only fields used to splice an external ToolRegistry into
// the interpreter environment.  The VM does not keep a ToolRegistry handle;
// tool dispatch runs through the shared `call_X_method` dispatchers directly.

// ── SOP: Subject declaration tests (Issue #164-#169) ─────────────────────

#[test]
fn test_e2e_subject_declaration_basic() {
    let interp = run(r#"
        subject Player {
            state health: 100
            state stamina: 50
            can attack
            can move
        }
    "#);
    let val = interp.get_variable("Player").expect("Player not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("name"), Some(&Value16::string("Player".into())));
            assert_eq!(obj.get("__type"), Some(&Value16::string("subject".into())));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_e2e_subject_with_roles() {
    let interp = run(r#"
        subject CaravanLeader has Trader, Fighter {
            state courage: 55
        }
    "#);
    let val = interp
        .get_variable("CaravanLeader")
        .expect("CaravanLeader not found");
    match val {
        Value16::object(obj) => match obj.get("roles") {
            Some(Value16::array(roles)) => {
                assert_eq!(roles.len(), 2);
                assert_eq!(roles[0], Value16::string("Trader".into()));
                assert_eq!(roles[1], Value16::string("Fighter".into()));
            }
            other => panic!("Expected roles array, got {other:?}"),
        },
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_e2e_relation_declaration() {
    let interp = run(r#"
        relation Player <-> Merchant {
            trust: 15
            debt: 30
        }
    "#);
    let val = interp
        .get_variable("Player_Merchant")
        .expect("relation not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("__type"), Some(&Value16::string("relation".into())));
            assert_eq!(obj.get("subject_a"), Some(&Value16::string("Player".into())));
            assert_eq!(
                obj.get("subject_b"),
                Some(&Value16::string("Merchant".into()))
            );
            assert_eq!(obj.get("trust"), Some(&Value16::number(15.0)));
            assert_eq!(obj.get("debt"), Some(&Value16::number(30.0)));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_e2e_subject_uses_via() {
    let interp = run(r#"
        subject AIAssistant {
            uses gpt4 via api
            state ready: true
        }
    "#);
    let val = interp
        .get_variable("AIAssistant")
        .expect("AIAssistant not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("__type"), Some(&Value16::string("subject".into())));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_e2e_multiple_subjects_coexist() {
    let interp = run(r#"
        subject Guard {
            state alertness: 30
            can patrol
        }
        subject Thief {
            state stealth: 80
            can steal
        }
    "#);
    assert!(interp.get_variable("Guard").is_ok());
    assert!(interp.get_variable("Thief").is_ok());
}

// `test_e2e_standard_tools_registered_in_registry` — see upstream note
// (interpreter-only `set_tool_registry`/`tool_registry` accessors; the count
// portion is preserved below as `test_e2e_standard_tools_count`).

#[test]
fn test_e2e_standard_tools_count() {
    use hudhudscript_tools::{register_standard_tools, ToolRegistry};

    let registry = ToolRegistry::new();
    let count = register_standard_tools(&registry).unwrap();
    // 6 core (file_read, http_get/post/put/delete, json_parse) + 2 db + 6 git = 14
    assert_eq!(count, 8); // git tools moved to tools-vcs
}

