// ── Governance tests ─────────────────────────────────────────────────────────

#[test]
fn test_e2e_constitution_declaration_and_query() {
    let source = r#"
        constitution DataPolicy {
            description: "Data handling governance",
            laws: [
                {
                    name: "Privacy Law",
                    description: "Protect personal data",
                    enforcement: mandatory,
                    rules: ["rule.privacy.1"]
                }
            ]
        }
    "#;

    let interp = run(source);
    let val = interp
        .get_variable("DataPolicy")
        .expect("constitution not found");

    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("name"), Some(&Value16::string("DataPolicy".into())));
            assert_eq!(
                obj.get("description"),
                Some(&Value16::string("Data handling governance".into()))
            );
            match obj.get("laws") {
                Some(Value16::array(laws)) => assert_eq!(laws.len(), 1),
                other => panic!("Expected Array for laws, got {other:?}"),
            }
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

