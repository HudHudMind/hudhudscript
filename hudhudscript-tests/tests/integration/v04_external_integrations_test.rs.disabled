#[test]
fn test_e2e_agent_with_provider_field() {
    // Declare a provider and an agent that references it by name
    let source = r#"
        provider my_llm {
            type: "openai",
            model: "gpt-4"
        }

        agent SmartAgent {
            provider: "my_llm",
            model: "gpt-4",
            temperature: 0.5
        }
    "#;

    let interp = run(source);
    assert!(interp.get_variable("my_llm").is_ok(), "provider not found");
    assert!(interp.get_variable("SmartAgent").is_ok(), "agent not found");

    let agent_val = interp.get_variable("SmartAgent").unwrap();
    match agent_val {
        Value16::object(obj) => {
            assert_eq!(obj.get("provider"), Some(&Value16::string("my_llm".into())));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

