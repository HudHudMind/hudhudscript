//! Issue #26 — v0.4 External Integrations: end-to-end integration tests
//!
//! These tests exercise the full pipeline:
//!   parse source → build AST → interpret → verify output / environment state
//!
//! Coverage:
//!   • Provider declaration (English + Turkish + Japanese)
//!   • Tool declaration (object-style)
//!   • Agent declaration with an attached provider
//!   • MCP server declaration
//!   • MCP tool binding
//!   • Resource declaration
//!   • Council with governance laws enforced
//!   • Swarm declaration
//!   • End-to-end arithmetic pipeline that exercises variables, loops, and functions

use hudhud_script_tests::vm_interpreter::Interpreter;
use hudhudscript_bytecode::Value16;
use hudhud_script_tests::vm_interpreter::runtime_codes;
use hudhudscript_parser::parse;

// ── helpers ─────────────────────────────────────────────────────────────────

/// Parse and execute `source`, returning the interpreter so callers can
/// inspect the resulting environment.
fn run(source: &str) -> Interpreter {
    let ast = parse(source).unwrap_or_else(|e| panic!("Parse error:\n{e}"));
    let mut interpreter = Interpreter::new();
    interpreter
        .execute(&ast)
        .unwrap_or_else(|e| panic!("Runtime error:\n{e:?}"));
    interpreter
}

/// Parse and execute, returning `Err` if interpretation fails.
fn try_run(source: &str) -> Result<Interpreter, hudhud_script_tests::vm_interpreter::RuntimeError> {
    let ast = parse(source)
        .map_err(|e| hudhud_script_tests::vm_interpreter::runtime_codes::custom(format!("Parse error: {e}")))?;
    let mut interpreter = Interpreter::new();
    interpreter.execute(&ast)?;
    Ok(interpreter)
}

// ── Provider declaration tests ───────────────────────────────────────────────

#[test]
fn test_e2e_provider_declaration_english() {
    let source = r#"
        provider openai_gpt4 {
            type: "openai",
            model: "gpt-4",
            api_key: "sk-test",
            max_tokens: 4096
        }
    "#;

    let interp = run(source);
    let val = interp
        .get_variable("openai_gpt4")
        .expect("provider not found");

    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("type"), Some(&Value16::string("openai".into())));
            assert_eq!(obj.get("model"), Some(&Value16::string("gpt-4".into())));
            assert_eq!(obj.get("max_tokens"), Some(&Value16::number(4096.0)));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

