#[test]
fn test_e2e_mixed_turkish_english_declarations() {
    // Turkish provider + English agent referencing it
    let source = r#"
        sağlayıcı tr_provider {
            type: "openai",
            model: "gpt-4"
        }

        agent EnglishAgent {
            provider: "tr_provider",
            model: "gpt-4"
