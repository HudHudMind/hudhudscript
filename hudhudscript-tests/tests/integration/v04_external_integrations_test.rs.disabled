    let interp = run(r#"
        relation A <-> B {
            trust: 50
        }
    "#);
    let val = interp.get_variable("A_B").expect("A_B relation not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("__type"), Some(&Value16::string("relation".into())));
            assert_eq!(obj.get("subject_a"), Some(&Value16::string("A".into())));
            assert_eq!(obj.get("subject_b"), Some(&Value16::string("B".into())));
            assert_eq!(obj.get("trust"), Some(&Value16::number(50.0)));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

