#[test]
fn test_sop_multiple_relations() {
    // Multiple relations coexist
    let interp = run(r#"
        relation X <-> Y { trust: 10 }
        relation Y <-> Z { trust: 20 }
    "#);
    assert!(interp.get_variable("X_Y").is_ok(), "X_Y not found");
    assert!(interp.get_variable("Y_Z").is_ok(), "Y_Z not found");
}

#[test]
fn test_sop_spawn_subject_statement() {
    // `spawn Player;` as a statement should not error
    let result = try_run(
        r#"
        subject Player {
            state health: 100
        }
        spawn Player;
    "#,
    );
    assert!(
        result.is_ok(),
        "spawn should not error, got: {:?}",
        result.err()
    );
}

#[test]
fn test_sop_spawn_parses() {
    // spawn syntax parses correctly
    let parse_result = parse("spawn Enemy;");
    assert!(
        parse_result.is_ok(),
        "spawn should parse: {:?}",
        parse_result.err()
    );
}

#[test]
fn test_sop_spawn_with_args_parses() {
    // spawn with arguments parses
    let parse_result = parse("spawn Enemy(10, 20);");
    assert!(
        parse_result.is_ok(),
        "spawn with args should parse: {:?}",
        parse_result.err()
    );
}

// ── Issue #204: Protocol and messaging ───────────────────────────────────────

#[test]
fn test_sop_send_receive_parse() {
    // send/receive statements should parse without error
    let source = r#"send "hello" to target;"#;
    let parse_result = parse(source);
    assert!(
        parse_result.is_ok(),
        "send should parse: {:?}",
        parse_result.err()
    );

    let source2 = r#"receive msg from source;"#;
    let parse_result2 = parse(source2);
    assert!(
        parse_result2.is_ok(),
        "receive should parse: {:?}",
        parse_result2.err()
    );
}

#[test]
fn test_sop_send_executes() {
    // send with valid expressions should not panic at runtime
    let result = try_run(
        r#"
        let target = "agent1";
        send "ping" to target;
    "#,
    );
    assert!(
        result.is_ok(),
        "send should execute, got: {:?}",
        result.err()
    );
}

#[test]
fn test_sop_send_multiple_messages() {
    // Multiple send statements in sequence
    let result = try_run(
        r#"
        let target = "agent1";
        send "hello" to target;
        send "world" to target;
        send "done" to target;
    "#,
    );
    assert!(result.is_ok(), "multiple sends should execute");
}

#[test]
fn test_sop_receive_defines_variable() {
    // receive should define the variable (as Null for now since no message queue)
    let interp = run(r#"
        let source = "agent1";
        receive msg from source;
    "#);
    let val = interp.get_variable("msg").expect("msg should be defined");
    assert_eq!(val, Value16::null());
}

#[test]
fn test_sop_protocol_declaration() {
    // Protocol declaration uses colon syntax: `protocol Name: { ... }`
    let interp = run(r#"
        protocol Handshake: {
            execution: sequential,
            timeout: 30
        }
    "#);
    let val = interp
        .get_variable("Handshake")
        .expect("Handshake not found");
    match val {
        Value16::object(obj) => {
            // Protocol stores timeout and execution
            assert_eq!(obj.get("timeout"), Some(&Value16::number(30.0)));
            assert_eq!(
                obj.get("execution"),
                Some(&Value16::string("sequential".into()))
            );
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_sop_protocol_declaration_parallel() {
    // Protocol with parallel execution strategy
    let interp = run(r#"
        protocol Broadcast: {
            execution: parallel,
            timeout: 60
        }
    "#);
    let val = interp
        .get_variable("Broadcast")
        .expect("Broadcast not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(
                obj.get("execution"),
                Some(&Value16::string("parallel".into()))
            );
            assert_eq!(obj.get("timeout"), Some(&Value16::number(60.0)));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

// ── Issue #205: Backward compatibility ───────────────────────────────────────

#[test]
fn test_sop_backward_compat_agent() {
    // `agent X { model: "gpt-4" }` still works (Decl-style)
    let interp = run(r#"
        agent X {
            model: "gpt-4",
            temperature: 0.5
        }
    "#);
    let val = interp.get_variable("X").expect("agent X not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("model"), Some(&Value16::string("gpt-4".into())));
            assert_eq!(obj.get("temperature"), Some(&Value16::number(0.5)));
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_sop_backward_compat_task() {
    // `task` keyword removed (#497) — use `action` instead
    let interp = run(r#"
        action T {
            priority: 1,
            description: "test action"
        }
    "#);
    let val = interp.get_variable("T").expect("action T not found");
    match val {
        Value16::object(obj) => {
            assert_eq!(obj.get("priority"), Some(&Value16::number(1.0)));
            assert_eq!(
                obj.get("description"),
                Some(&Value16::string("test action".into()))
            );
        }
        other => panic!("Expected Object, got {other:?}"),
    }
}

#[test]
fn test_sop_backward_compat_provider() {
    // Provider declarations still work alongside SOP features
    let interp = run(r#"
        provider my_provider {
            type: "openai",
            model: "gpt-4",
            api_key: "sk-test"
        }
        subject MySubject {
            uses my_provider via api
        }
    "#);
    assert!(
        interp.get_variable("my_provider").is_ok(),
        "provider missing"
    );
    assert!(interp.get_variable("MySubject").is_ok(), "subject missing");
}

#[test]
#[ignore = "tool_decl removed from grammar (#489)"]
fn test_sop_backward_compat_tool() {
    // Tool declarations still work alongside SOP features
    let interp = run(r#"
        tool search_tool {
            server: "search_server",
            name: "web_search"
        }
        subject Researcher {
            state active: true
        }
    "#);
    assert!(interp.get_variable("search_tool").is_ok(), "tool missing");
    assert!(interp.get_variable("Researcher").is_ok(), "subject missing");
}

#[test]
#[ignore = "tool_decl removed from grammar (#489)"]
fn test_sop_backward_compat_mixed_workflow() {
    // Full mixed workflow: legacy constructs + SOP constructs coexist
    let interp = run(r#"
        provider llm {
            type: "openai",
            model: "gpt-4"
        }
        tool file_tool {
            server: "fs",
            name: "read"
        }
        agent Assistant {
            model: "gpt-4",
            provider: "llm"
        }
        task analyze {
            priority: 1,
            type: "analysis"
        }
        role Analyst { }
        subject DataBot has Analyst {
            state ready: true
            uses llm via api
        }
        relation DataBot <-> Assistant {
            trust: 80
        }
    "#);
    assert!(interp.get_variable("llm").is_ok(), "provider missing");
    assert!(interp.get_variable("file_tool").is_ok(), "tool missing");
    assert!(interp.get_variable("Assistant").is_ok(), "agent missing");
    assert!(interp.get_variable("analyze").is_ok(), "task missing");
    assert!(interp.get_variable("Analyst").is_ok(), "role missing");
    assert!(interp.get_variable("DataBot").is_ok(), "subject missing");
    assert!(
        interp.get_variable("DataBot_Assistant").is_ok(),
        "relation missing"
    );
}

#[test]
fn test_sop_backward_compat_variables_and_loops_with_subjects() {
    // Standard variables, loops, and functions work alongside SOP declarations
    let interp = run(r#"
        subject Counter {
            state value: 0
        }

        let sum = 0;
        let i = 0;
        while (i < 5) {
            sum = sum + i;
            i = i + 1;
        }
    "#);
    assert!(interp.get_variable("Counter").is_ok());
    assert_eq!(interp.get_variable("sum").unwrap(), Value16::number(10.0));
}

#[test]
fn test_sop_backward_compat_resource_with_subjects() {
    // Resource declarations still work alongside subjects
    let interp = run(r#"
        resource my_config {
            server: "config_server",
            uri: "file:///etc/config.json"
        }
        subject ConfigReader {
            state loaded: false
        }
    "#);
    assert!(interp.get_variable("my_config").is_ok(), "resource missing");
    assert!(
        interp.get_variable("ConfigReader").is_ok(),
        "subject missing"
    );
}

#[test]
fn test_sop_backward_compat_agent_with_nested_actions() {
    // Agent with action declarations (#497: task replaced by action)
    let interp = run(r#"
        agent Worker {
            model: "gpt-4"
        }
        action compute {
            priority: 2,
            type: "compute"
        }
    "#);
    assert!(
        interp.get_variable("Worker").is_ok(),
        "Worker agent missing"
    );
    assert!(
        interp.get_variable("compute").is_ok(),
        "compute action missing"
    );
}

#[test]
fn test_sop_backward_compat_functions_with_sop() {
    // Functions work alongside SOP declarations
    let interp = run(r#"
        subject Bot { state active: true }
        fn double(x) { return x * 2; }
        let result = double(21);
    "#);
    assert!(interp.get_variable("Bot").is_ok());
    assert_eq!(interp.get_variable("result").unwrap(), Value16::number(42.0));
}
