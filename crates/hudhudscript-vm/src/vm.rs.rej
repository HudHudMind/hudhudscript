     /// Return the lowercase runtime type name of a bytecode Value.
     fn bytecode_value_type_name(value: &Value16) -> &'static str {
-        let v = value.to_value();
-        match v {
-            // A3a: Int reports legacy "number" for backward compat. When A3c
-            // adds the script-visible `typeof` split, Int → "int" and Number
-            // → "float" will branch through a dedicated helper, and `number`
-            // will become an alias matching both.
-            Value::Int(_) => "number",
-            Value::Number(_) => "number",
-            Value::String(_) => "string",
-            Value::Boolean(_) => "boolean",
-            Value::Null => "null",
-            Value::Array(_) => "array",
-            Value::Object(_) => "object",
-            Value::Function(_) => "function",
-            Value::Promise(_) => "promise",
-            Value::Tool { .. } => "tool",
-            Value::Resource { .. } => "resource",
-            Value::Class(_) => "class",
-            Value::Instance(_) => "instance",
-            Value::Data(_) => "data",
-            Value::Option(_) => "option",
-            Value::Result(_) => "result",
-            Value::Set(_) => "set",
-            Value::Map(_) => "map",
-            Value::Generator(_) => "generator",
+        match value.0.tag() {
+            ReprTag::Null => "null",
+            ReprTag::Bool => "boolean",
+            ReprTag::Int => "number",
+            ReprTag::Number => "number",
+            ReprTag::Dynamic => {
+                if value.as_str().is_some() {
+                    "string"
+                } else if value.as_array().is_some() {
+                    "array"
+                } else if value.as_object().is_some() {
+                    "object"
+                } else if value.as_function_data().is_some() {
+                    "function"
+                } else if value.as_promise_state().is_some() {
+                    "promise"
+                } else if value.as_tool_ref().is_some() {
+                    "tool"
+                } else if value.as_resource_ref().is_some() {
+                    "resource"
+                } else if value.as_class_data().is_some() {
+                    "class"
+                } else if value.as_instance_data().is_some() {
+                    "instance"
+                } else if value.as_data_data().is_some() {
+                    "data"
+                } else if value.as_option().is_some() {
+                    "option"
+                } else if value.as_result().is_some() {
+                    "result"
+                } else if value.as_set().is_some() {
+                    "set"
+                } else if value.as_map_pairs().is_some() {
+                    "map"
+                } else if value.as_generator_state().is_some() {
+                    "generator"
+                } else {
+                    "object"
+                }
+            }
         }
     }
 
