agentstate_kw = _{ agentstate_kw_en }
intent_kw = _{ intent_kw_en }
want_kw = _{ want_kw_en }
priority_kw = _{ priority_kw_en }
// Fix #487: action_kw aggregated from all language files
action_kw = _{ action_kw_en | action_kw_tr | action_kw_ja | action_kw_ar | action_kw_bn | action_kw_ru | action_kw_es | action_kw_de | action_kw_fr | action_kw_it | action_kw_pt | action_kw_zh | action_kw_hi | action_kw_id | action_kw_vi | action_kw_el | action_kw_pl | action_kw_th | action_kw_bs | action_kw_hr | action_kw_sr | action_kw_fa | action_kw_ku }
transform_kw = _{ transform_kw_en }

