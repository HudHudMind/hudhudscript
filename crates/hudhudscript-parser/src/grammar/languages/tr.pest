// ============================================================================
// TURKISH KEYWORDS (Türkçe - SOV word order)
// ============================================================================

// Module system
use_kw_tr = _{ "kullan" }
as_kw_tr = _{ "olarak" }
import_kw_tr = _{ "içe_aktar" }
export_kw_tr = _{ "dışa_aktar" }
from_kw_tr = _{ "den" }

// Agent system
agent_kw_tr = _{ "ajan" | "ajani" | "temsilci" | "etmen" }
tool_kw_tr = _{ "araç" }
resource_kw_tr = _{ "kaynak" }
mcp_kw_tr = _{ "mcp" }
server_kw_tr = _{ "sunucu" }
config_kw_tr = _{ "yapılandırma" }
provider_kw_tr = _{ "sağlayıcı" }
model_kw_tr = _{ "model" }
call_kw_tr = _{ "çağır" }

// Control flow
if_kw_tr = _{ "eğer" }
ise_kw = _{ "ise" ~ !(LETTER | NUMBER | "_") }  // Fix #409/#411: boundary-aware postfix conditional
else_if_kw_tr = _{ "değilse ama" }
else_kw_tr = _{ "değilse" | "hiç biri değilse" | "hiçbiri değilse" }
while_kw_tr = _{ "iken" | "döngü" }
for_kw_tr = _{ "döngü" }
herbir_kw_tr = _{ "herbir" }
in_kw_tr = _{ "içindeki" | "içinde" }  // for...in loop — içindeki alias
return_kw_tr = _{ "dön" }
break_kw_tr = _{ "kır" | "çık" | "dur" }
continue_kw_tr = _{ "devam" }
switch_kw_tr = _{ "seç" }
case_kw_tr = _{ "durum" }
default_kw_tr = _{ "varsayılan" }

// Functions
function_kw_tr = _{ "işlev" | "iş" }

// Async
async_kw_tr = _{ "eşzamansız" }
await_kw_tr = _{ "bekle" }
promise_kw_tr = _{ "söz" }
future_kw_tr = _{ "gelecek" }

// Error handling
try_kw_tr = _{ "dene" }
catch_kw_tr = _{ "yakala" }
finally_kw_tr = _{ "sonunda" }
throw_kw_tr = _{ "fırlat" }

// Variables
var_kw_tr = _{ "değişken" }
let_kw_tr = _{ "tanım" | "değişken" }
const_kw_tr = _{ "sabit" }
set_kw_tr = _{ "değer" }

// Enum
enum_kw_tr = _{ "numaralandır" | "num" }

// Classes and OOP
class_kw_tr = _{ "sınıf" }
extends_kw_tr = _{ "<-" }  // Araba <- Araç (inheritance arrow)
new_kw_tr = _{ "yeni" }
this_kw_tr = _{ "bu" ~ !(ASCII_ALPHANUMERIC | "_" | '\u{0080}'..'\u{FFFF}') }
super_kw_tr = _{ "üst" }
self_kw_tr = _{ "kendi" ~ !(ASCII_ALPHANUMERIC | "_" | '\u{0080}'..'\u{FFFF}') }
public_kw_tr = _{ "açık" }
private_kw_tr = _{ "gizli" }
protected_kw_tr = _{ "saklı" }
static_kw_tr = _{ "statik" }
constructor_kw_tr = _{ "kurucu" }

// Data
data_kw_tr = _{ "veri" }

// State
state_kw_tr = _{ "durum" }
statemachine_kw_tr = _{ "durummakinesi" }

// Entity & Intent
entity_kw_tr = _{ "varlık" }
agentstate_kw_tr = _{ "ajan_durumu" | "ajandurum" }
intent_kw_tr = _{ "niyet" }
want_kw_tr = _{ "iste" }
priority_kw_tr = _{ "öncelik" }
action_kw_tr = _{ "üzerinde" }
transform_kw_tr = _{ "dönüşüm" }

// Events
event_kw_tr = _{ "olay" }
on_kw_tr = _{ "üzerinde" }
trigger_kw_tr = _{ "tetikle" }
when_kw_tr = _{ "ne_zaman" }

// Permissions
allow_kw_tr = _{ "izin_ver" | "izinler" }
deny_kw_tr = _{ "yasakla" }

// Governance
