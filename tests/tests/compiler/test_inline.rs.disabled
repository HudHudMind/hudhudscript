#[test]
fn constant_folding_add() {
    let stmts = vec![Stmt::Let {
        name: "x".to_string(),
        value: Expr::Binary {
            left: Box::new(Expr::Literal(Literal::Number(3.0), span())),
            op: BinaryOp::Add,
            right: Box::new(Expr::Literal(Literal::Number(4.0), span())),
            span: span(),
        },
        span: span(),
    }];
    let bc = compile(&stmts);
    assert!(
        !bc.instructions
            .iter()
        "Expected constant folding to eliminate Add instruction"
    );
    // Folded integer-valued constants land in int_constants pool (A3b)
    let has_seven = bc.int_constants.iter().any(|v| *v == 7);
    assert!(
        has_seven,
        "Expected constant 7 from folding 3+4, int_constants: {:?}",
        bc.int_constants
    );
}
