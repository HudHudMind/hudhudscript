#[test]
fn compile_and_run_if_true_branch() {
    let stmts = vec![
        Stmt::Let {
            name: "result".to_string(),
            value: Expr::Literal(Literal::Number(0.0), span()),
            span: span(),
        },
        Stmt::If {
            condition: Expr::Literal(Literal::Boolean(true), span()),
            then_branch: Box::new(Stmt::Assignment {
                target: Expr::Identifier("result".to_string(), span()),
                value: Expr::Literal(Literal::Number(1.0), span()),
                span: span(),
            }),
            else_branch: Some(Box::new(Stmt::Assignment {
                target: Expr::Identifier("result".to_string(), span()),
                value: Expr::Literal(Literal::Number(2.0), span()),
                span: span(),
            })),
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(
        vm.get_variable("result").and_then(|v| v.as_number()),
        Some(1.0)
    );
}

