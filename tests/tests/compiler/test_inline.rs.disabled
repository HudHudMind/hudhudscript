#[test]
fn compile_and_run_while_loop() {
    let stmts = vec![
        Stmt::Let {
            name: "x".to_string(),
            value: Expr::Literal(Literal::Number(0.0), span()),
            span: span(),
        },
        Stmt::While {
            condition: Expr::Binary {
                left: Box::new(Expr::Identifier("x".to_string(), span())),
                op: BinaryOp::Lt,
                right: Box::new(Expr::Literal(Literal::Number(5.0), span())),
                span: span(),
            },
            body: Box::new(Stmt::Assignment {
                target: Expr::Identifier("x".to_string(), span()),
                value: Expr::Binary {
                    left: Box::new(Expr::Identifier("x".to_string(), span())),
                    op: BinaryOp::Add,
                    right: Box::new(Expr::Literal(Literal::Number(1.0), span())),
                    span: span(),
                },
                span: span(),
            }),
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(vm.get_variable("x").and_then(|v| v.as_number()), Some(5.0));
}

#[test]
fn compile_and_run_function_decl_and_call() {
    let stmts = vec![
        Stmt::Function {
            name: "double".to_string(),
            params: vec!["n".to_string()],
            body: vec![Stmt::Return {
                value: Some(Expr::Binary {
                    left: Box::new(Expr::Identifier("n".to_string(), span())),
                    op: BinaryOp::Mul,
                    right: Box::new(Expr::Literal(Literal::Number(2.0), span())),
                    span: span(),
                }),
                span: span(),
            }],
            is_async: false,
            is_generator: false,
            type_params: Vec::new(),
            span: span(),
        },
        Stmt::Let {
            name: "result".to_string(),
            value: Expr::Call {
                callee: Box::new(Expr::Identifier("double".to_string(), span())),
                args: vec![Expr::Literal(Literal::Number(21.0), span())],
                span: span(),
            },
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(
        vm.get_variable("result").and_then(|v| v.as_number()),
        Some(42.0)
    );
}

#[test]
fn compile_function_no_return_gives_null() {
    let stmts = vec![
        Stmt::Function {
            name: "noop".to_string(),
            params: vec![],
            body: vec![Stmt::Let {
                name: "x".to_string(),
                value: Expr::Literal(Literal::Number(1.0), span()),
                span: span(),
            }],
            is_async: false,
            is_generator: false,
            type_params: Vec::new(),
            span: span(),
        },
        Stmt::Let {
            name: "result".to_string(),
            value: Expr::Call {
                callee: Box::new(Expr::Identifier("noop".to_string(), span())),
                args: vec![],
                span: span(),
            },
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert!(vm.get_variable("result").map(|v| v.is_null()) == Some(true));
}

#[test]
fn compile_and_run_array() {
    let stmts = vec![Stmt::Let {
        name: "arr".to_string(),
        value: Expr::Array {
            elements: vec![
                Expr::Literal(Literal::Number(1.0), span()),
                Expr::Literal(Literal::Number(2.0), span()),
                Expr::Literal(Literal::Number(3.0), span()),
            ],
            span: span(),
        },
        span: span(),
    }];
    let vm = compile_and_run(&stmts);
    match vm.get_variable("arr").and_then(|v| v.as_array()) {
        Some(arr) => assert_eq!(arr.len(), 3),
        other => panic!("Expected array, got {:?}", other),
    }
}

#[test]
fn compile_and_run_object() {
    let stmts = vec![Stmt::Let {
        name: "obj".to_string(),
        value: Expr::Object {
            properties: vec![
                (
                    "name".to_string(),
                    Expr::Literal(Literal::String("test".to_string()), span()),
                ),
                (
                    "value".to_string(),
                    Expr::Literal(Literal::Number(42.0), span()),
                ),
            ],
            span: span(),
        },
        span: span(),
    }];
    let vm = compile_and_run(&stmts);
    match vm.get_variable("obj").and_then(|v| v.as_object()) {
        Some(obj) => {
            assert_eq!(obj.len(), 2);
            assert_eq!(
                obj.get("name").and_then(|v| v.as_str()).as_deref(),
                Some("test")
            );
            assert_eq!(obj.get("value").and_then(|v| v.as_number()), Some(42.0));
        }
        other => panic!("Expected object, got {:?}", other),
    }
}

