#![cfg(feature = "stack-vm-legacy")]
#![cfg(feature = "stack-vm-legacy")]
use hudhudscript_ast::{BinaryOp, Decl, Expr, Literal, Span, Stmt, UnaryOp};
use hudhudscript_bytecode::Value16;
use hudhudscript_compiler::optimize;
use hudhudscript_compiler::optimizer::{constant_fold, dead_code_eliminate};
use hudhudscript_compiler::{
    create_bundle, deserialize_bytecode, load_bundle, load_hudc, save_hudc, serialize_bytecode,
    BundleManifest, Bytecode, Compiler, Instruction, OptimizationLevel, VM,
};

fn span() -> Span {
    Span::default()
}

fn compile(stmts: &[Stmt]) -> Bytecode {
    let mut compiler = Compiler::new();
    compiler.compile(stmts).expect("compilation should succeed")
}

fn compile_and_run(stmts: &[Stmt]) -> VM {
    let bytecode = compile(stmts);
    let mut vm = VM::new();
    vm.execute(&bytecode).expect("execution should succeed");
    vm
}

// ── serialize.rs tests ─────────────────────────────────────────────────

#[test]
fn round_trip_serialize_deserialize() {
    let instructions = vec![
        Instruction::LoadConst(0),
        Instruction::LoadConst(1),
        Instruction::Print,
    ];
    let constants = vec![Value16::number(1.0), Value16::number(2.0)];

    let data = serialize_bytecode(&instructions, &constants);
    let (instr2, const2) = deserialize_bytecode(&data).unwrap();

    assert_eq!(instr2.len(), instructions.len());
    assert_eq!(const2.len(), constants.len());
}

#[test]
fn bad_magic_rejected() {
    let mut data = serialize_bytecode(&[], &[]);
    data[0] = 0xFF;
    assert!(deserialize_bytecode(&data).is_err());
}

#[test]
fn bad_checksum_rejected() {
    let mut data = serialize_bytecode(&[Instruction::Print], &[]);
    let last = data.len() - 1;
    data[last] ^= 0xFF;
    assert!(deserialize_bytecode(&data).is_err());
}

#[test]
fn save_and_load_hudc() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("test.hudc");

    let instructions = vec![Instruction::LoadConst(0), Instruction::Print];
    let constants = vec![Value16::string("hello")];

    save_hudc(&path, &instructions, &constants).unwrap();
    let (instr2, const2) = load_hudc(&path).unwrap();

    assert_eq!(instr2.len(), 2);
    assert_eq!(const2.len(), 1);
}

// ── optimizer.rs tests ─────────────────────────────────────────────────

#[test]
fn constant_fold_add() {
    let mut constants = vec![Value16::number(3.0), Value16::number(4.0)];
    let mut numeric_constants = Vec::new();
    let mut instructions = vec![
        Instruction::LoadConst(0),
        Instruction::LoadConst(1),
        Instruction::Print,
    ];

    constant_fold(&mut instructions, &mut constants, &mut numeric_constants);

    assert_eq!(instructions.len(), 2);
    if let Instruction::LoadNumConst(idx) = &instructions[0] {
        let bits = numeric_constants[*idx as usize];
        let n = f64::from_bits(bits);
        assert!((n - 7.0).abs() < f64::EPSILON);
    } else {
        panic!(
            "Expected LoadNumConst after numeric fold, got {:?}",
            instructions[0]
        );
    }
}

#[test]
fn dead_code_after_return() {
    let mut instructions = vec![Instruction::Return, Instruction::Print, //Pop removed (register VM)];

    dead_code_eliminate(&mut instructions);

    assert_eq!(instructions.len(), 1);
    assert!(matches!(instructions[0], Instruction::Return));
}

#[test]
fn dead_code_preserves_jump_target() {
    let mut instructions = vec![
        Instruction::Jump(3),
        Instruction::Print,
        //Pop removed (register VM),
        Instruction::Print,
    ];

    dead_code_eliminate(&mut instructions);

    assert!(instructions.len() >= 2);
}

#[test]
fn peephole_removes_load_pop() {
    let mut instructions = vec![
        Instruction::LoadConst(0),
        //Pop removed (register VM),
        Instruction::Print,
    ];

    peephole_optimize(&mut instructions);

    assert_eq!(instructions.len(), 1);
    assert!(matches!(instructions[0], Instruction::Print));
}

#[test]
fn peephole_double_not() {
    let mut instructions = vec![
        Instruction::LoadConst(0),
        Instruction::Not,
        Instruction::Not,
        Instruction::Print,
    ];

    peephole_optimize(&mut instructions);

    assert_eq!(instructions.len(), 2);
    assert!(matches!(instructions[0], Instruction::LoadConst(0)));
    assert!(matches!(instructions[1], Instruction::Print));
}

#[test]
fn optimize_none_is_noop() {
    let mut constants = vec![Value16::number(1.0), Value16::number(2.0)];
    let mut instructions = vec![
        Instruction::LoadConst(0),
        Instruction::LoadConst(1),
    ];
    let original_len = instructions.len();

    optimize(
        &mut instructions,
        &mut constants,
        OptimizationLevel::None,
        None,
    );

    assert_eq!(instructions.len(), original_len);
}

// ── bundle.rs tests ────────────────────────────────────────────────────

#[test]
fn round_trip_bundle() {
    let dir = tempfile::tempdir().unwrap();
    let bc_path = dir.path().join("app.hudc");
    let bundle_path = dir.path().join("app.hudcbundle");

    let fake_bc = vec![0x48, 0x55, 0x44, 0x43, 1, 2, 3, 4];
    std::fs::write(&bc_path, &fake_bc).unwrap();

    let manifest = BundleManifest {
        name: "test-app".into(),
        version: "0.1.0".into(),
        entry_point: "main.hud".into(),
        dependencies: vec!["stdlib".into()],
    };

    create_bundle(&manifest, &bc_path, &bundle_path).unwrap();

    let (loaded_manifest, loaded_bc) = load_bundle(&bundle_path).unwrap();

    assert_eq!(loaded_manifest.name, "test-app");
    assert_eq!(loaded_manifest.version, "0.1.0");
    assert_eq!(loaded_manifest.entry_point, "main.hud");
    assert_eq!(loaded_manifest.dependencies, vec!["stdlib"]);
    assert_eq!(loaded_bc, fake_bc);
}

#[test]
fn load_bundle_too_small() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("bad.hudcbundle");
    std::fs::write(&path, &[0u8; 2]).unwrap();

    assert!(load_bundle(&path).is_err());
}

#[test]
fn load_bundle_truncated_manifest() {
    let dir = tempfile::tempdir().unwrap();
    let path = dir.path().join("bad2.hudcbundle");
    let mut data = Vec::new();
    data.extend_from_slice(&1000u32.to_be_bytes());
    data.extend_from_slice(&[0u8; 4]);
    std::fs::write(&path, &data).unwrap();

    assert!(load_bundle(&path).is_err());
}

// ── compiler.rs tests ──────────────────────────────────────────────────

#[test]
fn compile_number_literal() {
    let stmts = vec![Stmt::Let {
        name: "x".to_string(),
        value: Expr::Literal(Literal::Number(42.0), span()),
        span: span(),
    }];
    let bc = compile(&stmts);
    // Integer-valued literals go into the int_constants pool (A3b)
    assert!(
        !bc.int_constants.is_empty(),
        "int_constants should contain 42"
    );
    assert_eq!(bc.int_constants[0], 42);
}

#[test]
fn compile_string_literal() {
    let stmts = vec![Stmt::Let {
        name: "s".to_string(),
        value: Expr::Literal(Literal::String("hello".to_string()), span()),
        span: span(),
    }];
    let bc = compile(&stmts);
    assert_eq!(bc.constants[0].as_str().as_deref(), Some("hello"));
}

#[test]
fn compile_boolean_literal() {
    let stmts = vec![Stmt::Let {
        name: "b".to_string(),
        value: Expr::Literal(Literal::Boolean(true), span()),
        span: span(),
    }];
    let bc = compile(&stmts);
    assert_eq!(bc.constants[0].as_bool(), Some(true));
}

#[test]
fn compile_null_literal() {
    let stmts = vec![Stmt::Let {
        name: "n".to_string(),
        value: Expr::Literal(Literal::Null, span()),
        span: span(),
    }];
    let bc = compile(&stmts);
    assert!(bc.constants[0].is_null());
}

#[test]
fn compile_binary_add() {
    let stmts = vec![
        Stmt::Let {
            name: "a".to_string(),
            value: Expr::Literal(Literal::Number(3.0), span()),
            span: span(),
        },
        Stmt::Let {
            name: "b".to_string(),
            value: Expr::Literal(Literal::Number(4.0), span()),
            span: span(),
        },
        Stmt::Let {
            name: "sum".to_string(),
            value: Expr::Binary {
                left: Box::new(Expr::Identifier("a".to_string(), span())),
                op: BinaryOp::Add,
                right: Box::new(Expr::Identifier("b".to_string(), span())),
                span: span(),
            },
            span: span(),
        },
    ];
    let bc = compile(&stmts);
    assert!(bc
        .instructions
        .iter()
}

#[test]
fn compile_and_run_arithmetic() {
    let stmts = vec![Stmt::Let {
        name: "x".to_string(),
        value: Expr::Binary {
            left: Box::new(Expr::Binary {
                left: Box::new(Expr::Literal(Literal::Number(10.0), span())),
                op: BinaryOp::Add,
                right: Box::new(Expr::Literal(Literal::Number(5.0), span())),
                span: span(),
            }),
            op: BinaryOp::Sub,
            right: Box::new(Expr::Literal(Literal::Number(3.0), span())),
            span: span(),
        },
        span: span(),
    }];
    let vm = compile_and_run(&stmts);
    match vm.get_variable("x").and_then(|v| v.as_number()) {
        Some(n) => assert_eq!(n, 12.0),
        other => panic!("Expected Number(12), got {:?}", other),
    }
}

#[test]
fn compile_and_run_multiply_divide() {
    let stmts = vec![
        Stmt::Let {
            name: "a".to_string(),
            value: Expr::Binary {
                left: Box::new(Expr::Literal(Literal::Number(6.0), span())),
                op: BinaryOp::Mul,
                right: Box::new(Expr::Literal(Literal::Number(7.0), span())),
                span: span(),
            },
            span: span(),
        },
        Stmt::Let {
            name: "b".to_string(),
            value: Expr::Binary {
                left: Box::new(Expr::Literal(Literal::Number(10.0), span())),
                op: BinaryOp::Div,
                right: Box::new(Expr::Literal(Literal::Number(4.0), span())),
                span: span(),
            },
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(vm.get_variable("a").and_then(|v| v.as_number()), Some(42.0));
    assert_eq!(vm.get_variable("b").and_then(|v| v.as_number()), Some(2.5));
}

#[test]
fn compile_and_run_modulo() {
    let stmts = vec![Stmt::Let {
        name: "r".to_string(),
        value: Expr::Binary {
            left: Box::new(Expr::Literal(Literal::Number(10.0), span())),
            op: BinaryOp::Mod,
            right: Box::new(Expr::Literal(Literal::Number(3.0), span())),
            span: span(),
        },
        span: span(),
    }];
    let vm = compile_and_run(&stmts);
    assert_eq!(vm.get_variable("r").and_then(|v| v.as_number()), Some(1.0));
}

#[test]
fn compile_and_run_comparison() {
    let stmts = vec![
        Stmt::Let {
            name: "eq".to_string(),
            value: Expr::Binary {
                left: Box::new(Expr::Literal(Literal::Number(5.0), span())),
                op: BinaryOp::Eq,
                right: Box::new(Expr::Literal(Literal::Number(5.0), span())),
                span: span(),
            },
            span: span(),
        },
        Stmt::Let {
            name: "ne".to_string(),
            value: Expr::Binary {
                left: Box::new(Expr::Literal(Literal::Number(5.0), span())),
                op: BinaryOp::Ne,
                right: Box::new(Expr::Literal(Literal::Number(3.0), span())),
                span: span(),
            },
            span: span(),
        },
        Stmt::Let {
            name: "lt".to_string(),
            value: Expr::Binary {
                left: Box::new(Expr::Literal(Literal::Number(3.0), span())),
                op: BinaryOp::Lt,
                right: Box::new(Expr::Literal(Literal::Number(5.0), span())),
                span: span(),
            },
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(vm.get_variable("eq").and_then(|v| v.as_bool()), Some(true));
    assert_eq!(vm.get_variable("ne").and_then(|v| v.as_bool()), Some(true));
    assert_eq!(vm.get_variable("lt").and_then(|v| v.as_bool()), Some(true));
}

