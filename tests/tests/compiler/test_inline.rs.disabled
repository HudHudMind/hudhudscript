        Stmt::Let {
            name: "x".to_string(),
            value: Expr::Literal(Literal::Number(1.0), span()),
            span: span(),
        },
        Stmt::Assignment {
            target: Expr::Identifier("x".to_string(), span()),
            value: Expr::Literal(Literal::Number(99.0), span()),
