#[test]
fn bytecode_bincode_roundtrip() {
    let stmts = vec![Stmt::Let {
        name: "x".to_string(),
        value: Expr::Binary {
            left: Box::new(Expr::Literal(Literal::Number(3.0), span())),
            op: BinaryOp::Add,
            right: Box::new(Expr::Literal(Literal::Number(4.0), span())),
            span: span(),
        },
        span: span(),
    }];
    let bc = compile(&stmts);
    let bytes = bc.to_bytes().expect("serialization should succeed");
    let bc2 = Bytecode::from_bytes(&bytes).expect("deserialization should succeed");

    assert_eq!(bc.version, bc2.version);
    assert_eq!(bc.constants.len(), bc2.constants.len());
    assert_eq!(bc.instructions.len(), bc2.instructions.len());

    let mut vm = VM::new();
    vm.execute(&bc2).expect("execution should succeed");
    assert_eq!(vm.get_variable("x").and_then(|v| v.as_number()), Some(7.0));
}

#[test]
fn bytecode_json_roundtrip() {
    let stmts = vec![Stmt::Let {
        name: "y".to_string(),
        value: Expr::Literal(Literal::String("test".to_string()), span()),
        span: span(),
    }];
    let bc = compile(&stmts);
    let json = bc.to_json().expect("JSON serialization should succeed");
    let bc2 = Bytecode::from_json(&json).expect("JSON deserialization should succeed");

    assert_eq!(bc.version, bc2.version);
    assert_eq!(bc.constants.len(), bc2.constants.len());
    assert_eq!(bc.instructions.len(), bc2.instructions.len());
}

#[test]
fn bytecode_new_defaults() {
    let bc = Bytecode::new();
    assert!(bc.constants.is_empty());
    assert!(bc.instructions.is_empty());
    assert!(bc.functions.is_empty());
}

#[test]
fn bytecode_add_constant() {
    let mut bc = Bytecode::new();
    let idx0 = bc.add_constant(Value16::number(1.0));
    let idx1 = bc.add_constant(Value16::string("test".to_string()));
    assert_eq!(idx0, 0);
    assert_eq!(idx1, 1);
    assert_eq!(bc.constants.len(), 2);
}

#[test]
fn bytecode_default_trait() {
    let bc = Bytecode::default();
    assert!(bc.constants.is_empty());
}

