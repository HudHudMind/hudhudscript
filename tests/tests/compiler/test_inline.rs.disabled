#[test]
fn compiler_default() {
    let _compiler = Compiler::default();
}

#[test]
fn compiler_default_produces_valid_bytecode() {
    let mut compiler = Compiler::default();
    // Compile a simple "let x = 1 + 2" statement
    let stmts = vec![Stmt::Let {
        name: "x".to_string(),
        value: Expr::Binary {
            left: Box::new(Expr::Literal(Literal::Number(1.0), span())),
            op: BinaryOp::Add,
            right: Box::new(Expr::Literal(Literal::Number(2.0), span())),
            span: span(),
        },
        span: span(),
    }];
    let bytecode = compiler
        .compile(&stmts)
        .expect("compilation should succeed");
    assert!(
        !bytecode.instructions.is_empty(),
        "bytecode should contain instructions"
    );
    // Integer-valued literals fold into int_constants pool (A3b)
    assert!(
        !bytecode.int_constants.is_empty(),
        "bytecode should contain int_constants after folding 1+2"
    );

    // Execute and verify the result is correct
    let mut vm = VM::new();
    vm.execute(&bytecode).expect("execution should succeed");
    assert_eq!(vm.get_variable("x").and_then(|v| v.as_number()), Some(3.0));
}

#[test]
fn compile_for_in_loop() {
    let stmts = vec![
        Stmt::Let {
            name: "sum".to_string(),
            value: Expr::Literal(Literal::Number(0.0), span()),
            span: span(),
        },
        Stmt::For {
            variable: "item".to_string(),
            iterable: Expr::Array {
                elements: vec![
                    Expr::Literal(Literal::Number(10.0), span()),
                    Expr::Literal(Literal::Number(20.0), span()),
                    Expr::Literal(Literal::Number(30.0), span()),
                ],
                span: span(),
            },
            body: Box::new(Stmt::Assignment {
                target: Expr::Identifier("sum".to_string(), span()),
                value: Expr::Binary {
                    left: Box::new(Expr::Identifier("sum".to_string(), span())),
                    op: BinaryOp::Add,
                    right: Box::new(Expr::Identifier("item".to_string(), span())),
                    span: span(),
                },
                span: span(),
            }),
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(
        vm.get_variable("sum").and_then(|v| v.as_number()),
        Some(60.0)
    );
}

