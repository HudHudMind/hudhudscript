    let locale = VM::detect_locale("اطبع ١٠");
    assert_eq!(locale, OutputLocale::Arabic);
}

#[test]
fn vm_detect_locale_default() {
    use hudhudscript_compiler::OutputLocale;
    let locale = VM::detect_locale("print(10)");
    assert_eq!(locale, OutputLocale::Default);
}

#[test]
fn vm_builtin_len() {
    let stmts = vec![
        Stmt::Let {
            name: "arr".to_string(),
            value: Expr::Array {
                elements: vec![
                    Expr::Literal(Literal::Number(1.0), span()),
                    Expr::Literal(Literal::Number(2.0), span()),
                    Expr::Literal(Literal::Number(3.0), span()),
                ],
                span: span(),
            },
            span: span(),
        },
        Stmt::Let {
            name: "n".to_string(),
            value: Expr::Call {
                callee: Box::new(Expr::Identifier("len".to_string(), span())),
                args: vec![Expr::Identifier("arr".to_string(), span())],
                span: span(),
            },
            span: span(),
        },
    ];
    let vm = compile_and_run(&stmts);
    assert_eq!(vm.get_variable("n").and_then(|v| v.as_number()), Some(3.0));
}

