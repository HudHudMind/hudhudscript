#[test]
fn compile_return_with_value() {
    let stmts = vec![Stmt::Return {
        value: Some(Expr::Literal(Literal::Number(42.0), span())),
        span: span(),
    }];
    let bc = compile(&stmts);
    assert!(bc
        .instructions
        .iter()
        .any(|i| matches!(i, Instruction::Return)));
}

#[test]
fn compile_return_no_value() {
    let stmts = vec![Stmt::Return {
        value: None,
        span: span(),
    }];
    let bc = compile(&stmts);
    assert!(bc
        .instructions
        .iter()
        .any(|i| matches!(i, Instruction::Return)));
    assert!(bc.constants[0].is_null());
}

#[test]
fn vm_division_by_zero() {
    let stmts = vec![Stmt::Let {
        name: "x".to_string(),
        value: Expr::Binary {
            left: Box::new(Expr::Literal(Literal::Number(1.0), span())),
            op: BinaryOp::Div,
            right: Box::new(Expr::Literal(Literal::Number(0.0), span())),
            span: span(),
        },
        span: span(),
    }];
    let bc = compile(&stmts);
    let mut vm = VM::new();
    let result = vm.execute(&bc);
    assert!(result.is_err());
}

