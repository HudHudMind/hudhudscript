#![cfg(feature = "stack-vm-legacy")]
//! A3b empirical verification: integer-valued numeric literals compile to
//! `Instruction::LoadIntConst(idx)` referencing the `int_constants` pool,
//! while fractional / non-finite numeric literals stay on the existing
//! `LoadNumConst(idx)` path.
//!
//! Kural 1 compliance: brand-new test file, no existing test body touched.
//! Adds empirical coverage the task spec requested ("Integer literal'ler
//! artık LoadIntConst emit ediyor (disassembly ile verify)").

use hudhudscript_bytecode::{Instruction, BYTECODE_VERSION};
use hudhudscript_compiler::Compiler;
use hudhudscript_parser::parse;

fn compile(src: &str) -> hudhudscript_bytecode::Bytecode {
    let ast = parse(src).expect("parse");
    let mut c = Compiler::new();
    c.compile(&ast).expect("compile")
}

/// Walk a bytecode's main-body + all function chunks, invoking `f` with
/// every `Instruction`.  Used to verify an emission appears *somewhere*
/// in the compiled program (main vs function bodies is irrelevant to
/// the A3b invariant — the pool-routed LoadIntConst must fire either way).
fn walk_all_instructions<'a>(
    bc: &'a hudhudscript_bytecode::Bytecode,
    mut f: impl FnMut(&'a Instruction),
) {
    for instr in &bc.instructions {
        f(instr);
    }
    for chunk in bc.functions.values() {
        for instr in &chunk.instructions {
            f(instr);
        }
    }
}

#[test]
fn a3b_bytecode_version_is_16() {
    // A3b pinned v16; A3c superseded with v17; A2 super-instruction
    // fusion bumped to v18 (adds LeJumpIfFalse, IntSubCall1, AddReturn).
    // The assertion widened (>=17) keeps the A3b contract intact while
    // allowing subsequent perf-oriented bumps to proceed without
    // re-invalidating this test.  Kural 7c: lower bound is the real
    // invariant A3b owns.
    assert!(
        BYTECODE_VERSION >= 17,
        "post-A3c BYTECODE_VERSION ≥ 17 (A3b=16 + A3c IntXxx fast-path); got {}",
        BYTECODE_VERSION
    );
}

#[test]
fn a3b_integer_literal_emits_load_int_const() {
    let bc = compile("let x = 42");
    let mut found = false;
    let mut seen_int_value: Option<i64> = None;
    walk_all_instructions(&bc, |i| {
        if let Instruction::LoadIntConst(idx) = i {
            found = true;
            seen_int_value = Some(bc.int_constants[*idx as usize]);
        }
    });
    assert!(
        found,
        "integer literal `42` should emit LoadIntConst, got instructions: {:?}",
        bc.instructions
    );
    assert_eq!(seen_int_value, Some(42));
    assert!(
        bc.int_constants.contains(&42),
        "int_constants pool must contain 42, got {:?}",
        bc.int_constants
    );
}

#[test]
fn a3b_fractional_literal_stays_on_load_num_const() {
    let bc = compile("let x = 3.14");
    let mut has_int = false;
    let mut has_num = false;
    walk_all_instructions(&bc, |i| match i {
        Instruction::LoadIntConst(_) => has_int = true,
        Instruction::LoadNumConst(_) => has_num = true,
        _ => {}
    });
    assert!(
        !has_int,
        "fractional literal `3.14` must NOT route through LoadIntConst"
    );
    assert!(has_num, "fractional literal `3.14` must emit LoadNumConst");
}

#[test]
fn a3b_int_pool_dedups_repeated_literals() {
    let bc = compile("let a = 1\nlet b = 1\nlet c = 2");
    assert_eq!(
        bc.int_constants.len(),
        2,
        "int_constants must dedup (1,1,2) → {{1,2}}, got {:?}",
        bc.int_constants
    );
    assert!(bc.int_constants.contains(&1));
    assert!(bc.int_constants.contains(&2));
}

#[test]
fn a3b_fib_body_emits_int_literals_via_fusion_or_load_int_const() {
    // fib has two integer literals inside the body (`n - 1` / `n - 2`).
    //
    // A3b shape: `NumSubISlot { imm: 1/2 }` (Int widens to f64 in the
    //            fused arm via `num_ref_as_f64`).
    // A3c shape: `IntSubRI { imm: 1/2 }` (pure-Int fast-path — no
    //            f64 widening; `n` param slot carries `Value::Int`).
    //
    // This test asserts the COMBINED invariant — either shape proves the
    // A3b+A3c emission path is reachable from the literal lowering AND
    // the peephole fusion.  Kural 7c single path: the compiler picks
    // exactly one based on `infer_type`, no dual-emission fallback.
    let src = r#"
        let fib = (n) => { if (n <= 1) { return n; } return fib(n - 1) + fib(n - 2); };
        let result = fib(30);
    "#;
    let bc = compile(src);

    let mut saw_int_const = false;
    let mut saw_sub_imm_one = false;
    let mut saw_sub_imm_two = false;
    walk_all_instructions(&bc, |i| match i {
        Instruction::LoadIntConst(_) => saw_int_const = true,
        // A3b NumSubISlot path (integer widened to f64 in fused arm).
        Instruction::NumSubISlot { imm: 1, .. } => saw_sub_imm_one = true,
        Instruction::NumSubISlot { imm: 2, .. } => saw_sub_imm_two = true,
        // A3c IntSubRI path (pure integer, no widening).
        Instruction::IntSubRI { imm: 1, .. } => saw_sub_imm_one = true,
        Instruction::IntSubRI { imm: 2, .. } => saw_sub_imm_two = true,
        // A2 IntSubCall1 path — super-instruction fuses the A3c
        // `IntSubRI` with its immediately-following `Call(arg=1)`.
        // The immediate now lives in `super_instr_payloads[idx].imm`.
        Instruction::IntSubCall1(idx) => {
            let sp = bc.get_super_instr_payload(*idx);
            if sp.imm == 1 {
                saw_sub_imm_one = true;
            }
            if sp.imm == 2 {
                saw_sub_imm_two = true;
            }
        }
        _ => {}
    });
    assert!(
        saw_int_const,
        "top-level `fib(30)` argument `30` must emit LoadIntConst"
    );
    assert!(
        saw_sub_imm_one,
        "`n - 1` must fuse to NumSubISlot{{imm:1}} or IntSubRI{{imm:1}}"
    );
    assert!(
        saw_sub_imm_two,
        "`n - 2` must fuse to NumSubISlot{{imm:2}} or IntSubRI{{imm:2}}"
    );
}
