#![cfg(feature = "stack-vm-legacy")]
//! A3c empirical verification — fib body must fuse to `IntSubRI`
//! (not `NumSubISlot`) after the A3c Int fast-path landing.  Also serves
//! as a live disassembly dump when run with `--nocapture`.
//!
//! Kural 1: brand-new test file, adds to coverage (does not modify existing).

use hudhudscript_bytecode::Instruction;
use hudhudscript_compiler::Compiler;
use hudhudscript_parser::parse;

fn compile(src: &str) -> hudhudscript_bytecode::Bytecode {
    let ast = parse(src).expect("parse");
    let mut c = Compiler::new();
    c.compile(&ast).expect("compile")
}

#[test]
fn a3c_fib_body_uses_int_sub_i_slot() {
    let src = r#"
        let fib = (n) => { if (n <= 1) { return n; } return fib(n - 1) + fib(n - 2); };
        let result = fib(30);
    "#;
    let bc = compile(src);

    // Dump for human inspection under --nocapture.
    println!("\n=== Main body ===");
    for (i, instr) in bc.instructions.iter().enumerate() {
        println!("  {:4} {:?}", i, instr);
    }
    for (name, chunk) in bc.functions.iter() {
        println!("\n=== Function '{}' ===", name);
        for (i, instr) in chunk.instructions.iter().enumerate() {
            println!("  {:4} {:?}", i, instr);
        }
    }
    println!("\nint_constants = {:?}", bc.int_constants);

    // Core invariant: the Int fast-path must fuse `n - 1` / `n - 2` so
    // no f64 round-trip happens on the hot recursive path.  Pre-A2 the
    // witness was `IntSubRI { imm }`; post-A2 the same `IntSubRI`
    // bigrams combine with their immediately-following `Call(arg=1)`
    // into `IntSubCall1 { imm, .. }`.  EITHER form proves A3c's Int
    // routing fired — the A2 super-instruction fusion subsumes the
    // IntSubRI semantics (see vm.rs IntSubCall1 arm).  Kural 2:
    // same behavior in both forms — any absence of BOTH means A3c's
    // Int peephole didn't trigger.
    let mut saw_int_sub_1 = false;
    let mut saw_int_sub_2 = false;
    for chunk in bc.functions.values() {
        for instr in &chunk.instructions {
            match instr {
                Instruction::IntSubRI { imm: 1, .. } => saw_int_sub_1 = true,
                Instruction::IntSubRI { imm: 2, .. } => saw_int_sub_2 = true,
                // A2: `IntSubRI + Call(arg_count=1)` → `IntSubCall1(idx)`;
                // resolve the payload side table to recover the immediate.
                Instruction::IntSubCall1(idx) => {
                    let sp = bc.get_super_instr_payload(*idx);
                    if sp.imm == 1 {
                        saw_int_sub_1 = true;
                    }
                    if sp.imm == 2 {
                        saw_int_sub_2 = true;
                    }
                }
                _ => {}
            }
        }
    }
    assert!(
        saw_int_sub_1,
        "`n - 1` must fuse to IntSubRI{{imm:1}} or IntSubCall1{{imm:1}} post-A3c/A2"
    );
    assert!(
        saw_int_sub_2,
        "`n - 2` must fuse to IntSubRI{{imm:2}} or IntSubCall1{{imm:2}} post-A3c/A2"
    );
}

#[test]
fn a3c_int_literal_add_emits_int_add() {
    // Integer-literal pair folded at compile time → LoadIntConst; but
    // `1 + x` where `x` is an identifier stays Unknown → generic Add.
    // To trigger the IntAdd emission we need a non-folded Int×Int expr.
    // Easiest: unary-negated integer literal + integer literal.
    let src = "let r = (-2) + 3";
    let bc = compile(src);

    // Either `IntAdd` appears, or constant-folding collapsed to a single
    // LoadIntConst.  Both prove the A3c Int-routing fires somewhere.
    let mut saw_int_const_only = false;
    let mut load_ic_count = 0;
    for instr in &bc.instructions {
        match instr {
            Instruction::LoadIntConst(_) => load_ic_count += 1,
            _ => {}
        }
    }
        saw_int_const_only = true;
    }
    assert!(
        "`(-2) + 3` must emit IntAdd / IntNeg or fold to a single LoadIntConst; got: {:?}",
        bc.instructions
    );
}
