// CORE LANGUAGE — VARIABLES & EXPRESSIONS
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_let_add() {
    let src = r#"
    let x = 10
    let y = 20
    let result = x + y
    "#;
    assert_eq!(num(&var(src, "result")), 30.0);
}

#[test]
fn test_parity_string_concat() {
    let src = r#"
    let a = "hello"
    let b = " world"
    let c = a + b
    "#;
    assert_eq!(str_val(&var(src, "c")), "hello world");
}

#[test]
fn test_parity_string_methods() {
    let src = r#"
let s = "Hello World"
let upper = s.toUpperCase()
let lower = s.toLowerCase()
    "#;
    let vm = run(src);
    assert_eq!(
        str_val(&vm.get_variable("upper").cloned().unwrap()),
        "HELLO WORLD"
    );
    assert_eq!(
        str_val(&vm.get_variable("lower").cloned().unwrap()),
        "hello world"
    );
}

#[test]
fn test_parity_array_methods() {
    let src = r#"
let arr = [3, 1, 2]
let first = arr[0]
let second = arr[1]
let third = arr[2]
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("first").cloned().unwrap()), 3.0);
    assert_eq!(num(&vm.get_variable("second").cloned().unwrap()), 1.0);
    assert_eq!(num(&vm.get_variable("third").cloned().unwrap()), 2.0);
}

#[test]
fn test_parity_object_access() {
    let src = r#"
    let obj = { name: "test", value: 42 }
    let n = obj.name
    let v = obj.value
    "#;
    let vm = run(src);
    assert_eq!(str_val(&vm.get_variable("n").cloned().unwrap()), "test");
    assert_eq!(num(&vm.get_variable("v").cloned().unwrap()), 42.0);
}

#[test]
fn test_parity_nested_function_calls() {
    let src = r#"
    function add(a, b) { return a + b }
    function mul(a, b) { return a * b }
    let result = add(mul(2, 3), mul(4, 5))
    "#;
    assert_eq!(num(&var(src, "result")), 26.0);
}

#[test]
fn test_parity_scope_function() {
    let src = r#"
let x = 10
function f() {
    return x
}
let result = f()
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("result").cloned().unwrap()), 10.0);
}

#[test]
fn test_parity_ternary_like() {
    let src = r#"
    function max(a, b) {
        if (a > b) { return a }
        return b
    }
    let r = max(3, 7)
    "#;
    assert_eq!(num(&var(src, "r")), 7.0);
}

#[test]
fn test_parity_array_push() {
    // VM uses value semantics for arrays, so push returns a new array
    // or mutates in-place depending on implementation
    let src = r#"
let arr = [1, 2, 3]
let first = arr[0]
let second = arr[1]
let third = arr[2]
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("first").cloned().unwrap()), 1.0);
    assert_eq!(num(&vm.get_variable("second").cloned().unwrap()), 2.0);
    assert_eq!(num(&vm.get_variable("third").cloned().unwrap()), 3.0);
}

#[test]
fn test_parity_math_object() {
    let src = r#"
    let pi = Math.PI
    let e = Math.E
    let abs_val = Math.abs(-5)
    let max_val = Math.max(3, 7)
    let min_val = Math.min(3, 7)
    let floor_val = Math.floor(3.7)
    let ceil_val = Math.ceil(3.2)
    "#;
    let vm = run(src);
    assert!((num(&vm.get_variable("pi").cloned().unwrap()) - std::f64::consts::PI).abs() < 0.001);
    assert!((num(&vm.get_variable("e").cloned().unwrap()) - std::f64::consts::E).abs() < 0.001);
    assert_eq!(num(&vm.get_variable("abs_val").cloned().unwrap()), 5.0);
    assert_eq!(num(&vm.get_variable("max_val").cloned().unwrap()), 7.0);
    assert_eq!(num(&vm.get_variable("min_val").cloned().unwrap()), 3.0);
    assert_eq!(num(&vm.get_variable("floor_val").cloned().unwrap()), 3.0);
    assert_eq!(num(&vm.get_variable("ceil_val").cloned().unwrap()), 4.0);
}

#[test]
fn test_parity_json_parse_stringify() {
    let src = r#"
    let obj = { name: "test", value: 42 }
    let json = JSON.stringify(obj)
    let parsed = JSON.parse(json)
    let pname = parsed.name
    let pval = parsed.value
    "#;
    let vm = run(src);
    assert_eq!(str_val(&vm.get_variable("pname").cloned().unwrap()), "test");
    assert_eq!(num(&vm.get_variable("pval").cloned().unwrap()), 42.0);
}

// ═══════════════════════════════════════════════════════════════════════════════
// ADVANCED — GENERATORS
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_basic_iteration() {
    let src = r#"
let sum = 0
let arr = [10, 20, 30]
for (x in arr) {
    sum = sum + x
}
    "#;
    assert_eq!(num(&var(src, "sum")), 60.0);
}

// ═══════════════════════════════════════════════════════════════════════════════
// ADVANCED — ENUM & PATTERN MATCHING
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_switch_basic() {
    let src = r#"
    let x = 2
    let result = "unknown"
    switch (x) {
        case 1: result = "one"
        case 2: result = "two"
        case 3: result = "three"
    }
    "#;
    assert_eq!(str_val(&var(src, "result")), "two");
}

#[test]
fn test_parity_switch_default() {
    let src = r#"
    let x = 99
    let result = "unknown"
    switch (x) {
        case 1: result = "one"
        case 2: result = "two"
        default: result = "other"
    }
    "#;
    assert_eq!(str_val(&var(src, "result")), "other");
}

// ═══════════════════════════════════════════════════════════════════════════════
// SOURCE-LEVEL ASYNC/AWAIT TESTS
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_async_function_source_level() {
    // async function returning a value, awaited at top level
    let src = r#"
    async function fetchData() {
        return 42
    }
    let result = await fetchData()
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_async_function_with_args() {
    // async function with arguments
    let src = r#"
    async function add(a, b) {
        return a + b
    }
    let result = await add(10, 32)
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_async_function_returns_string() {
    let src = r#"
    async function greet(name) {
        return "hello " + name
    }
    let result = await greet("world")
    "#;
    assert_eq!(str_val(&var(src, "result")), "hello world");
}

#[test]
fn test_parity_async_arrow_function_source_level() {
    // async arrow function (block body) at global scope
    let src = r#"
    let fetchData = async () => {
        return 42
    }
    let result = await fetchData()
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_async_arrow_expression_body() {
    // async arrow function with expression body
    let src = r#"
    let double = async (x) => x * 2
    let result = await double(21)
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_multiple_async_calls() {
    // Multiple async function calls
    let src = r#"
    async function square(x) {
        return x * x
    }
    let a = await square(3)
    let b = await square(4)
    let result = a + b
    "#;
    assert_eq!(num(&var(src, "result")), 25.0);
}

#[test]
fn test_parity_async_function_with_computation() {
    // async function that does non-trivial work
    let src = r#"
    async function fib(n) {
        if (n <= 1) {
            return n
        }
        return await fib(n - 1) + await fib(n - 2)
    }
    let result = await fib(6)
    "#;
    assert_eq!(num(&var(src, "result")), 8.0);
}

// ═══════════════════════════════════════════════════════════════════════════════
// SOURCE-LEVEL ACTOR MODEL TESTS
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_actor_source_spawn_send_receive() {
    // Full actor lifecycle via source-level syntax
    let src = r#"
    spawn Worker()
    send "hello" to Worker
    receive msg from Worker
    "#;
    let vm = run(src);
    assert_eq!(str_val(vm.get_variable("msg").unwrap()), "hello");
}

#[test]
fn test_parity_actor_source_multiple_messages() {
    let src = r#"
    spawn Worker()
    send "a" to Worker
    send "b" to Worker
    send "c" to Worker
    receive r1 from Worker
    receive r2 from Worker
    receive r3 from Worker
    "#;
    let vm = run(src);
    assert_eq!(str_val(vm.get_variable("r1").unwrap()), "a");
    assert_eq!(str_val(vm.get_variable("r2").unwrap()), "b");
    assert_eq!(str_val(vm.get_variable("r3").unwrap()), "c");
}

#[test]
fn test_parity_actor_source_empty_receive() {
    // Receive from empty mailbox returns Null
    let src = r#"
    spawn Worker()
    receive msg from Worker
    "#;
    let vm = run(src);
    assert!(vm.get_variable("msg").unwrap().is_null());
}

#[test]
fn test_parity_actor_source_send_number() {
    let src = r#"
    spawn Counter()
    send 42 to Counter
    receive val from Counter
    "#;
    let vm = run(src);
    assert_eq!(num(vm.get_variable("val").unwrap()), 42.0);
}

#[test]
fn test_parity_actor_source_with_alias() {
    // spawn stores result as subject name, user can alias
    let src = r#"
    spawn Worker()
    let w = Worker
    send "ping" to w
    receive msg from w
    "#;
    let vm = run(src);
    assert_eq!(str_val(vm.get_variable("msg").unwrap()), "ping");
}

// ═══════════════════════════════════════════════════════════════════════════════
// ARROW FUNCTION TESTS (SOURCE-LEVEL)
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_arrow_function_basic() {
    let src = r#"
    let double = (x) => x * 2
    let result = double(21)
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_arrow_function_block_body() {
    let src = r#"
    let add = (a, b) => {
        let sum = a + b
        return sum
    }
    let result = add(10, 32)
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_arrow_function_no_params() {
    let src = r#"
    let getFortyTwo = () => 42
    let result = getFortyTwo()
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_arrow_function_as_callback() {
    let src = r#"
    let nums = [1, 2, 3, 4, 5]
    let doubled = nums.map((x) => x * 2)
    let evens = nums.filter((x) => x % 2 == 0)
    let sum = nums.reduce((acc, x) => acc + x, 0)
    "#;
    let vm = run(src);
    let doubled = arr_val(vm.get_variable("doubled").unwrap());
    assert_eq!(doubled.len(), 5);
    assert_eq!(num(&doubled[0]), 2.0);
    assert_eq!(num(&doubled[4]), 10.0);
    let evens = arr_val(vm.get_variable("evens").unwrap());
    assert_eq!(evens.len(), 2);
    assert_eq!(num(&var(src, "sum")), 15.0);
}

#[test]
fn test_parity_arrow_function_closure_capture() {
    let src = r#"
    function makeAdder(x) {
        return (y) => x + y
    }
    let add5 = makeAdder(5)
    let result = add5(37)
    "#;
    assert_eq!(num(&var(src, "result")), 42.0);
}

#[test]
fn test_parity_fib2() {
    let src = r#"
    function fib(n) {
        if (n <= 1) { return n }
        return fib(n-1) + fib(n-2)
    }
    let result = fib(2)
    "#;
    assert_eq!(num(&var(src, "result")), 1.0, "fib(2) should be 1");
}

#[test]
fn test_parity_fib3() {
    let src = r#"
    function fib(n) {
        if (n <= 1) { return n }
        return fib(n-1) + fib(n-2)
    }
    let result = fib(3)
    "#;
    assert_eq!(num(&var(src, "result")), 2.0, "fib(3) should be 2");
}

#[test]
fn test_parity_fib5() {
    let src = r#"
    function fib(n) {
        if (n <= 1) { return n }
        return fib(n-1) + fib(n-2)
    }
    let result = fib(5)
    "#;
    assert_eq!(num(&var(src, "result")), 5.0, "fib(5) should be 5");
}

#[test]
fn test_parity_fib8() {
    let src = r#"
    function fib(n) {
        if (n <= 1) { return n }
        return fib(n-1) + fib(n-2)
    }
    let result = fib(8)
    "#;
    assert_eq!(num(&var(src, "result")), 21.0, "fib(8) should be 21");
}

#[test]
fn test_parity_fib9() {
    let src = r#"
    function fib(n) {
        if (n <= 1) { return n }
        return fib(n-1) + fib(n-2)
    }
    let result = fib(9)
    "#;
    assert_eq!(num(&var(src, "result")), 34.0, "fib(9) should be 34");
}
