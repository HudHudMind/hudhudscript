#[test]
fn test_parity_array_map() {
    let src = r#"
    let arr = [1, 2, 3]
    let doubled = arr.map((x) => x * 2)
    let d0 = doubled[0]
    let d1 = doubled[1]
    let d2 = doubled[2]
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("d0").cloned().unwrap()), 2.0);
    assert_eq!(num(&vm.get_variable("d1").cloned().unwrap()), 4.0);
    assert_eq!(num(&vm.get_variable("d2").cloned().unwrap()), 6.0);
}

#[test]
fn test_parity_array_filter() {
    let src = r#"
    let arr = [1, 2, 3, 4, 5, 6]
    let evens = arr.filter((x) => x % 2 == 0)
    let e0 = evens[0]
    let e1 = evens[1]
    let e2 = evens[2]
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("e0").cloned().unwrap()), 2.0);
    assert_eq!(num(&vm.get_variable("e1").cloned().unwrap()), 4.0);
    assert_eq!(num(&vm.get_variable("e2").cloned().unwrap()), 6.0);
}

#[test]
fn test_parity_array_reduce() {
    let src = r#"
    let arr = [1, 2, 3, 4, 5]
    let sum = arr.reduce((acc, x) => acc + x, 0)
    "#;
    assert_eq!(num(&var(src, "sum")), 15.0);
}

// ═══════════════════════════════════════════════════════════════════════════════
// P1 — ASYNC/AWAIT (via bytecode instructions)
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_await_resolved_promise() {
    let mut vm = VM::new();
    let mut bytecode = Bytecode::new();
    let promise_idx = bytecode.add_constant(Value16::promise(PromiseState16::Resolved(Box::new(
        Value16::number(42.0),
    ))));
    bytecode.instructions = vec![
        Instruction::LoadConst(promise_idx),
        Instruction::Await,
        Instruction::StoreVar(intern("result").0),
    ];
    vm.execute(&bytecode).expect("vm execute failed");
    assert_eq!(
        num(vm.get_variable("result").unwrap()),
        42.0,
        "await of resolved promise should yield 42"
    );
}

#[test]
fn test_parity_await_rejected_promise() {
    let mut vm = VM::new();
    let mut bytecode = Bytecode::new();
    let promise_idx = bytecode.add_constant(Value16::promise(PromiseState16::Rejected(
        "test error".to_string(),
    )));
    bytecode.instructions = vec![
        Instruction::LoadConst(promise_idx),
        Instruction::Await,
        Instruction::StoreVar(intern("result").0),
    ];
    let err = vm.execute(&bytecode).expect_err("should fail");
    assert!(
        err.to_string().contains("Promise rejected"),
        "error: {}",
        err
    );
}

#[test]
fn test_parity_await_async_pending() {
    let mut vm = VM::new();
    let promise_id = "test-promise-parity".to_string();
    let (tx, rx) = std::sync::mpsc::channel::<Result<Value16, String>>();
    vm.register_promise(promise_id.clone(), rx);

    std::thread::spawn(move || {
        let _ = tx.send(Ok(Value16::string("hello async".to_string())));
    });

    let mut bytecode = Bytecode::new();
    let promise_idx =
        bytecode.add_constant(Value16::promise(PromiseState16::AsyncPending(promise_id)));
    bytecode.instructions = vec![
        Instruction::LoadConst(promise_idx),
        Instruction::Await,
        Instruction::StoreVar(intern("result").0),
    ];
    vm.execute(&bytecode).expect("vm execute failed");
    assert_eq!(str_val(vm.get_variable("result").unwrap()), "hello async");
}

#[test]
fn test_parity_await_in_stm_rejected() {
    // Await inside atomically() should be rejected
    let src = r#"
    let counter = tvar_new("counter", 0)
    let caught = false
    try {
        atomically(() => {
            let val = tvar_read(counter)
        })
        caught = false
    } catch (e) {
        caught = true
    }
    "#;
    // This should succeed (no await inside atomically)
    let vm = run(src);
    // If we got here, atomically without await works
    assert!(vm.get_variable("counter").is_some());
}

// ═══════════════════════════════════════════════════════════════════════════════
// P1 — ACTOR (via bytecode instructions)
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_actor_spawn_send_receive() {
    let mut vm = VM::new();
    let mut bytecode = Bytecode::new();
    let msg_idx = bytecode.add_constant(Value16::string("hello".to_string()));
    // CROSS-2c: Spawn now carries a u32 call_payloads index.
    let spawn_idx = bytecode.add_call_payload("Worker".into(), 0);

    bytecode.instructions = vec![
        Instruction::Spawn(spawn_idx),
        Instruction::StoreVar(intern("worker").0),
        Instruction::LoadConst(msg_idx),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Send,
        //Pop removed (register VM),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Receive("received".into()),
    ];

    vm.execute(&bytecode).expect("vm execute failed");
    let received = vm.get_variable("received").expect("missing received");
    assert_eq!(str_val(received), "hello");
}

#[test]
fn test_parity_actor_multiple_messages() {
    let mut vm = VM::new();
    let mut bytecode = Bytecode::new();
    let msg1_idx = bytecode.add_constant(Value16::string("msg1".to_string()));
    let msg2_idx = bytecode.add_constant(Value16::string("msg2".to_string()));
    let msg3_idx = bytecode.add_constant(Value16::string("msg3".to_string()));
    // CROSS-2c: Spawn now carries a u32 call_payloads index.
    let spawn_idx = bytecode.add_call_payload("Worker".into(), 0);

    bytecode.instructions = vec![
        Instruction::Spawn(spawn_idx),
        Instruction::StoreVar(intern("worker").0),
        // Send 3 messages
        Instruction::LoadConst(msg1_idx),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Send,
        //Pop removed (register VM),
        Instruction::LoadConst(msg2_idx),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Send,
        //Pop removed (register VM),
        Instruction::LoadConst(msg3_idx),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Send,
        //Pop removed (register VM),
        // Receive 3 messages
        Instruction::LoadVar(intern("worker").0),
        Instruction::Receive("r1".into()),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Receive("r2".into()),
        Instruction::LoadVar(intern("worker").0),
        Instruction::Receive("r3".into()),
    ];

    vm.execute(&bytecode).expect("vm execute failed");
    assert_eq!(str_val(vm.get_variable("r1").unwrap()), "msg1");
    assert_eq!(str_val(vm.get_variable("r2").unwrap()), "msg2");
    assert_eq!(str_val(vm.get_variable("r3").unwrap()), "msg3");
}

#[test]
fn test_parity_actor_receive_empty_returns_null() {
    let mut vm = VM::new();
    let mut bytecode = Bytecode::new();
    // CROSS-2c: Spawn now carries a u32 call_payloads index.
    let spawn_idx = bytecode.add_call_payload("Worker".into(), 0);

    bytecode.instructions = vec![
        Instruction::Spawn(spawn_idx),
        Instruction::StoreVar(intern("worker").0),
        // Receive without sending — should return Null
        Instruction::LoadVar(intern("worker").0),
        Instruction::Receive("result".into()),
    ];

    vm.execute(&bytecode).expect("vm execute failed");
    let result = vm.get_variable("result").expect("missing result");
    assert!(result.is_null(), "expected Null, got {:?}", result);
}

#[test]
fn test_parity_receive_non_actor_fails() {
    let mut vm = VM::new();
    let mut bytecode = Bytecode::new();
    let bad_idx = bytecode.add_constant(Value16::number(7.0));

    bytecode.instructions = vec![
        Instruction::LoadConst(bad_idx),
        Instruction::Receive("msg".into()),
    ];

    let err = vm.execute(&bytecode).expect_err("expected failure");
    assert!(err.to_string().contains("valid actor reference"));
}

// ═══════════════════════════════════════════════════════════════════════════════
// P1 — STM (Software Transactional Memory)
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_stm_tvar_basic() {
    let src = r#"
    let t = tvar_new("counter", 0)
    let v1 = tvar_read(t)
    tvar_write(t, 42)
    let v2 = tvar_read(t)
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("v1").cloned().unwrap()), 0.0);
    assert_eq!(num(&vm.get_variable("v2").cloned().unwrap()), 42.0);
}

#[test]
fn test_parity_stm_atomically_basic() {
    let src = r#"
    let counter = tvar_new("c", 0)
    atomically(() => {
        let val = tvar_read(counter)
        tvar_write(counter, val + 10)
    })
    let result = tvar_read(counter)
    "#;
    assert_eq!(num(&var(src, "result")), 10.0);
}

// ═══════════════════════════════════════════════════════════════════════════════
// P2 — GOVERNANCE (Fail-Closed)
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_governance_comparison_rules() {
    // Test that governance comparison operators work correctly
    let src = r#"
    let x = 5
    let y = 10
    let lt = x < y
    let gt = x > y
    let eq = x == y
    let ne = x != y
    let le = x <= y
    let ge = x >= y
    "#;
    let vm = run(src);
    assert_eq!(bool_val(&vm.get_variable("lt").cloned().unwrap()), true);
    assert_eq!(bool_val(&vm.get_variable("gt").cloned().unwrap()), false);
    assert_eq!(bool_val(&vm.get_variable("eq").cloned().unwrap()), false);
    assert_eq!(bool_val(&vm.get_variable("ne").cloned().unwrap()), true);
    assert_eq!(bool_val(&vm.get_variable("le").cloned().unwrap()), true);
    assert_eq!(bool_val(&vm.get_variable("ge").cloned().unwrap()), false);
}

