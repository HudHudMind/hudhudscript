#[test]
fn test_parity_closure_capture() {
    let src = r#"
    function make_adder(x) {
        return (y) => x + y
    }
    let add5 = make_adder(5)
    let result = add5(3)
    "#;
    assert_eq!(num(&var(src, "result")), 8.0);
}

#[test]
fn test_parity_closure_nested() {
    let src = r#"
    function outer(a) {
        return (b) => a + b
    }
    let add10 = outer(10)
    let f = add10(5)
    "#;
    assert_eq!(num(&var(src, "f")), 15.0);
}

