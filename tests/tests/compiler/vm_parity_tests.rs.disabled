#![cfg(feature = "stack-vm-legacy")]
#![cfg(feature = "stack-vm-legacy")]
use hudhudscript_bytecode::interner::intern;
/// VM Parity Tests — Comprehensive test suite for VM/Interpreter feature parity
///
/// Issue #868: This test suite verifies that VM mode produces correct results
/// for all major language features. These tests are immutable per Anayasa
/// Kuralları Kural 1 and MUST NOT be modified except when explicitly requested
/// by the user to fix a specific test. New tests may be added freely.
///
/// Test categories:
/// - P0 Core: Recursive functions, class inheritance, super(), instance methods
/// - P1 Concurrency: async/await, actor, STM
/// - P2 Features: Plugin, MCP, Governance, RAG, closures
/// - P3 Scope/Types: for-in capture, type checking
use hudhudscript_bytecode::{Bytecode, Instruction, PromiseState16, Value16};
use hudhudscript_compiler::{Compiler, VM};
use hudhudscript_parser::parse;

// ── Helpers ──────────────────────────────────────────────────────────────────

/// Compile and execute HudHudScript source in VM mode.
fn run(src: &str) -> VM {
    let ast = parse(src).expect("parse failed");
    let mut compiler = Compiler::new();
    let bytecode = compiler.compile(&ast).expect("compile failed");
    let mut vm = VM::new();
    vm.execute(&bytecode).expect("vm execute failed");
    vm
}

/// Compile and execute, return the named variable's value.
fn var(src: &str, name: &str) -> Value16 {
    run(src)
        .get_variable(name)
        .cloned()
        .unwrap_or(Value16::null())
}

fn num(v: &Value16) -> f64 {
    v.as_number()
        .or_else(|| v.as_int().map(|i| i as f64))
        .unwrap_or_else(|| panic!("expected number, got {:?}", v))
}

fn str_val(v: &Value16) -> String {
    v.as_string()
        .unwrap_or_else(|| panic!("expected string, got {:?}", v))
}

fn bool_val(v: &Value16) -> bool {
    v.as_bool()
        .unwrap_or_else(|| panic!("expected boolean, got {:?}", v))
}

fn arr_val(v: &Value16) -> Vec<Value16> {
    v.as_array()
        .map(|a| a.to_vec())
        .unwrap_or_else(|| panic!("expected array, got {:?}", v))
}

#[allow(dead_code)]
fn obj_val(v: &Value16) -> std::collections::HashMap<String, Value16> {
    v.as_object()
        .cloned()
        .unwrap_or_else(|| panic!("expected object, got {:?}", v))
}

// ═══════════════════════════════════════════════════════════════════════════════
// P0 — RECURSIVE FUNCTIONS
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_fib_0_through_10() {
    let expected = [0.0, 1.0, 1.0, 2.0, 3.0, 5.0, 8.0, 13.0, 21.0, 34.0, 55.0];
    for (n, &exp) in expected.iter().enumerate() {
        let src = format!(
            r#"
            function fib(n) {{
                if (n <= 1) {{ return n }}
                return fib(n-1) + fib(n-2)
            }}
            let result = fib({})
            "#,
            n
        );
        assert_eq!(
            num(&var(&src, "result")),
            exp,
            "fib({}) should be {}",
            n,
            exp
        );
    }
}

#[test]
fn test_parity_factorial() {
    let expected = [(0, 1.0), (1, 1.0), (5, 120.0), (8, 40320.0)];
    for (n, exp) in &expected {
        let src = format!(
            r#"
            function fact(n) {{
                if (n <= 1) {{ return 1 }}
                return n * fact(n - 1)
            }}
            let result = fact({})
            "#,
            n
        );
        assert_eq!(
            num(&var(&src, "result")),
            *exp,
            "fact({}) should be {}",
            n,
            exp
        );
    }
}

#[test]
fn test_parity_mutual_recursion() {
    let src = r#"
    function is_even(n) {
        if (n == 0) { return true }
        return is_odd(n - 1)
    }
    function is_odd(n) {
        if (n == 0) { return false }
        return is_even(n - 1)
    }
    let r0 = is_even(0)
    let r1 = is_even(1)
    let r4 = is_even(4)
    let r7 = is_even(7)
    "#;
    let vm = run(src);
    assert_eq!(bool_val(&vm.get_variable("r0").cloned().unwrap()), true);
    assert_eq!(bool_val(&vm.get_variable("r1").cloned().unwrap()), false);
    assert_eq!(bool_val(&vm.get_variable("r4").cloned().unwrap()), true);
    assert_eq!(bool_val(&vm.get_variable("r7").cloned().unwrap()), false);
}

#[test]
fn test_parity_nested_recursion() {
    let src = r#"
    function ack(m, n) {
        if (m == 0) { return n + 1 }
        if (n == 0) { return ack(m - 1, 1) }
        return ack(m - 1, ack(m, n - 1))
    }
    let r1 = ack(0, 0)
    let r2 = ack(1, 1)
    let r3 = ack(2, 2)
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("r1").cloned().unwrap()), 1.0);
    assert_eq!(num(&vm.get_variable("r2").cloned().unwrap()), 3.0);
    assert_eq!(num(&vm.get_variable("r3").cloned().unwrap()), 7.0);
}

// ═══════════════════════════════════════════════════════════════════════════════
// P0 — CLASS INHERITANCE & SUPER
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_single_inheritance() {
    let src = r#"
    class Animal {
        constructor(name) {
            this.name = name
            this.type = "animal"
        }
    }
    class Dog extends Animal {
        constructor(name, breed) {
            super(name)
            this.breed = breed
            this.type = "dog"
        }
    }
    let d = new Dog("Rex", "Husky")
    let dname  = d.name
    let dtype  = d.type
    let dbreed = d.breed
    "#;
    let vm = run(src);
    assert_eq!(str_val(&vm.get_variable("dname").cloned().unwrap()), "Rex");
    assert_eq!(str_val(&vm.get_variable("dtype").cloned().unwrap()), "dog");
    assert_eq!(
        str_val(&vm.get_variable("dbreed").cloned().unwrap()),
        "Husky"
    );
}

#[test]
fn test_parity_two_level_inheritance() {
    let src = r#"
    class A {
        constructor(x) {
            this.x = x
        }
    }
    class B extends A {
        constructor(x, y) {
            super(x)
            this.y = y
        }
    }
    let b = new B(10, 20)
    let bx = b.x
    let by = b.y
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("bx").cloned().unwrap()), 10.0);
    assert_eq!(num(&vm.get_variable("by").cloned().unwrap()), 20.0);
}

#[test]
fn test_parity_instance_method_basic() {
    let src = r#"
    class Calc {
        function add(a, b) { return a + b }
        function multiply(a, b) { return a * b }
    }
    let c = new Calc()
    let sum = c.add(2, 3)
    let prod = c.multiply(4, 5)
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("sum").cloned().unwrap()), 5.0);
    assert_eq!(num(&vm.get_variable("prod").cloned().unwrap()), 20.0);
}

#[test]
fn test_parity_instance_method_with_this() {
    let src = r#"
    class Counter {
        constructor() {
            this.count = 0
        }
        function get_count() {
            return this.count
        }
    }
    let ctr = new Counter()
    let initial = ctr.get_count()
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("initial").cloned().unwrap()), 0.0);
}

#[test]
fn test_parity_inherited_method() {
    let src = r#"
    class Shape {
        constructor(name) {
            this.name = name
        }
        function describe() {
            return "I am a " + this.name
        }
    }
    class Circle extends Shape {
        constructor(radius) {
            super("circle")
            this.radius = radius
        }
    }
    let c = new Circle(5)
    let desc = c.describe()
    let r = c.radius
    "#;
    let vm = run(src);
    assert_eq!(
        str_val(&vm.get_variable("desc").cloned().unwrap()),
        "I am a circle"
    );
    assert_eq!(num(&vm.get_variable("r").cloned().unwrap()), 5.0);
}

#[test]
fn test_parity_class_no_constructor() {
    let src = r#"
    class Utils {
        function double(x) { return x * 2 }
        function triple(x) { return x * 3 }
    }
    let u = new Utils()
    let d = u.double(5)
    let t = u.triple(5)
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("d").cloned().unwrap()), 10.0);
    assert_eq!(num(&vm.get_variable("t").cloned().unwrap()), 15.0);
}

