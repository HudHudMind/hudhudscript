// P0 — CONTROL FLOW
// ═══════════════════════════════════════════════════════════════════════════════

#[test]
fn test_parity_if_else() {
    let src = r#"
    function abs(x) {
        if (x < 0) { return -x }
        return x
    }
    let r1 = abs(-5)
    let r2 = abs(3)
    let r3 = abs(0)
    "#;
    let vm = run(src);
    assert_eq!(num(&vm.get_variable("r1").cloned().unwrap()), 5.0);
    assert_eq!(num(&vm.get_variable("r2").cloned().unwrap()), 3.0);
    assert_eq!(num(&vm.get_variable("r3").cloned().unwrap()), 0.0);
}

#[test]
fn test_parity_while_loop() {
    let src = r#"
    let sum = 0
    let i = 1
    while (i <= 10) {
        sum = sum + i
        i = i + 1
    }
    "#;
    assert_eq!(num(&var(src, "sum")), 55.0);
}

#[test]
fn test_parity_for_in_array() {
    let src = r#"
    let sum = 0
    for (x in [1, 2, 3, 4, 5]) {
        sum = sum + x
    }
    "#;
    assert_eq!(num(&var(src, "sum")), 15.0);
}

#[test]
fn test_parity_for_in_with_break() {
    let src = r#"
    let sum = 0
    for (x in [1, 2, 3, 4, 5]) {
        if (x == 4) { break }
        sum = sum + x
    }
    "#;
    assert_eq!(num(&var(src, "sum")), 6.0);
}

#[test]
fn test_parity_for_in_with_continue() {
    let src = r#"
    let sum = 0
    for (x in [1, 2, 3, 4, 5]) {
        if (x == 3) { continue }
        sum = sum + x
    }
    "#;
    assert_eq!(num(&var(src, "sum")), 12.0);
}

#[test]
fn test_parity_try_catch() {
    let src = r#"
    let result = "none"
    try {
        throw "oops"
    } catch (e) {
        result = e
    }
    "#;
    assert_eq!(str_val(&var(src, "result")), "oops");
}

