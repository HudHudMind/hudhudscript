// SOP Fleet Sample — Subject-Oriented Programming
// v0.5.60

subject Taxi {
    state fuel: 100, state passengers: 0, state location: "depot"
}
subject CargoPlane {
    state fuel: 500, state cargo_kg: 0, state altitude: 0
}

effect on Drive(vehicle, distance) { vehicle.fuel = vehicle.fuel - distance }
effect on Fly(plane, hours) { plane.fuel = plane.fuel - hours * 50 }

on pickup(self, count) {
    self.passengers = self.passengers + count
    Drive(self, 10)
}

on takeoff(self) { self.altitude = 10000; Fly(self, 2) }

let taxi = spawn Taxi
let plane = spawn CargoPlane

taxi.pickup(3)
print("Taxi fuel: ")
print(taxi.fuel)
print("Passengers: ")
print(taxi.passengers)

plane.takeoff()
print("Plane fuel: ")
print(plane.fuel)
print("Altitude: ")
print(plane.altitude)
