function solveNQueens(n) {
    let board = [];
    for (let i = 0; i < n; i = i + 1) {
        board.push(-1);
    }
    let count = 0;
    let row = 0;

    while (true) {
        if (row < 0) { break; }
        if (row == n) {
            count = count + 1;
            row = row - 1;
            if (row >= 0) {
                board[row] = board[row] + 1;
            }
            continue;
        }

        if (board[row] >= n) {
            board[row] = -1;
            row = row - 1;
            if (row >= 0) {
                board[row] = board[row] + 1;
            }
            continue;
        }

        let col = board[row];
        if (col < 0) { col = 0; }
        let found = false;

        for (let c = col; c < n; c = c + 1) {
            let safe = true;
            for (let i = 0; i < row; i = i + 1) {
                if (board[i] == c) {
                    safe = false;
                    i = row;
                } else {
                    if (board[i] - c == i - row) {
                        safe = false;
                        i = row;
                    } else {
                        if (board[i] - c == row - i) {
                            safe = false;
                            i = row;
                        }
                    }
                }
            }
            if (safe) {
                board[row] = c;
                row = row + 1;
                found = true;
                c = n;
            }
        }

        if (!found) {
            board[row] = -1;
            row = row - 1;
            if (row >= 0) {
                board[row] = board[row] + 1;
            }
        }
    }

    return count;
}

print(solveNQueens(8));
