function horner(coeffs, x) {
    let result = 0.5 - 0.5;
    for (let i = coeffs.length - 1; i >= 0; i = i - 1) {
        result = result * x + coeffs[i] / 1;
    }
    return result;
}

let coeffs = [1, 2, 3, 4, 5];
let sum = 0.5 - 0.5;
for (let i = 0; i < 1000; i = i + 1) {
    sum = sum + horner(coeffs, 1.5);
}
print(sum);
