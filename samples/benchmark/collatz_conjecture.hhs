function collatz(n) {
    let count = 0;
    while (n != 1) {
        if (n % 2 == 0) {
            n = n / 2;
        } else {
            n = 3 * n + 1;
        }
        count = count + 1;
    }
    return count;
}

function maxCollatz(limit) {
    let max = 0;
    let maxN = 0;
    for (let i = 1; i <= limit; i = i + 1) {
        let c = collatz(i);
        if (c > max) {
            max = c;
            maxN = i;
        }
    }
    return [maxN, max];
}

let result = maxCollatz(100);
print("maxN=" + result[0]);
print("maxSteps=" + result[1]);
