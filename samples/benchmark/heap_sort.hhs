function heapify(arr, n, i) {
    let largest = i;
    let left = 2 * i + 1;
    let right = 2 * i + 2;

    if (left < n) {
        if (arr[left] > arr[largest]) {
            largest = left;
        }
    }
    if (right < n) {
        if (arr[right] > arr[largest]) {
            largest = right;
        }
    }

    if (largest != i) {
        let temp = arr[i];
        arr[i] = arr[largest];
        arr[largest] = temp;
        heapify(arr, n, largest);
    }
}

function heapSort(arr) {
    let n = arr.length;
    for (let i = n / 2 - 1; i >= 0; i = i - 1) {
        heapify(arr, n, i);
    }
    for (let i = n - 1; i > 0; i = i - 1) {
        let temp = arr[0];
        arr[0] = arr[i];
        arr[i] = temp;
        heapify(arr, i, 0);
    }
    return arr;
}

let data = [64, 34, 25, 12, 22, 11, 90, 5, 77, 3];
let sorted = heapSort(data);
for (let i = 0; i < sorted.length; i = i + 1) {
    print(sorted[i]);
}
