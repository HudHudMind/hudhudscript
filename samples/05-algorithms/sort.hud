let nums = [5, 3, 8, 1, 9, 2, 7, 4, 6];

print("=== Bubble Sort ===");
print("Önce: 5,3,8,1,9,2,7,4,6");

let n = 9;
for (let i = 0; i < n; i = i + 1) {
    for (let j = 0; j < n - 1; j = j + 1) {
        if (nums[j] > nums[j + 1]) {
            let t = nums[j];
            nums[j] = nums[j + 1];
            nums[j + 1] = t;
        }
    }
}
print("Sonra: " + nums[0] + "," + nums[1] + "," + nums[2] + ",...," + nums[8]);
