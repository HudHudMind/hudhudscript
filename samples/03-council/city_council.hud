// HudHudScript — Council: Belediye Meclisi

role Mayor { can propose, can veto }
role Treasurer { can budget, can audit }
role Sheriff { can enforce, can detain }

subject CityMayor has Mayor {
    state term: 1,
    state proposals: 0
}
subject CityTreasurer has Treasurer {
    state budget: 1000000,
    state spent: 0
}
subject CitySheriff has Sheriff {
    state officers: 50,
    state arrests: 0
}

council CityCouncil {
    quorum: 2,
    members: ["CityMayor", "CityTreasurer", "CitySheriff"],
    rules: ["majority-vote", "public-record"]
}

relation CityMayor <-> CityTreasurer { trust: 70 }
relation CityMayor <-> CitySheriff { trust: 85 }

spawn CityMayor; spawn CityTreasurer; spawn CitySheriff;

print("=== Belediye Meclisi Toplantısı ===");
print("Üyeler: Mayor, Treasurer, Sheriff (quorum: 2)");
print("");

let proposals = 3;
let budget = 1000000;
let spent = 0;

print("Gündem:");
print("  1. Park yenileme → $" + 50000 + " ✓ (2/3 oy)");
spent = spent + 50000;

print("  2. Yol onarımı → $" + 150000 + " ✓ (3/3 oy)");
spent = spent + 150000;

print("  3. Kütüphane → $" + 80000 + " ✓ (2/3 oy)");
spent = spent + 80000;

print("");
print("Bütçe: $" + budget + " | Harcanan: $" + spent + " | Kalan: $" + (budget - spent));
